def local_state():
    """What the tray needs without root: the settings (profile, autostart, unlock, custom calibrations), the crash
    marker, the profile names and a laptop's re-apply state, from the files siliconctl keeps readable by everyone."""
    def js(path):
        try:
            with open(ROOT_DIR + path) as f:
                return json.load(f)
        except (OSError, ValueError):
            return None
    d = ROOT_DIR + "/etc/siliconctl/profiles"
    return {"settings": js("/etc/siliconctl/settings.json") or {}, "crashed": js("/var/lib/siliconctl/crashed"),
            "profiles": sorted(f[:-5] for f in os.listdir(d) if f.endswith(".conf")) if os.path.isdir(d) else [],
            "reapply": js("/run/siliconctl/reapply.json")}


def user_tctl():
    """Tctl without root: k10temp (its Tdie where it has one), the fake backend's in --mock; None if unknown."""
    try:
        if ROOT_DIR:
            with open(ROOT_DIR + "/fake_smu.json") as f:
                return json.load(f)["tctl"]
        for d in sorted(os.listdir("/sys/class/hwmon")):
            base = "/sys/class/hwmon/" + d
            with open(base + "/name") as f:
                if f.read().strip() != "k10temp":
                    continue
            tdie = os.path.exists(base + "/temp2_label") and open(base + "/temp2_label").read().strip() == "Tdie"
            with open(base + "/temp%d_input" % (2 if tdie else 1)) as f:
                return int(f.read()) / 1000.0
    except (OSError, ValueError, KeyError):
        pass
    return None


class Tray:
    """The icon in the system tray: a StatusNotifierItem with a com.canonical.dbusmenu menu exported on the session
    bus with Gio (no extra dependency, works on Wayland; KDE Plasma natively, GNOME with the AppIndicator
    extension). Menu and tooltip come from local_state() and k10temp: no root until an entry needs it, then the
    application's single `siliconctl serve` (one pkexec prompt). export=False: the menu only (smoke test)."""
    PATH, MENU = "/StatusNotifierItem", "/MenuBar"

    def __init__(self, app, export=True):
        self.app, self.rev, self.items, self.key = app, 1, [], None
        self.tip, self.status, self.ppt, self.asking, self.conn = "", "Active", None, False, None
        self.name = "org.kde.StatusNotifierItem-%d-1" % os.getpid()
        if export:
            self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            node = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
            # register_object_with_closures2 since GLib 2.84; the older name (deprecated there) before it
            reg = getattr(self.conn, "register_object_with_closures2", None) or self.conn.register_object
            self.regs = [reg(self.PATH, node.interfaces[0], self.on_sni, self.sni_prop, None),
                         reg(self.MENU, node.interfaces[1], self.on_menu, self.menu_prop, None)]
            self.watch = None
            self.own = Gio.bus_own_name_on_connection(self.conn, self.name, Gio.BusNameOwnerFlags.NONE, self.on_name, None)
        self.refresh()
        self.timer = GLib.timeout_add_seconds(2, lambda: self.refresh() or True)

    def close(self):
        GLib.source_remove(self.timer)
        if self.conn:
            if self.watch:
                Gio.bus_unwatch_name(self.watch)
            Gio.bus_unown_name(self.own)
            for r in self.regs:
                self.conn.unregister_object(r)

    def on_name(self, conn, _name):   # our name first, then the host (and again whenever Plasma restarts)
        self.watch = Gio.bus_watch_name_on_connection(conn, "org.kde.StatusNotifierWatcher", Gio.BusNameWatcherFlags.NONE,
                                                      self.on_watcher, None)

    def on_watcher(self, conn, *_a):
        conn.call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher",
                  "RegisterStatusNotifierItem", GLib.Variant("(s)", (self.name,)), None, Gio.DBusCallFlags.NONE, -1, None, None)

    def emit(self, path, iface, signal, args=None):
        if self.conn:
            self.conn.emit_signal(None, path, iface, signal, args)

    # -- the menu --
    def build(self, ls):
        """Entries (None = separator) from the local state: crash choice, modes (radio), Apply at startup, Open, Quit."""
        s, crashed, items = ls["settings"], ls["crashed"], []

        def add(label, action=None, toggle=None, on=False):
            items.append({"label": label, "action": action, "toggle": toggle, "on": on})
        if crashed:
            prof = crashed.get("profile")
            add(_("Profile '%s' deactivated after a crash (%s)") % (prof or "-", crashed.get("time", "?")))
            if prof:
                add(_("Reactivate"), lambda: self.run([["crashed", "clear"], ["autostart", "on"], ["apply", prof]]))
            add(_("Stay on Default"), lambda: self.run([["crashed", "clear"], ["default"], ["autostart", "off"]]))
            items.append(None)
        prof, cal = s.get("profile"), s.get("calibrated") or {}
        titles = dict((k, t) for k, t, _sub in MODES)
        for key in ["default"] + [k for k, _t, _s in MODES if k in PRESETS] + sorted(cal):
            if key == "default":
                act = lambda: self.run([["default"]])
            elif (key == "boost" or cal.get(key, {}).get("base") == "boost") and not s.get("unlock"):
                act = None
            elif key in ls["profiles"]:
                act = lambda k=key: self.run([["apply", k], ["use", k]])
            elif key in ("quiet", "performance"):   # fixed presets: created from the stock values on the way
                act = lambda k=key: self.run([["preset", k], ["apply", k], ["use", k]])
            else:
                act = None
            why = "" if act else (_(" (needs unlock)") if key == "boost" or key in cal else _(" (not calibrated)"))
            add(titles.get(key, key) + why, act, "radio", prof == key or (key == "default" and not prof))
        if prof and prof not in PRESETS and prof not in cal:   # a profile saved by hand: shown, chosen in the window
            add(_("Custom: %s") % prof, None, "radio", True)
        items.append(None)
        add(_("Apply at startup"), (lambda: self.run([["autostart", "off" if s.get("autostart") else "on"]]))
            if prof or s.get("autostart") else None,   # on Default (no profile) it can still be turned off
            "checkmark", bool(s.get("autostart")))
        items.append(None)
        add(_("Open Silicon Control"), self.app.activate)
        add(_("Quit"), self.app.quit_all)
        return items

    def props(self, it):
        if it is None:
            return {"type": GLib.Variant("s", "separator")}
        p = {"label": GLib.Variant("s", it["label"].replace("_", "__")), "enabled": GLib.Variant("b", it["action"] is not None)}
        if it["toggle"]:
            p["toggle-type"] = GLib.Variant("s", it["toggle"])
            p["toggle-state"] = GLib.Variant("i", 1 if it["on"] else 0)
        return p

    def layout(self):
        kids = [GLib.Variant("(ia{sv}av)", (i, self.props(it), [])) for i, it in enumerate(self.items, 1)]
        return GLib.Variant("(u(ia{sv}av))", (self.rev, (0, {"children-display": GLib.Variant("s", "submenu")}, kids)))

    def click(self, i):
        it = self.items[i - 1] if 0 < i <= len(self.items) else None
        if it and it["action"]:
            it["action"]()

    def refresh(self):
        """Local state every 2 s and before the menu opens: new layout when it changed, tooltip, attention after a crash.
        True when the layout changed."""
        ls = local_state()
        self.items = self.build(ls)
        key = repr([it and (it["label"], it["action"] is not None, it["on"]) for it in self.items])
        changed = key != self.key
        if changed:
            self.key, self.rev = key, self.rev + 1
            self.emit(self.MENU, "com.canonical.dbusmenu", "LayoutUpdated", GLib.Variant("(ui)", (self.rev, 0)))
        prof, t = ls["settings"].get("profile"), user_tctl()
        mode = dict((k, title) for k, title, _s in MODES).get(prof, prof) if prof else _("Default")
        tip = "Tctl %s" % fmt(t, " °C") + (" · PPT %s" % fmt(self.ppt, " W") if self.ppt is not None else "") + "\n" + \
            _("Mode: %s") % mode + (_(" (applied at startup)") if ls["settings"].get("autostart") else "") + \
            ("\n" + _("Profile deactivated after a crash: choose in the menu") if ls["crashed"] else "") + \
            "".join("\n" + n for n in laptop_notes(ls.get("reapply")))
        if tip != self.tip:
            self.tip = tip
            self.emit(self.PATH, "org.kde.StatusNotifierItem", "NewToolTip")
        status = "NeedsAttention" if ls["crashed"] else "Active"
        if status != self.status:
            self.status = status
            self.emit(self.PATH, "org.kde.StatusNotifierItem", "NewStatus", GLib.Variant("(s)", (status,)))
        h = self.app.helper   # the PPT only once siliconctl serve runs anyway (never a prompt for a tooltip), one request at a time
        if h and h.p.poll() is None and not self.asking:
            self.asking = True
            bg(lambda: h.call("telemetry").get("ppt"), self.got_ppt, lambda _m: self.got_ppt(None))
        return changed

    def got_ppt(self, ppt):
        self.asking, self.ppt = False, ppt

    def run(self, cmds):
        """A privileged choice from the menu: the application's siliconctl serve (the session's first one asks the
        password), then the tray and the window follow; an error becomes a notification."""
        def done(_r):
            self.refresh()
            win = self.app.props.active_window
            if win:
                win.reload()

        def fail(msg):
            n = Gio.Notification.new("Silicon Control")
            n.set_body(msg)
            self.app.send_notification("tray-error", n)
            self.refresh()
        h = self.app.get_helper()
        bg(lambda: [h.call(*a) for a in cmds], done, fail)

    # -- D-Bus --
    def sni_prop(self, _conn, _sender, _path, _iface, prop):
        theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
        icon = APP_ID if theme.has_icon(APP_ID) else "applications-system"
        v = {"Category": ("s", "Hardware"), "Id": ("s", "silicon-control"), "Title": ("s", "Silicon Control"),
             "Status": ("s", self.status), "WindowId": ("i", 0), "IconName": ("s", icon), "AttentionIconName": ("s", "dialog-warning"),
             "OverlayIconName": ("s", ""), "ToolTip": ("(sa(iiay)ss)", (icon, [], "Silicon Control", self.tip)),
             "ItemIsMenu": ("b", False), "Menu": ("o", self.MENU)}.get(prop)
        return GLib.Variant(*v) if v else None

    def on_sni(self, _conn, _sender, _path, _iface, method, _params, invocation):
        if method == "Activate":   # left click: the window, like the launcher
            self.app.activate()
        invocation.return_value(None)

    def menu_prop(self, _conn, _sender, _path, _iface, prop):
        v = {"Version": ("u", 3), "TextDirection": ("s", "ltr"), "Status": ("s", "normal"), "IconThemePath": ("as", [])}.get(prop)
        return GLib.Variant(*v) if v else None

    def on_menu(self, _conn, _sender, _path, _iface, method, params, invocation):
        if method == "GetLayout":
            invocation.return_value(self.layout())
        elif method == "GetGroupProperties":
            ids = params.unpack()[0]
            invocation.return_value(GLib.Variant("(a(ia{sv}))", ([(i, self.props(self.items[i - 1])) for i in ids
                                                                  if 0 < i <= len(self.items)],)))
        elif method == "GetProperty":
            i, name = params.unpack()
            p = self.props(self.items[i - 1]) if 0 < i <= len(self.items) else {}
            invocation.return_value(GLib.Variant("(v)", (p.get(name, GLib.Variant("s", "")),)))
        elif method == "Event":
            i, event = params.unpack()[:2]
            invocation.return_value(None)
            if event == "clicked":
                GLib.idle_add(lambda: self.click(i) and False)
        elif method == "EventGroup":
            for i, event, _data, _ts in params.unpack()[0]:
                if event == "clicked":
                    GLib.idle_add(lambda i=i: self.click(i) and False)
            invocation.return_value(GLib.Variant("(ai)", ([],)))
        elif method == "AboutToShow":
            invocation.return_value(GLib.Variant("(b)", (self.refresh(),)))
        elif method == "AboutToShowGroup":
            invocation.return_value(GLib.Variant("(aiai)", ([0] if self.refresh() else [], [])))
        else:
            invocation.return_value(None)


class App(Adw.Application):
    def __init__(self, mock, smoke=False, shots=None, tray=False):
        # the mock must not activate the real instance; --smoke/--screenshots run as their own instance,
        # otherwise a mock window already open would receive the activation and the check would pass untested
        super().__init__(application_id=APP_ID + (".Mock" if mock else ""),
                         flags=Gio.ApplicationFlags.NON_UNIQUE if (smoke or shots) else Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.mock, self.smoke, self.smoke_failed, self.shots = mock, smoke, False, shots
        self.helper, self.tray, self.hidden, self.styled = None, None, tray, False   # hidden: --tray, only the icon at first

    def get_helper(self):
        """The application's single `siliconctl serve`, shared by the window and the tray; started at the first need."""
        if self.helper is None or self.helper.p.poll() is not None:
            self.helper = Helper(self.mock)
        return self.helper

    def set_tray(self, on):
        """The icon in the system tray (Preferences, --tray): while it is there the application lives without a window."""
        if on and not self.tray:
            self.tray = Tray(self)
            self.hold()
        elif not on and self.tray:
            self.tray.close()
            self.tray = None
            self.release()

    def quit_all(self):
        if self.helper:
            self.helper.close()
        self.quit()

    def do_activate(self):
        if not self.styled:
            self.styled = True
            prov = Gtk.CssProvider()
            try:
                prov.load_from_string(CSS)
            except AttributeError:   # GTK < 4.12
                prov.load_from_data(CSS.encode())
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            if (self.hidden or ui_load().get("tray")) and not (self.smoke or self.shots):
                try:
                    self.set_tray(True)
                except GLib.Error:   # no session bus: the window as usual
                    self.hidden = False
        if self.hidden:   # --tray: only the icon until "Open Silicon Control" (no password until then)
            self.hidden = False
            return
        if not self.props.active_window:
            win = Window(self, self.get_helper())
            if self.smoke:
                GLib.timeout_add(500, self.run_smoke)
            if self.shots:
                Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
                win.set_default_size(*SHOT_SIZE)
                self.drive(self.screenshot_steps())
        self.props.active_window.present()

    def drive(self, steps):
        """Runs a generator that yields pauses in ms, letting GTK lay out and draw in between; an
        exception becomes exit code 1."""
        def tick():
            try:
                GLib.timeout_add(next(steps), tick)
            except StopIteration:
                self.quit()
            except Exception:
                import traceback
                traceback.print_exc()
                self.smoke_failed = True
                self.quit()
            return False
        GLib.timeout_add(500, tick)

    def screenshot_steps(self):
        """--mock --screenshots DIR (make screenshots): fills a fresh fake backend (fan roles, presets,
        the three calibrations if the CPU has a per-core CO), saves the frames of the Auto calibration
        (README GIF), then one PNG per page."""
        win = self.props.active_window
        h = win.h
        while not win.status:   # the windows are built with the core count of the first status
            yield 100
        h.call("fan", "autodetect")
        h.call("fan", "identify", "1")
        # a new fake boot: as on a real machine the fan roles exist at boot, so the baseline has the BIOS fan lines
        run_dir = os.path.join(MOCK_DIR, "run", "siliconctl")
        for f in os.listdir(run_dir):
            os.remove(os.path.join(run_dir, f))
        subprocess.run([SILICONCTL, "boot"], env=dict(os.environ, SILICONCTL_ROOT=MOCK_DIR), check=True, stdout=subprocess.DEVNULL)
        for name in ("quiet", "performance"):
            h.call("preset", name)
        if win.status.get("co") is not None:   # the calibrations measure the CO: refused on CPUs without a per-core CO
            # Auto from scratch, one step at a time: a frame per step for the README GIF (assembled by `make
            # screenshots` from $SILICONCTL_ROOT/frames), the end state as calibration.png
            frames = os.path.join(MOCK_DIR, "frames")
            os.makedirs(frames, exist_ok=True)
            dlg = AutotuneDialog(win, "auto")
            st = h.call("autotune", "start", "auto", "step=3", "reuse=0")
            for i in range(300):
                dlg.show(st)
                yield 250
                save_png(dlg, os.path.join(frames, "f-%03d.png" % i))
                if st["phase"] == "done":
                    break
                st = h.call("autotune", "step")
            dlg.done(st)
            yield 800
            save_png(dlg, os.path.join(frames, "last.png"))
            h.call("autotune", "save")
            dlg.closable = True
            dlg.close()
            h.call("unlock", "on")   # Boost is calibrated and used only with the unlock: the screenshots show it usable
            for mode in ("eco", "boost"):   # Eco reuses the final pass Auto just validated: done at once
                st = h.call("autotune", "start", mode, "step=3")
                while st["phase"] != "done":
                    st = h.call("autotune", "step")
                h.call("autotune", "save")
            h.call("use", "auto")
            h.call("apply", "auto")
            h.call("autostart", "on")
        win.reload()
        yield 1500
        mon = next(p for p in win.pages if isinstance(p, MonitorPage))
        if mon.hist:   # the fake telemetry is steady: fill the 60 s window with it instead of waiting a minute
            mon.hist.extend([mon.hist[-1]] * mon.hist.maxlen)
        for page in win.pages:
            win.stack.set_visible_child(page)
            yield 1200 if page.NAME == "monitor" else 700
            save_png(win, os.path.join(self.shots, page.NAME + ".png"))

    def run_smoke(self):
        """--mock --smoke (make check): the per-core rows of Monitor and Curves follow the core count, the
        calibration window shows every real state of the fake backend for eco, auto and boost (all
        phases, end, resume dialog), the collapsible section of the unknown channels on the Fans page
        hides/shows only them and is saved, then the app exits; a rendering error becomes exit code 1
        instead of a traceback on the desktop."""
        win = self.props.active_window
        if not win.status:   # the windows are built with the core count of the first status
            return True
        try:
            win.h.call("autotune", "abort")
            modes = next(p for p in win.pages if isinstance(p, ModesPage))
            no_co = bool(win.status.get("co_unavailable"))   # Ryzen 1000–3000: every calibrated mode locked, with the reason
            for on in (False, True):   # Boost only with unlock: disabled without it, usable as soon as the status says on
                modes.refresh(dict(win.status, unlock=on))
                row, chk, regen = modes.rows["boost"]
                ok = on and not no_co
                assert chk.get_sensitive() == regen.get_sensitive() == ok and (row.get_tooltip_text() is None) == ok
                assert all(modes.rows[k][1].get_sensitive() != no_co for k in ("eco", "auto"))
            # per-core views follow the active cores, also when the count changes: rows replaced, not added
            mon = next(p for p in win.pages if isinstance(p, MonitorPage))
            curve = next(p for p in win.pages if isinstance(p, CurvePage))
            t, n = win.h.call("telemetry"), win.status["cores"]
            mon.telemetry(t)   # rows of every core, as after the first 1 Hz poll
            for k in (2, n):
                old = curve.cores
                mon.telemetry(dict(t, cores=t["cores"][:k]))
                curve.refresh(dict(win.status, cores=k))
                assert len(mon.cores) == len(curve.cores) == k and mon.grid.get_child_at(0, k + 1) is None, "core rows not following the count"
                assert not any(p.get_parent() for p in old), "old core rows kept"
            # a laptop: the profile's limits held on the other power source, re-applying stopped; gone with them
            rp = {"held": "battery", "gave_up": "2026-10-13 12:00"}
            mon.telemetry(dict(t, reapply=rp))
            assert mon.laptop.get_visible() and mon.laptop.get_text() == "\n".join(laptop_notes(rp)) and len(laptop_notes(rp)) == 2
            mon.telemetry(t)
            assert not mon.laptop.get_visible(), "laptop note left on the Monitor"
            win.h.call("unlock", "on")   # needed by the Boost calibration below
            # the first Eco measures from scratch, the last one reuses the final passes just recorded: done at once;
            # no calibration without a per-core CO (siliconctl refuses it)
            # Auto sweeps the PPT: not on CPUs whose PM table limits are unknown (siliconctl refuses it)
            pm_limits = (win.status.get("limits") or {}).get("ppt") is not None
            for i, mode in enumerate((("eco", "auto", "boost", "eco") if pm_limits else ("eco", "boost", "eco"))
                                     if win.status.get("co") is not None else ()):
                dlg = AutotuneDialog(win, mode)
                st = win.h.call("autotune", "start", mode, "step=3", "reuse=%d" % (i > 0))
                dlg.show(st)
                # serve arms the (fake) hardware watchdog for the run and the window says so; done at once: nothing to arm
                assert st["phase"] == "done" or (st.get("watchdog") and dlg.watchdog.get_text().strip()), "watchdog state not shown"
                for _i in range(300):
                    if st["phase"] == "done":
                        break
                    st = win.h.call("autotune", "step")
                    dlg.show(st)
                assert i == 0 or mode != "eco" or st.get("eco_from"), "Eco did not reuse the validated undervolt"
                dlg.done(st)
                win.h.call("autotune", "abort")
                dlg.closable = True
                dlg.close()
            if win.status.get("co") is not None:
                # the parameters: the single-core test of the final pass is on by default and sent to siliconctl
                d = modes.calibrate_params("eco", win.h.call("autotune", "estimate", "eco"))
                assert d.single.get_active() and d.params()["single"] == 1 and d.single.get_subtitle(), "single-core switch"
                d.force_close()
                # a verification of a saved profile: Verify… on the row, the duration, then the same window to the end
                win.h.call("preset", "eco")
                modes.refresh(dict(win.status, profile_lines={"eco": win.h.call("profile", "show", "eco")["lines"]}))
                assert modes.verify_btns["eco"].get_visible(), "Verify… missing on a saved calibrated profile"
                modes.verify("eco").force_close()
                dlg = AutotuneDialog(win, "eco", verify=True)
                st = win.h.call("autotune", "verify", "eco", "minutes=10")
                for _i in range(100):
                    dlg.show(st)
                    if st["phase"] == "done":
                        break
                    st = win.h.call("autotune", "step")
                dlg.done(st)
                assert not st["profile_lines"] and dlg.apply_btn.get_visible(), "a passed verification offers to apply the profile"
                win.h.call("autotune", "abort")
                dlg.closable = True
                dlg.close()
                dlg = AutotuneDialog(win, "eco", verify=True)   # stopped before the last iteration: not "passed"
                dlg.done(dict(st, iteration=st["iterations"]))
                assert dlg.apply_btn.get_visible() and dlg.phase.get_text() != _("Verification passed: nothing to change")
                dlg.closable = True
                dlg.close()
                cores = win.status["cores"]
                failed = dict(st, unstable={"1": {"value": -12, "why": "crash"}}, final=[-9 if c == 1 else -12 for c in range(cores)],
                              profile_lines=["co " + " ".join("-9" if c == 1 else "-12" for c in range(cores))])
                dlg = AutotuneDialog(win, "eco", verify=True)   # a core failed: the proposal raises only that one
                dlg.show(failed)
                dlg.done(failed)
                assert dlg.save_btn.get_visible() and not dlg.apply_btn.get_visible()
                dlg.closable = True
                dlg.close()
                win.ask_resume(dict(failed, phase="verify", core=2, iteration=1, iterations=3))
                win.h.call("profile", "delete", "eco")
                # a custom calibration: base and name (never a mode's), saved under its own name and listed in its row
                d = modes.calibrate_custom()
                assert d.entry.get_text().endswith("-custom") and d.get_response_enabled("next"), "custom name not proposed"
                assert not d.retry.get_active(), "retrying past crashes must be an explicit choice"
                d.entry.set_text("auto")
                assert not d.get_response_enabled("next"), "a mode's name accepted for a custom calibration"
                d.force_close()
                base = "auto" if pm_limits else "eco"
                dlg = AutotuneDialog(win, base, name="smoke-custom")
                st = win.h.call("autotune", "start", base, "name=smoke-custom", "step=3")
                for _i in range(300):
                    dlg.show(st)
                    if st["phase"] == "done":
                        break
                    st = win.h.call("autotune", "step")
                dlg.done(st)
                assert win.h.call("autotune", "save")["saved"] == "smoke-custom"
                dlg.closable = True
                dlg.close()
                cal = win.h.call("status")["calibrated"]
                modes.refresh(dict(win.status, calibrated=cal, profile=None,
                                   profile_lines={"smoke-custom": win.h.call("profile", "show", "smoke-custom")["lines"]}))
                assert "smoke-custom" in modes.custom_chk and len(modes.custom_rows) == 2, "custom calibration not listed"
                win.h.call("profile", "delete", "smoke-custom")
            # the tray menu (its logic, not exported on the bus): modes as radio entries with the active one checked,
            # a calibrated mode without a profile and Boost without unlock disabled, the crash choice on top
            tray = Tray(self, export=False)
            sent = []
            tray.run = sent.append
            ls = {"settings": {"profile": "quiet", "autostart": True, "unlock": False, "calibrated": {"auto-x": {"base": "auto"}}},
                  "crashed": None, "profiles": ["quiet", "auto-x"]}
            items = tray.build(ls)
            find = lambda its, text: next(it for it in its if it and it["label"] == text)
            assert find(items, _("Quiet"))["on"] and not find(items, _("Default"))["on"], "tray: active mode not checked"
            assert find(items, _("Eco") + _(" (not calibrated)"))["action"] is None, "tray: Eco without a profile"
            assert find(items, _("Boost") + _(" (needs unlock)"))["action"] is None, "tray: Boost without unlock"
            for text in (_("Performance"), "auto-x", _("Apply at startup")):
                find(items, text)["action"]()
            assert sent == [[["preset", "performance"], ["apply", "performance"], ["use", "performance"]],
                            [["apply", "auto-x"], ["use", "auto-x"]], [["autostart", "off"]]], sent
            items = tray.build(dict(ls, crashed={"time": "10:49", "profile": "quiet"}))
            assert items[0]["action"] is None and items[1]["label"] == _("Reactivate") and items[3] is None, "tray: crash entries"
            del sent[:]
            items[1]["action"]()
            items[2]["action"]()   # Stay on Default: after a crash Apply at startup goes off too (Default alone keeps it)
            assert sent == [[["crashed", "clear"], ["autostart", "on"], ["apply", "quiet"]],
                            [["crashed", "clear"], ["default"], ["autostart", "off"]]], sent
            del sent[:]   # on Default with Apply at startup still on: it can be turned off, not on
            find(tray.build(dict(ls, settings=dict(ls["settings"], profile=None))), _("Apply at startup"))["action"]()
            assert sent == [[["autostart", "off"]]] and find(tray.build(dict(ls, settings={})), _("Apply at startup"))["action"] is None, sent
            tray.items = items
            assert tray.layout().get_type_string() == "(u(ia{sv}av))" and "Tctl" in tray.tip, "tray: layout or tooltip"
            state = os.path.join(ROOT_DIR, "run", "siliconctl", "reapply.json")   # what `siliconctl reapply` leaves on a laptop
            with open(state, "w") as f:
                json.dump({"held": "ac"}, f)
            tray.refresh()
            os.remove(state)
            assert laptop_notes({"held": "ac"})[0] in tray.tip, "tray: laptop note missing from the tooltip"
            tray.close()
            prefs = next(p for p in win.pages if isinstance(p, PrefsPage))   # the login entry: only the icon, or the window too
            prefs.login.set_active(True)
            for tray_on, minimized, exe in ((True, True, "silicon-control --tray"), (True, False, "silicon-control\n"), (False, True, "silicon-control\n")):
                prefs.tray.set_active(tray_on)
                prefs.minimized.set_active(minimized)
                assert "Exec=" + exe in open(LOGIN_DESKTOP).read() and prefs.minimized.get_sensitive() == tray_on, (tray_on, minimized)
            prefs.login.set_active(False)
            win.ask_resume({"mode": "auto", "phase": "ppt", "started": "today"})
            win.ask_resume({"mode": "eco", "phase": "co", "parallel": True, "value": -10, "started": "today"})
            win.ask_resume({"mode": "auto", "phase": "final", "started": "today", "params": {"margin": 3}, "final_margin": 6,
                            "results": {str(c): -35 for c in range(win.status["cores"])}, "unstable": {"0": {"value": -40, "why": "crash"}}})
            measured = {"mode": "auto", "phase": "final", "params": {"margin": 3, "retry": 1}, "final_margin": 3,
                        "results": {str(c): -35 for c in range(win.status["cores"])}, "unstable": {"0": {"value": -40, "why": "crash"}}}
            assert crash_story(measured, win.status["cores"]) == _(
                "The lockup of the measurement at CO %s is ignored, as you chose: the final pass starts from the last stable value + margin, "
                "at CO %s.") % ("-40", "-32"), "retry: the measurement's lockup must be told as ignored"
            win.ask_resume({"mode": "auto", "phase": "final", "single": 1, "started": "today", "params": {"margin": 3}, "final_margin": 3,
                            "core_margin": {"1": 3}, "results": {str(c): -35 for c in range(win.status["cores"])}, "unstable": {},
                            "final_failures": [{"values": [-32] * win.status["cores"], "why": "crash", "core": 1}]})
            fans = next(p for p in win.pages if isinstance(p, FansPage))
            chans = [{"canale": 8, "rpm": 0, "pwm": 255, "modo": 0, "role": "non-controllabile"},
                     {"canale": 9, "rpm": 0, "pwm": 0, "modo": 5}]   # no role = unknown
            fans.show({"canali": chans})
            cards = list(fans.cards)
            for on in (not fans.unknown.get_expanded(), fans.unknown.get_expanded()):   # flip and back: the user's choice stays
                fans.unknown.set_expanded(on)
                assert fans.unknown.get_visible() and fans.cards == cards, "unknown section missing or cards rebuilt"
                assert cards[0].is_ancestor(fans.body) and cards[1].is_ancestor(fans.body) == on, "unknown channel not hidden/shown"
                assert ui_load().get("show_unknown_fans") == on == win.ui["show_unknown_fans"], "expanded state not saved"
            fans.show({"canali": chans[:1]})
            assert not any(c.get_parent() for c in cards), "old cards kept on reload"
            assert not fans.unknown.get_visible(), "unknown section shown without unknown channels"
        except Exception:
            import traceback
            traceback.print_exc()
            self.smoke_failed = True
        self.quit()
        return False


def main():
    argv = list(sys.argv)
    mock, smoke, tray = "--mock" in argv, "--smoke" in argv, "--tray" in argv
    shots = None
    if "--screenshots" in argv:   # --mock --screenshots DIR: README screenshots from the fake backend
        i = argv.index("--screenshots")
        shots = argv[i + 1] if i + 1 < len(argv) else None
        if not mock or not shots:
            sys.exit("usage: silicon-control --mock --screenshots DIR")
        os.makedirs(shots, exist_ok=True)
        del argv[i:i + 2]
    app = App(mock, smoke and mock, shots, tray)
    rc = app.run([a for a in argv if a not in ("--mock", "--smoke", "--tray")])
    sys.exit(1 if app.smoke_failed else rc)


if __name__ == "__main__":
    main()
