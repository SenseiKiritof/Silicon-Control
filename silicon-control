    def telemetry(self, t):
        notes = laptop_notes(t.get("reapply"))
        self.laptop.set_text("\n".join(notes))
        self.laptop.set_visible(bool(notes))
        value, sub, _bar = self.tiles["tctl"]
        value.set_text(fmt(t["tctl"], " °C"))
        sub.set_text("Tccd " + fmt(t["tccd"], " °C") + " · Tjmax " + fmt(t["tjmax"], " °C"))
        for key, unit in (("ppt", "W"), ("tdc", "A")):
            value, sub, bar = self.tiles[key]
            v, lim = t[key], t[key + "_limit"]
            value.set_text(fmt(v, " " + unit))
            sub.set_text(_("limit ") + fmt(lim, " " + unit))
            if v is not None and lim:
                bar.set_max_value(lim)
                bar.set_value(min(v, lim))
        value, sub, _bar = self.tiles["fmax"]
        value.set_text(fmt(t["fmax"], " MHz"))
        sub.set_text(_("EDC limit ") + fmt(t["edc_limit"], " A"))
        self.legend["tctl"].set_text("Tctl " + fmt(t["tctl"], " °C"))
        self.legend["ppt"].set_text("PPT " + fmt(t["ppt"], " W") + " / " + _("limit ") + fmt(t["ppt_limit"], " W"))
        if t["tctl"] is not None:
            self.hist.append((t["tctl"], t["ppt"]))
            self.ppt_limit = t["ppt_limit"]
            self.graph.queue_draw()
        if len(self.cores) != len(t["cores"]):   # one row per active core
            for _r in self.cores:
                self.grid.remove_row(1)
            self.cores = []
            for c in range(len(t["cores"])):
                row = [label("%d" % c, ["numeric"])] + [label("—", ["numeric"], xalign=1.0) for _i in range(4)]
                for col, lab in enumerate(row):
                    self.grid.attach(lab, col, c + 1, 1, 1)
                self.cores.append(row[1:])
        for d, labs in zip(t["cores"], self.cores):
            labs[0].set_text(fmt(d.get("mhz")))
            labs[1].set_text(fmt(d.get("temp")))
            labs[2].set_text(volts(d.get("volt"), ""))
            labs[3].set_text("%+d" % d["co"] if d.get("co") is not None else _("n/a"))
        for f in t["fans"]:
            lab = self.fan_labels.get(f["canale"])
            if lab is None:
                lab = self.fan_labels[f["canale"]] = label("", ["numeric"])
                self.fans.append(lab)
            pwm = f.get("pwm")
            if pwm is None:   # telemetry does not carry the pwm: last `fan status` (updated at every reload)
                pwm = next((c["pwm"] for c in (self.win.status.get("fans") or {}).get("canali", []) if c["canale"] == f["canale"]), None)
            role = f.get("role", "sconosciuto")
            lab.set_visible(role != "sconosciuto" or bool(self.win.ui.get("show_unknown_fans")))   # Fans page section expanded
            lab.set_text(_("%s (%s) · %d rpm%s") % (f.get("name") or _("Channel %d") % f["canale"], ROLE_NAMES.get(role, role), f["rpm"],
                                                   " · pwm %d (%d %%)" % (pwm, pwm_pct(pwm)) if pwm is not None else ""))
        if not self.fan_labels:
            self.fans.append(label(_("No fans detected"), ["dim-label"]))
            self.fan_labels[0] = None
        self.power.set_text(_("Power mode: ") + (t["power"] or _("n/a")))

    def draw(self, area, cr, w, h):
        """Four-step grid shared by both scales: Tctl 20–100 °C on the left, PPT in round watts that
        cover its limit on the right (the limit dashed); time runs left to right, newest at the edge."""
        plim = self.ppt_limit or 0
        pstep = -(-plim // 20) * 5   # a quarter of the PPT scale: limit / 4 rounded up to 5 W
        left = ["%d °C" % (20 + 20 * i) for i in range(5)]
        right = ["%d W" % (pstep * i) for i in range(5)] if pstep else []
        cr.set_font_size(10)
        x0 = max(cr.text_extents(s).x_advance for s in left) + 8
        x1 = w - max([cr.text_extents(s).x_advance for s in right] or [0]) - 8
        y0, y1 = 14, h - 20   # room above the top line for the limit label
        Y = lambda f: y1 - min(max(f, 0), 1) * (y1 - y0)   # f: fraction of the scale
        col = area.get_color()
        cr.set_line_width(1)
        for i in range(5):
            y = round(Y(i / 4)) + 0.5   # 1 px lines on a pixel row: crisp
            cr.set_source_rgba(col.red, col.green, col.blue, 0.25)
            cr.move_to(x0, y)
            cr.line_to(x1, y)
            cr.stroke()
            cr.set_source_rgb(*self.TCTL_RGB)
            cr.move_to(x0 - 4 - cr.text_extents(left[i]).x_advance, y + 3.5)
            cr.show_text(left[i])
            if right:
                cr.set_source_rgb(*self.PPT_RGB)
                cr.move_to(x1 + 4, y + 3.5)
                cr.show_text(right[i])
        cr.set_source_rgba(col.red, col.green, col.blue, 0.7)
        cr.move_to(x0, h - 4)
        cr.show_text(_("%d s ago") % self.hist.maxlen)
        now = _("now")
        cr.move_to(x1 - cr.text_extents(now).x_advance, h - 4)
        cr.show_text(now)
        series = [(0, self.TCTL_RGB, 20, 80)]
        if pstep:
            series.append((1, self.PPT_RGB, 0, 4 * pstep))
            yl = round(Y(plim / (4 * pstep))) + 0.5
            cr.set_source_rgb(*self.PPT_RGB)
            cr.set_dash([5, 4])
            cr.move_to(x0, yl)
            cr.line_to(x1, yl)
            cr.stroke()
            cr.set_dash([])
            text = _("PPT limit")
            cr.move_to(x1 - 4 - cr.text_extents(text).x_advance, yl - 4 if yl - y0 > 14 else y0 - 4)   # above the line, else above the top one
            cr.show_text(text)
        n = self.hist.maxlen
        cr.set_line_width(2)
        for idx, rgb, base, span in series:
            pts = [(x0 + (x1 - x0) * (n - len(self.hist) + i) / (n - 1), Y((v[idx] - base) / span))
                   for i, v in enumerate(self.hist) if v[idx] is not None]
            if len(pts) < 2:
                continue
            cr.set_source_rgb(*rgb)
            cr.move_to(*pts[0])
            for p in pts[1:]:
                cr.line_to(*p)
            cr.stroke()


class AutotuneDialog(Adw.Window):
    """Calibration progress: one `autotune step` at a time until phase == done.
    Separate, resizable window (Adw.Dialog has fixed dimensions and the table is tall)."""

    def __init__(self, win, mode, verify=False, name=None):
        # verify: `autotune verify` of the saved profile `mode` (same window: progress, per-core table, proposal);
        # name: a custom calibration from the base mode `mode`, saved under its own name (the mode's profile untouched)
        super().__init__(title=_("%s verification") % mode.capitalize() if verify else
                         _("Custom calibration from %s → %s") % (mode.capitalize(), name) if name else
                         _("%s calibration") % mode.capitalize(), transient_for=win,
                         modal=True, destroy_with_parent=True,
                         default_width=max(640, int(win.get_width() * 0.9)), default_height=max(560, int(win.get_height() * 0.9)))
        self.win, self.mode, self.verify, self.name = win, mode, verify, name
        self.target = name or mode   # the profile the result is saved as
        self.running = self.aborting = False
        self.closable = False
        self.connect("close-request", self.on_close_request)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        self.header = label("", ["dim-label"], wrap=True)
        # one line, allocated from the start (constant height): the hardware watchdog state reported by siliconctl serve
        self.watchdog = label(" ", ["dim-label", "caption"], ellipsize=Pango.EllipsizeMode.END, single_line_mode=True, tooltip_text=WD_TIP)
        self.reuse = label("", ["dim-label"], wrap=True, visible=False)
        # constant heights: every height change moves the table and the compositor leaves fragments
        self.phase = label(_("Starting…"), ["title-3"], hexpand=True, ellipsize=Pango.EllipsizeMode.END, single_line_mode=True)
        self.eta = label(" ", ["numeric"], xalign=1.0)
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        top.append(self.phase)
        top.append(self.eta)
        self.progress = Gtk.ProgressBar(show_text=True)
        self.note = label("", ["warning"], wrap=True, visible=False)
        # progress (start, phase, time left, bar) pinned above the scrolled area: visible while scrolling the results
        pinned = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=6, margin_bottom=10, margin_start=12, margin_end=12)
        for w in (self.header, self.watchdog, top, self.progress):
            pinned.append(w)
        for w in (self.reuse, self.note, label(_("CO (Curve Optimizer) per core"), ["heading"], tooltip_text=CO_TIP)):
            body.append(w)
        grid = Gtk.Grid(column_spacing=14, row_spacing=4, hexpand=True)
        heads = ((_("Core"), None), (_("Stock"), _("Stock CO; below, the reference voltage measured at start under the same load")),
                 (_("Testing"), _("CO level under test on the core; below, the last voltage measured at full load and the difference from the reference")),
                 (_("Last stable"), None), (_("Unstable at"), None),
                 (_("Final"), _("measured limit + mode margin + 3 for every failed final pass")))
        for col, (h, tip) in enumerate(heads):
            grid.attach(label(h, ["heading"], tooltip_text=tip), col, 0, 1, 1)
        self.cells = []
        for c in range(win.status.get("cores", 0)):   # one row per active core
            cell = {"core": label("%d" % c, ["numeric"], valign=Gtk.Align.START)}
            boxes = []
            for key in ("fab", "prova"):   # two lines: CO above, voltage below; fixed width = no reflows
                cell[key] = (label("—", ["numeric"], width_chars=4 if key == "fab" else 8),
                             label(" ", ["numeric", "caption"], width_chars=9 if key == "fab" else 22))
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                box.append(cell[key][0])
                box.append(cell[key][1])
                boxes.append(box)
            for key, wc in (("stable", 6), ("unstable", 16), ("final", 6)):
                cell[key] = label("—", ["numeric"], valign=Gtk.Align.START, width_chars=wc)
            for col, w in enumerate([cell["core"]] + boxes + [cell["stable"], cell["unstable"], cell["final"]]):
                w.set_hexpand(col > 0)          # the data columns share the available width
                grid.attach(w, col, c + 1, 1, 1)
            self.cells.append(cell)
        body.append(grid)
        body.append(label(_("One CO (Curve Optimizer) step is worth about 3–5 mV less voltage at the same frequency; "
                            "here you see the real voltage measured at full load for every level."), ["dim-label", "caption"], wrap=True))
        self.slope = label("", ["numeric"], visible=False)
        body.append(self.slope)
        self.failures = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)   # failed final passes, one line each
        body.append(self.failures)
        self.sweeps = label("", ["numeric"], wrap=True)
        body.append(self.sweeps)
        self.result = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        body.append(self.result)
        bar = Gtk.Box(spacing=12, halign=Gtk.Align.END, css_classes=["toolbar"])
        self.abort_btn = button(_("Stop"), self.abort, "destructive-action")
        self.close_btn = button(_("Close"), self.discard)                        # error: nothing to save
        self.discard_btn = button(_("Discard"), self.discard, "destructive-action")
        self.save_btn = button(_("Save"), lambda: self.save(False))
        self.save_apply_btn = button(_("Save and apply"), lambda: self.save(True), "suggested-action")
        self.apply_btn = button(_("Apply the profile"), self.apply_profile, "suggested-action")   # verification passed
        for b in (self.close_btn, self.discard_btn, self.save_btn, self.save_apply_btn, self.apply_btn):
            b.set_visible(False)
        self.save_btn.set_tooltip_text(_("Writes the %s profile without activating it: apply it from the Modes page") % mode)
        self.save_apply_btn.set_tooltip_text(_("Writes the %s profile, applies it right away and selects it") % mode)
        if verify:   # Stop keeps what was tested: result and proposal (`autotune finish`)
            self.abort_btn.set_tooltip_text(_("Ends the verification now: result and proposal from the tests done so far"))
        for b in (self.abort_btn, self.close_btn, self.discard_btn, self.save_btn, self.save_apply_btn, self.apply_btn):
            bar.append(b)
        # in a wide window the content stays centred and readable (max 1100 px), the grid widens
        clamp = Adw.Clamp(child=body, maximum_size=1100, tightening_threshold=800)
        self.scroller = Gtk.ScrolledWindow(child=clamp, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        tv = Adw.ToolbarView(content=self.scroller, top_bar_style=Adw.ToolbarStyle.RAISED)
        tv.add_top_bar(Adw.HeaderBar())
        tv.add_top_bar(Adw.Clamp(child=pinned, maximum_size=1100, tightening_threshold=800))
        tv.add_bottom_bar(bar)
        self.set_content(tv)
        self.present()

    def on_close_request(self, *_a):
        if not self.closable:
            self.win.toast(_("Calibration in progress: use \"Stop\""))
            return True     # blocks the close
        return False

    def start(self, params):
        argv = (["autotune", "verify" if self.verify else "start", self.mode] + (["name=" + self.name] if self.name else [])
                + ["%s=%d" % kv for kv in params.items()])
        bg(lambda: self.win.h.call(*argv), self.got, self.fail)

    def loop(self):
        if self.running or self.aborting:
            return
        self.running = True
        bg(lambda: self.win.h.call("autotune", "step"), self.got, self.fail)

    def got(self, st):
        self.running = False
        if self.aborting:   # Stop pressed: the reply of the interrupted step is stale (finish/abort answer next)
            return
        self.show(st)
        if st.get("phase") == "done":
            self.done(st)
        else:
            self.loop()

    def fail(self, msg):
        self.running = False
        self.phase.set_text(_("Error: ") + msg)
        self.abort_btn.set_visible(False)
        self.close_btn.set_visible(True)
        setattr(self, "closable", True)

    def show(self, st):
        ph, p = st.get("phase"), st.get("params", {})
        if st.get("resumed_after_crash"):
            self.note.set_text(_("The system rebooted during the test of a core: that core is recorded as failed (crash) and no longer "
                                 "tested; after a reboot the profile is applied again.") if self.verify else
                               _("The system rebooted during a test: that step has been marked unstable. If the final CO was already "
                                 "applied, the combination is unstable and the final pass is repeated with +3 on every core."))
            self.note.set_visible(True)
        if st.get("watchdog"):
            self.watchdog.set_text(_("Hardware watchdog: %s") % st["watchdog"])
        if st.get("co_reused"):   # search skipped: table already populated, the CO phase counts as complete in the bar
            if st.get("eco_from"):   # Eco: final pass skipped too
                text = _("Undervolt validated by the final pass of %s, reused without load tests. %s") % (st["eco_from"], crash_story(st, len(self.cells)))
            else:
                text = _("CO limit reused from the measurement of %s. %s") % (st["co_reused"], crash_story(st, len(self.cells)))
            self.reuse.set_text(text)
            self.reuse.set_visible(True)
        eta = st.get("eta") or {}
        if eta:
            self.header.set_text(_("Started at %s · estimated %s in total") % (st.get("started", "")[-5:], mins(eta.get("total_s"))))
            self.eta.set_text(_("Estimated time remaining: %s") % mins(eta.get("remaining_s")))
        n = len(self.cells)
        if ph == "verify":                        # one test per step: each core alone, then all together, per iteration
            c, it = st.get("core", 0), (st.get("iteration", 1), st.get("iterations", 1))
            if c < n:
                self.phase.set_text(_("Verifying core %d alone at CO %d (iteration %d of %d)…") % ((c, st["final"][c]) + it))
            else:
                self.phase.set_text(_("Verifying all cores together (iteration %d of %d)…") % it)
            frac = ((it[0] - 1) * (n + 1) + min(c, n)) / float(max(1, it[1] * (n + 1)))
        elif ph == "co" and st.get("parallel"):
            levels = max(1, (-(p.get("colimit") or -5)) // 5)      # levels of 5 (CO_STEP), like at_estimate in siliconctl
            self.phase.set_text(_("CO level %d: testing all cores together (still under test: %d cores)…") % (st["value"], len(st.get("active_cores", []))))
            frac = AT_PHASES["co"] * max(0, (-st["value"]) // 5 - 1) / levels
        elif ph == "co":
            self.phase.set_text(_("Core %d: testing CO %d…") % (st["core"], st["value"]))
            frac = (st["core"] + min(1.0, st["value"] / p["colimit"] if p.get("colimit") else 0)) / max(1, len(self.cells))
        elif ph == "final":
            vals, c = self.final_values(st, n), st.get("single")
            if c is None:
                self.phase.set_text(_("Final pass on all cores at CO %s (attempt %d/3)") % (self.co_span(vals), st.get("final_tries", 0) + 1))
            else:   # the single-core part: one step per core
                self.phase.set_text(_("Final pass, single-core test: core %d alone at CO %d (%d of %d)…") % (c, vals[c], c + 1, n))
            part = 0 if c is None else (c + 1) / float(n + 1)
            frac = AT_PHASES["co"] + (AT_PHASES["final"] - AT_PHASES["co"]) * min(1.0, (st.get("final_tries", 0) + part) / 3)
        elif ph == "bench":                       # Boost: a single step, performance at stock and in boost
            self.phase.set_text(_("Measuring performance at stock and in boost (MT and ST)…") + self.load_text(st))
            frac = (AT_PHASES["final"] + AT_PHASES["bench"]) / 2
        elif ph in ("ppt", "fmax_knee"):          # Auto: performance/watt knee
            k = st.get("knee", {}).get("ppt" if ph == "ppt" else "fmax", {})
            tests, cur = k.get("tests", []), k.get("current")
            unit = "W" if ph == "ppt" else "MHz"
            if tests:
                last = tests[-1]
                self.phase.set_text(_("%s %s %s: %.0f op/s at %.0f W → trying %s %s…%s") % (
                    "PPT" if ph == "ppt" else "FMax", last[0], unit, last[1], last[2], cur, unit, self.load_text(st)))
            else:
                self.phase.set_text(_("%s %s %s: measuring performance and power…%s") % ("PPT" if ph == "ppt" else "FMax", cur, unit, self.load_text(st)))
            lo, hi = (AT_PHASES["final"], AT_PHASES["ppt"]) if ph == "ppt" else (AT_PHASES["ppt"], AT_PHASES["fmax_knee"])
            frac = lo + (hi - lo) * min(1.0, len(tests) / 6.0)
        else:
            self.phase.set_text(_("Calibration complete") if not st.get("error") else _("Calibration ended: ") + st["error"])
            frac = 1.0
        self.progress.set_fraction(max(0.0, min(1.0, frac)))
        self.queue_draw()                   # full redraw: no fragments of the previous frame
        self.follow()
        res, uns, fin = st.get("results", {}), st.get("unstable", {}), st.get("final")
        base_co = (self.win.status.get("baseline") or {}).get("co") or [None] * n
        ref = (st.get("samples", {}).get("0") or {}).get("volt") or [None] * n
        ref_mhz = (st.get("samples", {}).get("0") or {}).get("mhz") or [None] * n
        if ph == "verify":   # under test: the core alone, or every core not failed yet in the all-core pass
            active = [st["core"]] if st["core"] < n else [c for c in range(n) if str(c) not in uns]
        else:
            active = st.get("active_cores", []) if st.get("parallel") else [st.get("core")]
        for c, cell in enumerate(self.cells):
            fab_sub = volts(ref[c]) + (" · " + mhz(ref_mhz[c]) if ref_mhz[c] is not None else "") if ref[c] is not None else None
            self.two_lines(cell["fab"], "%d" % base_co[c] if base_co[c] is not None else "—", fab_sub)
            smp = at_sample(st, c)                      # deepest measurement available for this core
            if ph in ("co", "verify") and c in active:
                cur = st["value"] if ph == "co" else fin[c]
            else:
                cur = smp[0] if smp else None
            sub, css = None, None
            if smp:
                dmv = round((smp[1] - ref[c]) * 1000) if ref[c] is not None else None
                sub = (("" if smp[0] == cur else _("at %d: ") % smp[0]) + volts(smp[1]) + (" · " + mhz(smp[2]) if smp[2] is not None else "")
                       + ("" if dmv is None else " · %+d mV" % dmv))
                css = "success" if dmv is not None and dmv < 0 else None
            self.two_lines(cell["prova"], "%d" % cur if cur is not None else "—", sub, css)
            why = uns[str(c)]["why"] if str(c) in uns else None
            for lab, text, cls in ((cell["stable"], "%d" % res[str(c)] if str(c) in res else None, "success"),
                                   (cell["unstable"], "%d (%s)" % (uns[str(c)]["value"], WHY_NAMES.get(why, why)) if str(c) in uns else None, "error"),
                                   (cell["final"], "%d" % fin[c] if fin else None, "success")):
                lab.set_markup("<b>%s</b>" % text if text and lab is cell["final"] else (text or "—"))
                (lab.add_css_class if text else lab.remove_css_class)(cls)
        fails = st.get("final_failures") or []
        while self.failures.get_first_child():
            self.failures.remove(self.failures.get_first_child())
        for f in fails:
            why = f.get("why", "?")
            if f.get("core") is not None:   # failed alone in the single-core part: only that core is raised
                text = _("Core %d failed alone at CO %d (%s): +3 on that core only and a new final pass") % (
                    f["core"], f["values"][f["core"]], WHY_NAMES.get(why, why))
            else:
                text = _("Final pass failed at CO %s (%s): +3 on every core and a new attempt") % (self.co_span(f.get("values") or [0]), WHY_NAMES.get(why, why))
            self.failures.append(label(text, ["warning"], wrap=True))
        slope = st.get("mv_per_step")          # median of the slopes per level, computed by siliconctl
        self.slope.set_visible(slope is not None)
        if slope is not None:
            self.slope.set_text(_("Measured on this CPU: ≈ %s mV per CO step") % locale.format_string("%g", round(slope, 1)))
        knee, text = st.get("knee"), ""
        if knee:   # Auto: the knee sweeps
            for key, unit in (("ppt", "W"), ("fmax", "MHz")):
                if knee[key]["tests"]:
                    text += ("\n" if text else "") + _("%s sweep:\n") % key.upper() + "\n".join(
                        "%s %s → %.0f op/s, %.0f W" % (t[0], unit, t[1], t[2]) for t in knee[key]["tests"])
        self.sweeps.set_text(text)
        self.sweeps.set_visible(bool(text))   # Eco and Boost have no sweep: no empty gap above the result

    @staticmethod
    def final_values(st, cores):
        """CO of the final pass: measured limit + margin (computed by siliconctl: mode, failed passes, crash) + the
        extra margin of the cores that failed alone in the single-core test (core_margin)."""
        m = st.get("final_margin", st.get("params", {}).get("margin", 0) + 3 * st.get("final_tries", 0))
        cm = st.get("core_margin") or {}
        return [min(0, st.get("results", {}).get(str(c), 0) + m + cm.get(str(c), 0)) for c in range(cores)]

    @staticmethod
    def co_span(vals):
        return "%d" % vals[0] if min(vals) == max(vals) else "%d … %d" % (min(vals), max(vals))

    @staticmethod
    def load_method(st):
        """stress-ng method chosen by siliconctl as the heaviest on this CPU (Auto: knee.method, Boost: method)."""
        return (st.get("knee") or {}).get("method") or st.get("method")

    def load_text(self, st):
        m = self.load_method(st)
        return _(" (load: %s)") % m if m else ""

    @staticmethod
    def two_lines(pair, main, sub=None, sub_css=None):
        pair[0].set_text(main)
        pair[1].set_text(sub or "")
        if not sub:
            pair[1].set_text(" ")          # stays allocated: the row height does not change
        pair[1].remove_css_class("success")
        if sub_css:
            pair[1].add_css_class(sub_css)

    def follow(self):
        """New lines (sweeps, failed passes, results) go at the bottom: scroll there, unless the user
        scrolled up to read something."""
        adj = self.scroller.get_vadjustment()
        at_end = adj.get_value() >= adj.get_upper() - adj.get_page_size() - 40
        if at_end:   # after the layout of the new content
            GLib.idle_add(lambda: adj.set_value(adj.get_upper() - adj.get_page_size()) and False)

    def done(self, st):
        if st.get("error"):
            self.result.append(label(st["error"], ["warning"], wrap=True))
        tries = st.get("final_tries", 0)
        crashed = any(u.get("why") == "crash" for u in (st.get("unstable") or {}).values()) and not st.get("params", {}).get("retry")
        if (tries or crashed) and st.get("final") and not self.verify:
            why = []
            if tries:
                why.append(_("the combined pass failed once") if tries == 1 else _("the combined pass failed %d times") % tries)
            if crashed:
                why.append(_("the search ended with a system lockup (+3)"))
            self.result.append(label(_("The final margin is +%d because %s") % (st.get("final_margin", 0), _(" and ").join(why)), ["warning"], wrap=True))
        cm = st.get("core_margin") or {}
        if cm and st.get("final"):   # cores that failed alone in the single-core test of the final pass
            self.result.append(label(_("Raised alone after failing the single-core test: %s") % ", ".join(
                _("core %s +%d") % (c, m) for c, m in sorted(cm.items(), key=lambda kv: int(kv[0]))), ["warning"], wrap=True))
        if self.verify:   # per core: failed (reason) or held; the live table above has the details
            uns = st.get("unstable") or {}
            if uns:
                self.result.append(label(_("Failed: %s. The proposal raises only those cores by +3 (less negative).") % ", ".join(
                    _("core %s at CO %d (%s)") % (c, u["value"], WHY_NAMES.get(u.get("why"), u.get("why")))
                    for c, u in sorted(uns.items(), key=lambda kv: int(kv[0]))), ["warning"], wrap=True))
            else:
                self.result.append(label(_("No core failed (iterations completed: %d of %d; every core alone, then all together).") % (
                    min(st.get("iteration", 1) - 1, st.get("iterations", 0)), st.get("iterations", 0)), ["success"], wrap=True))
        elif st.get("final"):   # per core: stock → final CO and measured ΔV (sample at the final level or the closest one)
            n = len(st["final"])
            base_co = (self.win.status.get("baseline") or {}).get("co") or [None] * n
            ref = (st.get("samples", {}).get("0") or {}).get("volt") or [None] * n
            grid = Gtk.Grid(column_spacing=18, row_spacing=4)
            for col, h in enumerate((_("Core"), _("Stock → final CO"), _("Measured ΔV"))):
                grid.attach(label(h, ["heading"], tooltip_text=CO_TIP if col == 1 else None), col, 0, 1, 1)
            for c in range(n):
                grid.attach(label("%d" % c, ["numeric"]), 0, c + 1, 1, 1)
                grid.attach(diff_label(base_co[c], st["final"][c]), 1, c + 1, 1, 1)
                smp = at_sample(st, c, st["final"][c])
                if smp and ref[c] is not None:
                    dmv = round((smp[1] - ref[c]) * 1000)
                    lab = label(_("%+d mV (%s → %s%s at CO %d)") % (dmv, volts(ref[c]), volts(smp[1]), ", " + mhz(smp[2]) if smp[2] is not None else "", smp[0]),
                                ["numeric", "success" if dmv < 0 else "dim-label"])
                else:
                    lab = label(_("n/a"), ["numeric", "dim-label"])
                grid.attach(lab, 2, c + 1, 1, 1)
            self.result.append(label(_("CO (Curve Optimizer) per core: stock → final, with the measured voltage"), ["heading"], tooltip_text=CO_TIP))
            self.result.append(grid)
        bench = st.get("bench")
        if bench and bench.get("gain_mt_pct") is not None:
            pct = lambda v: locale.format_string("%+.1f %%", v) if v is not None else _("n/a")
            ops = lambda d: ("%.0f" % (d or {}).get("mt", [0])[0])
            g = bench["gain_mt_pct"]
            self.result.append(label(_("Measured gain: multi-thread %s (%s → %s op/s), single-thread %s") % (
                pct(g), ops(bench.get("fabbrica")), ops(bench.get("boost")), pct(bench.get("gain_st_pct"))),
                ["numeric", "success" if g > 0 else ("error" if g < 0 else "dim-label")], wrap=True))
        if st.get("profile_lines"):
            self.result.append(label((_("%s profile: stock → proposed") if self.verify else _("%s profile: stock → calibrated")) % self.target, ["heading"]))
            self.result.append(profile_view(st["profile_lines"], self.win.status))
        knee = st.get("knee")
        if knee and knee["ppt"].get("chosen"):
            fmax = (_(", FMax %d MHz") % knee["fmax"]["chosen"]) if knee["fmax"].get("chosen") else ""   # no FMax on Zen 3
            self.result.append(label(_("Performance/watt knee: PPT %d W%s (maximum loss %d %%)") % (
                knee["ppt"]["chosen"], fmax, st.get("params", {}).get("loss", 0)), ["numeric"], wrap=True))
        method = self.load_method(st)
        if method:
            self.result.append(label(_("Test load: %s — the one that draws the most power on this CPU") % method, ["dim-label"], wrap=True))
        # ponytail: "below the limit" = more than 5 % under; the PM table watts swing by a few units around the limit
        below = [t for t in (knee or {}).get("ppt", {}).get("tests", []) if len(t) >= 3 and t[2] < t[0] * 0.95]
        if len(below) > 1:
            self.result.append(label(_("The test load did not reach the configured power limit: the knee holds for loads of this intensity"),
                                     ["warning"], wrap=True))
        self.abort_btn.set_visible(False)
        if st.get("profile_lines"):
            self.phase.set_text(_("Verification complete: discard the proposal, save it, or save and apply?") if self.verify
                                else _("Calibration complete: discard, save, or save and apply?"))
            for b in (self.discard_btn, self.save_btn, self.save_apply_btn):
                b.set_visible(True)
        elif self.verify and not st.get("unstable"):   # held: nothing to change; the CPU is back at the stock values
            complete = st.get("iteration", 1) > st.get("iterations", 0)   # not stopped early with Stop / Show the result
            self.phase.set_text(_("Verification passed: nothing to change") if complete
                                else _("Verification stopped early: no core failed in the tests done"))
            for b in (self.close_btn, self.apply_btn):
                b.set_visible(True)
        else:
            self.phase.set_text(_("Calibration ended without a profile to save"))
            self.close_btn.set_visible(True)
        self.follow()   # the proposed profile is at the bottom
        # the choice is mandatory: the window closes only afterwards (the state stays on disk and is proposed again)

    def choose(self, argv, msg, more=()):
        for b in (self.close_btn, self.discard_btn, self.save_btn, self.save_apply_btn, self.apply_btn):
            b.set_sensitive(False)
        self.win.run([argv] + list(more), lambda _r: (self.win.toast(msg), setattr(self, "closable", True), self.close()))

    def apply_profile(self):
        """After a verification that passed: the profile again, as before the run (the CPU is at the stock values)."""
        self.choose(["autotune", "abort"], _("Profile '%s' applied") % self.mode, (["apply", self.mode], ["use", self.mode]))

    def discard(self):
        self.choose(["autotune", "abort"], _("Verification discarded, CPU at baseline") if self.verify else _("Calibration discarded, CPU at baseline"))

    def save(self, apply):
        self.choose(["autotune", "save"] + (["apply"] if apply else []),
                    _("%s profile saved and applied") % self.target if apply else _("%s profile saved (not applied)") % self.target)

    def finished(self, st):
        self.show(st)
        self.done(st)

    def abort(self):
        self.aborting = True
        self.abort_btn.set_sensitive(False)
        self.phase.set_text(_("Stopping…"))
        if self.verify:   # what was tested is kept: result and proposal
            bg(lambda: self.win.h.call("autotune", "finish"), self.finished, self.fail)
            return
        self.win.run([["autotune", "abort"]], lambda _r: (self.win.toast(_("Calibration discarded, CPU at baseline")), setattr(self, "closable", True), self.close()))


class ModesPage(Gtk.ScrolledWindow):
    NAME, TITLE, ICON = "modes", _("Modes"), "emblem-default-symbolic"

    def __init__(self, win):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        self.win = win
        self.loading = False
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24, margin_top=12, margin_bottom=24, margin_start=12, margin_end=12)
        self.set_child(Adw.Clamp(child=content, maximum_size=1400, tightening_threshold=1000))   # two columns: wider than a PreferencesPage
        # two columns always side by side (a FlowBox stacked them: the expanded rows ask for more
        # natural width than half the window), presets and manual choices on the left, calibrated ones on the right
        cols = Gtk.Box(spacing=18, homogeneous=True)
        lists = {}
        for name, title, desc in (("preset", _("Presets"), _("Fixed values derived from the stock ones, no test; plus Default and Custom")),
                                  ("calibrate", _("Calibrated"), _("Measured on this CPU with load tests (Calibrate…)"))):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, valign=Gtk.Align.START, hexpand=True)
            col.append(label(title, ["heading"]))
            col.append(label(desc, ["dim-label", "caption"], wrap=True))
            lists[name] = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
            col.append(lists[name])
            cols.append(col)
        content.append(cols)
        self.rows, first = {}, None
        self.tables, self.cal, self.verify_btns = {}, {}, {}
        for key, title, sub in MODES:
            if key in PRESETS:   # expandable: under the row the stock → profile table
                row = Adw.ExpanderRow(title=title, subtitle=sub, expanded=True)
            else:
                row = Adw.ActionRow(title=title, subtitle=sub, activatable=True)
            chk = Gtk.CheckButton(valign=Gtk.Align.CENTER, group=first)
            first = first or chk
            row.add_prefix(chk)
            if key not in PRESETS:
                row.set_activatable_widget(chk)
            chk.connect("toggled", self.on_mode, key)
            regen = None
            if key in PRESETS:
                # compact suffixes: with too many wide buttons the title was squeezed to a single column
                row.set_title_lines(1)
                row.set_subtitle_lines(3)          # half-window column: the subtitle needs one more line
                tag = Gtk.Label(label=_("calibrated") if key in CALIBRATED else _("preset"), valign=Gtk.Align.CENTER,
                                tooltip_text=_("Adapts to the hardware with load tests") if key in CALIBRATED
                                else _("Fixed values derived from the stock ones, no test"))
                tag.add_css_class("chip")
                tag.add_css_class("success" if key in CALIBRATED else "dim-label")
                row.add_suffix(tag)
                if key in CALIBRATED:
                    cal = self.cal[key] = button(_("Calibrate…"), lambda k=key: self.calibrate(k))
                    cal.set_tooltip_text(_("Measures on this CPU: per-core undervolt, FMax, limits and fans"))
                    row.add_suffix(cal)
                    ver = Gtk.Button(icon_name="security-high-symbolic", valign=Gtk.Align.CENTER, visible=False,
                                     tooltip_text=_("Verify…: long stability test of the saved profile (each core alone, then all together)"))
                    ver.add_css_class("flat")   # compact like the regenerate button; only once the profile exists
                    ver.connect("clicked", lambda *_a, k=key: self.verify(k))
                    row.add_suffix(ver)
                    self.verify_btns[key] = ver
                regen = Gtk.Button(icon_name="view-refresh-symbolic", valign=Gtk.Align.CENTER,
                                   tooltip_text=_("Regenerate the profile from the stock values"))
                regen.add_css_class("flat")
                regen.connect("clicked", lambda *_a, k=key: self.regen(k))
                row.add_suffix(regen)
            self.rows[key] = (row, chk, regen)
            lists["calibrate" if key in CALIBRATED else "preset"].append(row)
        # custom calibrations: from Eco/Auto/Boost with your parameters, each saved under its own name, so the
        # three modes (e.g. an Auto that works) are never overwritten while trying something else
        self.first, self.custom_rows, self.custom_chk = first, [], {}
        self.custom = Adw.ExpanderRow(title=_("Custom"), expanded=True,
                                      subtitle=_("Calibrations from Eco, Auto or Boost with your parameters, each saved as a new "
                                                 "profile: the three modes stay as they are"))
        self.custom.set_title_lines(1)
        self.custom.set_subtitle_lines(3)
        self.custom_cal = button(_("Calibrate…"), self.calibrate_custom)
        self.custom_cal.set_tooltip_text(_("Pick the base mode and the name of the new profile, then the usual parameters"))
        self.custom.add_suffix(self.custom_cal)
        lists["calibrate"].append(self.custom)
        self.lock_calibrated({})   # until the status says that unlock is on

    def lock_calibrated(self, st):
        """The calibrated modes measure the per-core CO (none on Ryzen 1000–3000); Boost also needs unlock
        (siliconctl refuses both). Radio and buttons insensitive, row dimmed, the reason in the tooltip of the
        row, which stays sensitive: GTK 4 hides a tooltip owned by an insensitive widget at the first pointer
        motion. The buttons' own tooltips are off meanwhile, so they do not cover the row's."""
        no_co = st.get("co_unavailable")
        for key in CALIBRATED:
            why = (_("Calibrated modes measure the per-core Curve Optimizer, not available on this CPU: %s") % no_co if no_co
                   else _("Boost needs \"Allow beyond the stock values\": turn it on in Preferences")
                   if key == "boost" and not st.get("unlock") else None)
            row, chk, regen = self.rows[key]
            for w in (chk, self.cal[key], regen, self.verify_btns[key]):
                w.set_sensitive(not why)
                w.set_has_tooltip(not why)
            (row.add_css_class if why else row.remove_css_class)("dim-label")
            row.set_tooltip_text(why)
        self.custom_cal.set_sensitive(not no_co)
        self.custom.set_tooltip_text(_("Calibrated modes measure the per-core Curve Optimizer, not available on this CPU: %s") % no_co
                                     if no_co else None)

    def refresh_custom(self, st):
        """One row per saved custom calibration (radio = apply, Verify…, delete) with its stock → profile table."""
        for r in self.custom_rows:
            self.custom.remove(r)
        self.custom_rows, self.custom_chk = [], {}
        shown, no_co = st.get("profile_lines", {}), st.get("co_unavailable")
        for name, meta in sorted(st.get("calibrated", {}).items()):
            row = Adw.ActionRow(title=name, subtitle=_("from %s, %s") % (meta.get("base", "?").capitalize(), meta.get("time", "?")),
                                activatable=True)
            chk = self.custom_chk[name] = Gtk.CheckButton(valign=Gtk.Align.CENTER, group=self.first)
            row.add_prefix(chk)
            row.set_activatable_widget(chk)
            chk.connect("toggled", self.on_mode, name)
            why = (_("Boost needs \"Allow beyond the stock values\": turn it on in Preferences")
                   if meta.get("base") == "boost" and not st.get("unlock") else no_co)
            for icon, tip, cb in (("security-high-symbolic", _("Verify…: long stability test of the saved profile (each core alone, then all together)"), self.verify),
                                  ("user-trash-symbolic", _("Delete this custom calibration"), self.delete_custom)):
                b = Gtk.Button(icon_name=icon, valign=Gtk.Align.CENTER, tooltip_text=tip)
                b.add_css_class("flat")
                b.connect("clicked", lambda *_a, n=name, f=cb: f(n))
                b.set_sensitive(not why or cb == self.delete_custom)
                row.add_suffix(b)
            chk.set_sensitive(not why)
            row.set_tooltip_text(why)
            self.custom_rows.append(row)
            if name in shown:
                self.custom_rows.append(Gtk.ListBoxRow(child=profile_table(shown[name], st), activatable=False, selectable=False))
        for r in self.custom_rows:
            self.custom.add_row(r)

    def refresh(self, st):
        self.loading = True
        self.lock_calibrated(st)
        prof = st.get("profile")
        shown = st.get("profile_lines", {})
        for key, title, sub in MODES:
            row, chk, regen = self.rows[key]
            if regen:
                exists = key in shown
                regen.set_visible(exists)
                if key in self.verify_btns:   # siliconctl verifies only where the per-core CO is usable
                    self.verify_btns[key].set_visible(exists and st.get("co") is not None)
                row.set_subtitle(sub if exists else sub + _(" — profile not created yet: tick to create it"))
                if key in self.tables:
                    row.remove(self.tables.pop(key))
                if exists:   # explicit ListBoxRow: this way `row.remove` finds it again at the next refresh
                    self.tables[key] = Gtk.ListBoxRow(child=profile_table(shown[key], st), activatable=False, selectable=False)
                    row.add_row(self.tables[key])
                    row.set_expanded(True)
        self.refresh_custom(st)
        if prof in self.custom_chk:
            self.custom_chk[prof].set_active(True)
        else:
            self.rows[prof if prof in PRESETS else ("custom" if prof else "default")][1].set_active(True)
        self.loading = False

    def on_mode(self, chk, key):
        if self.loading or not chk.get_active():
            return
        if key == "default":   # a laptop on the other power source: the CPU values are not written (cpu_skipped says why)
            self.win.run([["default"]], lambda r: self.win.toast(
                _("Profile deselected; CPU values not written: %s") % r[0]["cpu_skipped"] if r[0].get("cpu_skipped")
                else _("Stock values applied")))
        elif key == "custom":
            self.win.toast(_("Set the values in the CPU, Curves and Fans pages and use \"Apply now\""))
        elif key in self.win.status.get("profile_lines", {}):
            self.win.run([["apply", key], ["use", key]], lambda _r: self.win.toast(_("Profile '%s' applied") % key))
        else:
            def ask(res):
                def go(ok):
                    if ok:
                        self.win.run([["preset", key], ["apply", key], ["use", key]], lambda _r: self.win.toast(_("Profile '%s' created and applied") % key))
                    else:
                        self.win.reload()
                self.win.confirm(_("Create the '%s' profile?") % key, _("Stock values → profile (green = more conservative, red = more aggressive):"),
                                 _("Create and apply"), go, extra=profile_view(res["lines"], self.win.status))
            bg(lambda: self.win.h.call("preset", key, "show"), ask, lambda m: (self.win.toast(m), self.win.reload()))

    def calibrate(self, mode, name=None, retry=0):
        """First the estimate (`autotune estimate`), then a simple choice: automatic with the siliconctl defaults, or the parameters by hand.
        name: a custom calibration from the base `mode`, saved under that name; retry: it ignores the crash of the reused measurement."""
        def ask(est):
            p = est["params"]
            target = _("target Tctl %d °C, ") % p["target"] if "target" in p else ""   # Boost: no thermal target
            if est.get("eco_from"):   # Eco: these CO values already passed a final pass, nothing to test
                auto = _("reuses the undervolt validated by the final pass of %s, without load tests: the profile is proposed right away.") % est["eco_from"]
            elif est.get("co_reuse"):   # limit search already done: only the final pass with this mode's margin
                auto = _("CO (Curve Optimizer) limit already measured on %s: reused (repeat the search from \"Choose the values…\"), %s — %smargin %d, %d s per test.") % (
                    est["co_reuse"], mins(est["parallel_total_s"]), target, p["margin"], p["step"])
            else:
                auto = _("all cores together, %s — %sCO (Curve Optimizer) down to %d with margin %d, %d s per test.") % (
                    mins(est["parallel_total_s"]), target, p["colimit"], p["margin"], p["step"])
            if p.get("retry"):
                auto += " " + _("The crash of the measurement is ignored: the final pass starts again from the last stable value + margin.")
            # the chosen level as the subtitle (as a value at the end of the row the dialog cut it down to "…");
            # use_subtitle before model/selected: set after them, libadwaita leaves the subtitle empty
            fans = Adw.ComboRow(title=_("Fans"), use_subtitle=True, model=Gtk.StringList.new(list(FAN_LEVELS)), selected=p.get("fans", 0),
                                tooltip_text=_("Also in automatic mode: how much the mode touches the fans (only the channels recognised as fans)"))
            # chosen at every start, also in automatic mode (the user's request): on by default
            single = Adw.SwitchRow(title=_("Single-core test in the final pass"), active=bool(p.get("single", 1)),
                                   subtitle=AT_SINGLE_SUB % mins(est.get("single_s")))
            lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
            lb.append(fans)
            lb.append(single)
            d = Adw.AlertDialog(heading=_("Custom calibration from %s → %s") % (mode.capitalize(), name) if name else
                                _("Calibrate the %s mode?") % mode.capitalize(),
                                body=_("Automatic (recommended): %s\n\n%s\n\n%s") % (auto, AT_WARNING, CO_TIP), extra_child=lb)
            d.add_response("cancel", _("Cancel"))
            d.add_response("custom", _("Choose the values…"))
            d.add_response("auto", _("Automatic (recommended)"))
            d.set_response_appearance("auto", Adw.ResponseAppearance.SUGGESTED)
            def resp(_d, r):
                if r == "auto":
                    AutotuneDialog(self.win, mode, name=name).start(dict(p, parallel=1, fans=fans.get_selected(), single=int(single.get_active())))
                elif r == "custom":
                    self.calibrate_params(mode, dict(est, params=dict(p, fans=fans.get_selected(), single=int(single.get_active()))), name)
            d.connect("response", resp)
            d.present(self.win)
        bg(lambda: self.win.h.call("autotune", "estimate", mode, *(["retry=1"] if retry else [])), ask, self.win.toast)

    def calibrate_params(self, mode, est, name=None):
        """Parameters (ranges from AT_PARAMS, defaults from siliconctl) with an estimate that follows the changes → autotune start → progress."""
        group = Adw.PreferencesGroup()
        spins = {}
        for key, title, unit, (lo, hi), sub in AT_PARAMS:
            if key not in est["params"]:   # e.g. Boost has no `target`
                continue
            r = Adw.SpinRow.new_with_range(lo, hi, 1)
            r.set_title(title + (" (%s)" % unit if unit else ""))
            r.set_subtitle(sub or "")
            r.set_value(est["params"][key])
            spins[key] = r
            group.add(r)
        parallel = Adw.SwitchRow(title=_("Test all cores together (fast, recommended)"), active=bool(est["params"].get("parallel", 1)))
        group.add(parallel)
        single = Adw.SwitchRow(title=_("Single-core test in the final pass"), active=bool(est["params"].get("single", 1)))
        group.add(single)
        fans = Adw.ComboRow(title=_("Fans"), use_subtitle=True, model=Gtk.StringList.new(list(FAN_LEVELS)), selected=est["params"].get("fans", 0))
        group.add(fans)
        repeat = Adw.SwitchRow(title=_("Repeat the CO limit search"), active=False, sensitive=bool(est.get("co_reuse")))
        group.add(repeat)
        estimate = label("", ["heading"], margin_top=6)
        params = lambda: dict(((k, int(r.get_value())) for k, r in spins.items()), parallel=int(parallel.get_active()),
                              single=int(single.get_active()), reuse=int(not repeat.get_active()), fans=fans.get_selected(),
                              retry=est["params"].get("retry", 0))
        def show_est(e):
            estimate.set_text(_("Estimated duration: %s") % mins(e["total_s"]) + (
                _(" (undervolt validated by the final pass of %s: no load test)") % e["eco_from"] if e.get("eco_from") else ""))
            parallel.set_subtitle(AT_PARALLEL_SUB % mins(e["sequential_total_s"]))
            single.set_subtitle(AT_SINGLE_SUB % mins(e.get("single_s")))
            repeat.set_subtitle(_("Off: reuses the measurement of %s; on: measures the limit again (longer)") % e["co_reuse"] if e.get("co_reuse")
                                else (_("full search") if repeat.get_active() else _("no usable previous measurement")))
        pending = {"timer": 0, "seq": 0}
        def refresh_est():
            pending["timer"] = 0
            pending["seq"] += 1
            seq = pending["seq"]
            def got(e):
                if seq == pending["seq"]:   # only the last requested estimate
                    show_est(e)
            argv = ["autotune", "estimate", mode] + ["%s=%d" % kv for kv in params().items()]
            bg(lambda: self.win.h.call(*argv), got, self.win.toast)
            return False
        def changed(*_a):   # debounce: one estimate after 400 ms of quiet
            if pending["timer"]:
                GLib.source_remove(pending["timer"])
            pending["timer"] = GLib.timeout_add(400, refresh_est)
        for r in spins.values():
            r.connect("notify::value", changed)
        for sw in (parallel, single, repeat):
            sw.connect("notify::active", changed)
        show_est(est)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.append(group)
        box.append(estimate)
        d = Adw.AlertDialog(heading=(_("%s calibration parameters") % mode.capitalize()) + (" → " + name if name else ""),
                            body=AT_WARNING, extra_child=box)
        d.spins, d.parallel, d.single, d.repeat, d.estimate = spins, parallel, single, repeat, estimate   # reachable from the driven tests
        d.params = params
        d.add_response("cancel", _("Cancel"))
        d.add_response("start", _("Start"))
        d.set_response_appearance("start", Adw.ResponseAppearance.DESTRUCTIVE)
        def resp(_d, r):
            if pending["timer"]:
                GLib.source_remove(pending["timer"])
                pending["timer"] = 0
            if r == "start":
                AutotuneDialog(self.win, mode, name=name).start(params())
        d.connect("response", resp)
        d.present(self.win)
        return d

    def verify(self, mode):
        """Long verification of the saved profile (`autotune verify`, CoreCycler-like iterations): the duration, then
        the calibration window with the progress and, at the end, the result and the proposal."""
        dur = Adw.ComboRow(title=_("Duration"), model=Gtk.StringList.new([t for _m, t in VERIFY_DURATIONS]), selected=1)
        lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
        lb.append(dur)
        d = Adw.AlertDialog(heading=_("Verify the %s profile?") % mode.capitalize(), body=VERIFY_TEXT, extra_child=lb)
        d.add_response("cancel", _("Cancel"))
        d.add_response("start", _("Start"))
        d.set_response_appearance("start", Adw.ResponseAppearance.DESTRUCTIVE)
        def resp(_d, r):
            if r == "start":
                AutotuneDialog(self.win, mode, verify=True).start({"minutes": VERIFY_DURATIONS[dur.get_selected()][0]})
        d.connect("response", resp)
        d.present(self.win)
        return d

    def calibrate_custom(self):
        """Custom calibration: the base mode (Boost only with unlock) and the name of the new profile, then the
        same dialog as the modes. The name never replaces a mode; an existing custom one is replaced at Save."""
        st = self.win.status
        bases = [m for m in CALIBRATED if m != "boost" or st.get("unlock")]
        base = Adw.ComboRow(title=_("Starting from"), model=Gtk.StringList.new([m.capitalize() for m in bases]),
                            selected=bases.index("auto") if "auto" in bases else 0)
        entry = Adw.EntryRow(title=_("Name of the new profile"))
        note = label("", ["dim-label", "caption"], wrap=True, margin_top=6)
        retry = Adw.SwitchRow(title=_("Retry from the last stable value, ignoring the crash"), active=False,
                              subtitle=_("When the reused measurement ended with a crash (or a final pass failed), the final pass "
                                         "normally starts 3 steps further away and skips what failed. On: from the last stable value + "
                                         "margin again; a freeze is possible (the watchdog resets the PC, the crash is recorded)."))
        lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
        lb.append(base)
        lb.append(entry)
        lb.append(retry)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(lb)
        box.append(note)
        taken = set(st.get("calibrated", {}))
        d = Adw.AlertDialog(heading=_("Custom calibration"), extra_child=box,
                            body=_("The result is saved as a new profile: Eco, Auto and Boost stay as they are, and a new "
                                   "search of the CO limit does not replace their measurement.") +
                            ("" if st.get("unlock") else "\n\n" + _("Boost as a base needs \"Allow beyond the stock values\" (Preferences).")))
        d.add_response("cancel", _("Cancel"))
        d.add_response("next", _("Continue…"))
        d.set_response_appearance("next", Adw.ResponseAppearance.SUGGESTED)

        def suggest(*_a):   # "<base>-custom", "-2", "-3"… the first name not taken
            b = bases[base.get_selected()]
            entry.set_text(next(n for n in ["%s-custom" % b] + ["%s-custom-%d" % (b, i) for i in range(2, 100)] if n not in taken))

        def check(*_a):
            name = entry.get_text()
            ok = bool(re.fullmatch(r"[a-z0-9_-]{1,32}", name)) and name not in PRESETS + ("baseline", "default", "custom")
            d.set_response_enabled("next", ok)
            note.set_text(_("Only a-z 0-9 - _, and not the name of a mode") if not ok
                          else _("'%s' exists: it is replaced when you save the result") % name if name in taken else "")
        base.connect("notify::selected", suggest)
        entry.connect("changed", check)
        suggest()
        d.base, d.entry, d.retry = base, entry, retry   # reachable from the smoke test

        def resp(_d, r):
            if r == "next":
                self.calibrate(bases[base.get_selected()], entry.get_text(), int(retry.get_active()))
        d.connect("response", resp)
        d.present(self.win)
        return d

    def delete_custom(self, name):
        active = self.win.status.get("profile") == name

        def go(ok):
            if ok:   # the active one: the stock values first, so nothing stays applied from a deleted profile
                self.win.run(([["default"]] if active else []) + [["profile", "delete", name]],
                             lambda _r: self.win.toast(_("Custom calibration '%s' deleted") % name))
        self.win.confirm(_("Delete '%s'?") % name, _("The profile of this custom calibration is deleted") +
                         (_("; it is the active mode: the stock values are applied") if active else "") + ".",
                         _("Delete"), go, destructive=True)

    def regen(self, key):
        def ask(res):
            def go(ok):
                if ok:
                    cmds = [["preset", key]] + ([["apply", key]] if self.win.status.get("profile") == key else [])
                    self.win.run(cmds, lambda _r: self.win.toast(_("Profile '%s' regenerated") % key))
            self.win.confirm(_("Regenerate '%s' from the stock values?") % key, _("The current profile is replaced by these values (green = more conservative, red = more aggressive):"),
                             _("Regenerate"), go, destructive=True, extra=profile_view(res["lines"], self.win.status))
        bg(lambda: self.win.h.call("preset", key, "show"), ask, self.win.toast)


class PrefsPage(Adw.PreferencesPage):
    NAME, TITLE, ICON = "preferences", _("Preferences"), "emblem-system-symbolic"

    def __init__(self, win):
        super().__init__()
        self.win = win
        self.loading = False
        self.autostart = Adw.SwitchRow(title=_("Apply at startup"), subtitle=_("Re-applies the selected profile at boot and on resume"))
        self.autostart.connect("notify::active", self.on_autostart)
        self.login = Adw.SwitchRow(title=_("Start Silicon Control at login"), active=os.path.exists(LOGIN_DESKTOP),
                                   subtitle=_("Opens the window at every login, or only the tray icon with \"Start minimized\" (the password is "
                                              "asked at the first use, unless \"Stop asking for the password\" is on). After a crash it shows the "
                                              "warning and leaves the profile deactivated: it never re-applies anything on its own"))
        self.login.connect("notify::active", self.on_login)
        self.tray = Adw.SwitchRow(title=_("Icon in the system tray"), active=bool(self.win.ui.get("tray")),
                                  subtitle=_("Modes and Apply at startup from the tray; closing the window keeps the icon. "
                                             "KDE Plasma; on GNOME it needs the AppIndicator extension"))
        self.tray.connect("notify::active", self.on_tray)
        # the user's choice for the login: only the icon (no password until it is used) or the window as well
        self.minimized = Adw.SwitchRow(title=_("Start minimized to the tray icon"), active=self.win.ui.get("tray_minimized", True),
                                       sensitive=self.tray.get_active(),
                                       subtitle=_("At login only the icon starts, no password until you use it; off: the window "
                                                  "opens too"))
        self.minimized.connect("notify::active", self.on_minimized)
        self.trust = Adw.SwitchRow(title=_("Stop asking for the password"),
                                   subtitle=_("Polkit rule for your user, only for Silicon Control in the local session: "
                                              "the password is needed once to write it, then never again"))
        self.trust.connect("notify::active", self.on_trust)
        self.unlock = Adw.SwitchRow(title=_("Allow beyond the stock values"), subtitle=_("PPT/TDC/EDC up to the unlock ceilings, FMax above the baseline"))
        self.unlock.connect("notify::active", self.on_unlock)
        hw = Adw.ActionRow(title=_("Hardware check"), subtitle=_("Writes and reads back one value per command, then restores the baseline"))
        self.hw_spin = Gtk.Spinner(valign=Gtk.Align.CENTER)
        self.hw_btn = button(_("Run"), self.hwtest)
        hw.add_suffix(self.hw_spin)
        hw.add_suffix(self.hw_btn)
        for title, items in ((_("Startup"), (self.autostart, self.login, self.tray, self.minimized, self.trust)), (_("Limits and checks"), (self.unlock, hw))):
            g = Adw.PreferencesGroup(title=title)
            for r in items:
                g.add(r)
            self.add(g)

    def refresh(self, st):
        self.loading = True
        self.autostart.set_active(bool(st.get("autostart")))
        self.unlock.set_active(bool(st.get("unlock")))
        self.trust.set_active(bool(st.get("trusted")))
        self.loading = False

    def on_autostart(self, row, _p):
        if not self.loading:
            self.win.run([["autostart", "on" if row.get_active() else "off"]])

    def on_login(self, row, _p):
        """The user's XDG autostart (~/.config/autostart): no privilege; the window at login, or only the tray icon."""
        try:
            if row.get_active():
                os.makedirs(os.path.dirname(LOGIN_DESKTOP), exist_ok=True)
                with open(LOGIN_DESKTOP, "w") as f:
                    f.write("[Desktop Entry]\nType=Application\nName=Silicon Control\nExec=silicon-control%s\nIcon=%s\n"
                            "Terminal=false\nX-GNOME-Autostart-enabled=true\n" % (" --tray" if self.tray.get_active() and self.minimized.get_active() else "", APP_ID))
            elif os.path.exists(LOGIN_DESKTOP):
                os.remove(LOGIN_DESKTOP)
        except OSError as e:
            self.win.toast(str(e))

    def on_tray(self, row, _p):
        self.win.ui["tray"] = row.get_active()
        ui_save(self.win.ui)
        try:
            self.win.get_application().set_tray(row.get_active())
        except GLib.Error as e:
            self.win.toast(str(e))
        self.minimized.set_sensitive(row.get_active())
        if self.login.get_active():   # the login entry follows: only the icon, or the window
            self.on_login(self.login, None)

    def on_minimized(self, row, _p):
        self.win.ui["tray_minimized"] = row.get_active()
        ui_save(self.win.ui)
        if self.login.get_active():
            self.on_login(self.login, None)

    def on_unlock(self, row, _p):
        if self.loading:
            return
        if not row.get_active():
            self.win.run([["unlock", "off"]], lambda res: self.win.toast(str(res[0])))
            return
        def go(ok):
            if ok:
                self.win.run([["unlock", "on"]], lambda res: self.win.toast(str(res[0])))
            else:
                self.win.reload()   # puts the switch back to the real state
        self.win.confirm(_("Beyond the stock values?"), UNLOCK_WARNING, _("Unlock"), go, destructive=True)

    def on_trust(self, row, _p):
        if self.loading:
            return
        if not row.get_active():
            self.win.run([["trust", "off"]], lambda res: self.win.toast(_("Password asked again at every start")))
            return
        def go(ok):
            if ok:
                self.win.run([["trust", "on"]], lambda res: self.win.toast(_("Done: from the next start no password for %s") % res[0]["user"]))
            else:
                self.win.reload()   # puts the switch back to the real state
        self.win.confirm(_("Stop asking for the password?"), TRUST_WARNING, _("Remember"), go)

    def hwtest(self):
        self.hw_btn.set_sensitive(False)
        self.hw_spin.start()
        def done(res):
            self.hw_spin.stop()
            self.hw_btn.set_sensitive(True)
            self.win.info(_("Hardware check: ") + res.get("esito", "?"), "\n".join("%s: %s" % kv for kv in res.items()))
            self.win.reload()
        def fail(msg):
            self.hw_spin.stop()
            self.hw_btn.set_sensitive(True)
            self.win.toast(msg)
        bg(lambda: self.win.h.call("hwtest"), done, fail)


class CpuPage(Page):
    NAME, TITLE, ICON = "cpu", _("CPU"), "preferences-system-symbolic"

    def __init__(self, win):
        super().__init__(win, CPU_HELP)
        self.params = {}
        self.read_power = None
        for key, title, unit in CPU_PARAMS:
            p = self.params[key] = Param(title, unit, tooltip=PARAM_HELP[key])
            self.body.append(p)
        row = Gtk.Box(spacing=12)
        row.append(label(_("Power mode"), ["heading"], width_chars=9))
        self.power = Gtk.DropDown(model=Gtk.StringList.new(list(POWER)), valign=Gtk.Align.CENTER)
        row.append(self.power)
        row.append(label(_("system power profile (power-profiles-daemon / EPP)"), ["dim-label"]))
        self.body.append(row)
        self.boost_row = Gtk.Box(spacing=12)
        self.boost_row.append(label(_("Boost"), ["heading"], width_chars=9))
        self.boost = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.boost_row.append(self.boost)
        self.boost_row.append(label(_("Precision Boost (kernel switch): off keeps the clock at the base frequency, the frequency "
                                      "lever of CPUs without FMax"), ["dim-label"], wrap=True))
        self.body.append(self.boost_row)
        self.read_boost = None
        self.nocaps = label(_("Baseline of this boot missing: no CPU write possible (siliconctl.service did not capture it, see `siliconctl status`)."),
                            ["warning"], wrap=True, visible=False)
        self.body.append(self.nocaps)
        self.buttons()

    def refresh(self, st):
        caps = st.get("caps")
        self.nocaps.set_visible(not caps)
        self.bar.set_sensitive(bool(caps))
        if not caps:
            return
        values = dict(st["limits"])
        values["fmax"] = st["fmax"]
        base = st.get("baseline") or {}
        for key, _t, _u in CPU_PARAMS:
            p, v = self.params[key], values.get(key)
            p.set_visible(v is not None and key in caps)
            if p.get_visible():
                p.setup(caps[key][0], caps[key][1], int(round(v)), base.get(key))
        self.read_power = st.get("power")
        self.power.set_sensitive(self.read_power in POWER)
        if self.read_power in POWER:
            self.power.set_selected(POWER.index(self.read_power))
        self.read_boost = st.get("boost")
        self.boost_row.set_visible(self.read_boost is not None)
        self.boost.set_active(self.read_boost == "on")

    def reset(self):
        for p in self.params.values():
            p.reset()
        if self.read_power in POWER:
            self.power.set_selected(POWER.index(self.read_power))
        self.boost.set_active(self.read_boost == "on")

    def lines(self, only_changed):
        out = ["%s %d" % (key, p.value()) for key, p in self.params.items() if p.get_visible() and (not only_changed or p.changed())]
        pw = POWER[self.power.get_selected()]
        if self.power.get_sensitive() and (not only_changed or pw != self.read_power):
            out.append("power " + pw)
        b = "on" if self.boost.get_active() else "off"
        if self.read_boost and (not only_changed or b != self.read_boost):
            out.append("boost " + b)
        return out


class CurvePage(Page):
    NAME, TITLE, ICON = "curve", _("Curves"), "view-list-symbolic"

    def __init__(self, win):
        super().__init__(win, CO_HELP)
        self.loading = False
        self.missing = label("", ["warning"], wrap=True, visible=False)   # why the CO cannot be used on this CPU
        self.body.append(self.missing)
        self.all = Param(_("All"), "", tooltip=CO_TIP)
        self.all.adj.connect("value-changed", self.on_all)
        self.body.append(self.all)
        self.body.append(Gtk.Separator())
        self.cores = []   # one row per active core, built by refresh
        self.buttons()

    def refresh(self, st):
        if len(self.cores) != st.get("cores", 0):
            for p in self.cores:
                self.body.remove(p)
            self.cores = [Param(_("Core %d") % c, "", info=True, tooltip=PARAM_HELP["co"]) for c in range(st.get("cores", 0))]
            for p in self.cores:
                self.body.append(p)
        caps = st.get("caps")
        why = st.get("co_unavailable") if st.get("co") is None else None
        self.missing.set_text(_("Curve Optimizer not available on this CPU: %s") % why if why else "")
        self.missing.set_visible(bool(why))
        for w in [self.all, self.bar] + self.cores:
            w.set_sensitive(bool(caps) and not why)
        if not caps or why:
            return
        self.loading = True
        lo, hi = caps["co"]
        base = (st.get("baseline") or {}).get("co")
        for c, p in enumerate(self.cores):
            p.setup(lo, hi, st["co"][c], base[c] if base else None)
        self.all.setup(lo, hi, st["co"][0])
        self.loading = False

    def telemetry(self, t):
        for c, p in enumerate(self.cores):
            d = t["cores"][c] if c < len(t["cores"]) else {}
            parts = [num(d["mhz"] / 1000.0, 2) + " GHz" if d.get("mhz") is not None else _("n/a")]
            if d.get("temp") is not None:
                parts.append("%g °C" % d["temp"])
            if d.get("volt") is not None:
                parts.append(volts(d["volt"]))
            p.info.set_text(" · ".join(parts))

    def on_all(self, adj):
        if not self.loading:
            for p in self.cores:
                p.adj.set_value(adj.get_value())

    def reset(self):
        for p in self.cores:
            p.reset()

    def lines(self, only_changed):
        if only_changed:
            return ["co %d %d" % (c, p.value()) for c, p in enumerate(self.cores) if p.changed()]
        return ["co " + " ".join(str(p.value()) for p in self.cores)]


class FansPage(Page):
    NAME, TITLE, ICON = "fans", _("Fans"), "weather-windy-symbolic"

    def __init__(self, win):
        super().__init__(win, _("The fans stay managed by the BIOS SmartFan: here you only change the rise/fall times and the curve "
                               "points of the channels recognised as fans. Pumps and non-controllable channels are protected."))
        self.chans = {}     # n -> (up, down, editor, info) of the "fan" channels
        self.pumps = {}     # n -> (fixed-speed switch, Param %, info) of the "pump" channels
        self.cards = []
        self.unknown_cards = []   # cards of the "unknown" channels: in a collapsible section at the end of the page
        self.missing = card()
        self.missing.append(label(_("Fans not available"), ["heading"]))
        self.missing_text = label("", ["dim-label"], wrap=True)
        self.missing.append(self.missing_text)
        self.missing.append(button(_("Enable (loads the nct6775 module)"), lambda: self.win.run([["fan", "enable"]], self.enabled), "suggested-action"))
        self.body.append(self.missing)
        self.known = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)   # cards of the other channels
        self.body.append(self.known)
        # collapsing only hides the cards, never rebuilds them: values being edited are kept; the state
        # (key of the former "show" switch, now meaning expanded) is remembered and followed by the Monitor fan line
        self.unknown_title = label("", ["heading"])
        self.unknown_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12)
        self.unknown = Gtk.Expander(label_widget=self.unknown_title, child=self.unknown_box, visible=False,
                                    expanded=bool(win.ui.get("show_unknown_fans")))
        self.unknown.connect("notify::expanded", self.on_unknown)
        self.body.append(self.unknown)
        self.spin = Gtk.Spinner(valign=Gtk.Align.CENTER)
        self.detect_btn = button(_("Detect roles"), self.autodetect)
        self.buttons(self.spin, self.detect_btn)

    def refresh(self, st):
        self.step_range = st.get("caps", {}).get("fan_step_ms") if st.get("caps") else None
        if st.get("fans"):
            self.show(st["fans"])
        else:
            self.show_missing(st.get("fans_error", _("fan status not available")))

    def show_missing(self, msg):
        self.missing_text.set_text(msg + "\n\n" + FAN_MISSING_HELP)
        self.missing.set_visible(True)
        self.unknown.set_visible(False)
        self.bar.set_sensitive(False)
        self.clear()

    def enabled(self, res):
        r = res[0] or {}
        self.win.toast(_("Reboot required: acpi_enforce_resources=lax added to the kernel command line") if r.get("riavvio_necessario")
                       else _("Chip %s available") % r.get("chip", "?"))

    def clear(self):
        for c in self.cards:
            c.get_parent().remove(c)
        self.cards, self.chans, self.pumps, self.unknown_cards = [], {}, {}, []

    def on_unknown(self, exp, _p):
        self.win.ui["show_unknown_fans"] = exp.get_expanded()
        try:
            ui_save(self.win.ui)
        except OSError as e:
            self.win.toast(str(e))

    def show(self, fs):
        self.missing.set_visible(False)
        self.bar.set_sensitive(True)
        self.clear()
        for c in fs["canali"]:
            n, role, why = c["canale"], c.get("role", "sconosciuto"), c.get("why", "")
            box = card()
            head = Gtk.Box(spacing=12)
            name = Gtk.Entry(text=c.get("name") or "", placeholder_text=_("Channel %d") % n, width_chars=14, valign=Gtk.Align.CENTER)
            name.connect("activate", lambda e, n=n: self.win.run([["fan", "name", str(n)] + e.get_text().split()]))
            head.append(label("%d" % n, ["title-3"]))
            head.append(name)
            chip = label(ROLE_NAMES.get(role, role), ["chip", ROLE_CSS.get(role, "dim-label")], valign=Gtk.Align.CENTER)
            head.append(chip)
            head.append(label(_("%d rpm · pwm %d (%d %%) · mode %d%s") % (c["rpm"], c["pwm"], pwm_pct(c["pwm"]), c["modo"],
                                                                      _(" · %d rpm at 100 %%") % c["rpm_max"] if c.get("rpm_max") else ""), ["numeric"], hexpand=True))
            head.append(button(_("Identify"), lambda n=n: self.identify(n)))
            for target in ("pompa", "sconosciuto"):
                if role != target:
                    head.append(button(_("Mark as %s") % ROLE_NAMES[target], lambda n=n, t=target: self.win.run([["fan", "role", str(n), t]])))
            box.append(head)
            box.append(label(why or _("role not detected: use \"Detect roles\" (name: Enter to save)"), ["dim-label", "caption"]))
            if role == "ventola" and self.step_range:
                up = Param(_("Rise"), "s", digits=1, step=0.5, tooltip=_("Time between one PWM step and the next when the temperature rises: high = the fan ignores short peaks"))
                down = Param(_("Fall"), "s", digits=1, step=0.5, tooltip=_("Time between one PWM step and the next when the temperature falls"))
                up.setup(self.step_range[0] / 1000.0, self.step_range[1] / 1000.0, c["step_up_ms"] / 1000.0)
                down.setup(self.step_range[0] / 1000.0, self.step_range[1] / 1000.0, c["step_down_ms"] / 1000.0)
                editor = CurveEditor(curve_points(c["curva"]), len(c["curva"]), c.get("rpm_max"))
                for prm in (up, down):
                    prm.adj.connect("value-changed", lambda *_a, u=up, d=down, e=editor: e.set_reaction(u.value(), d.value()))
                editor.set_reaction(up.value(), down.value())
                for w in (up, down, editor):
                    box.append(w)
                self.chans[n] = (up, down, editor, c)
            elif role == "pompa":
                kind, pct = pump_mode(c)
                box.append(label(_("Normally the pump should be left to the BIOS (recommended). If at full load it rises to 100 % and hums, it can be limited: "
                                   "\"Maximum cap\" keeps the BIOS curve clipping the points above the cap, \"Fixed speed\" keeps it constant. "
                                   "Never below 50 %: the flow is not enough."), ["dim-label", "caption"], wrap=True))
                mode = Adw.ComboRow(title=_("Pump"), model=Gtk.StringList.new(list(PUMP_MODES)), selected=PUMP_KINDS.index(kind))
                lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
                lb.append(mode)
                box.append(lb)
                speed = Param(_("Pump"), "%", info=bool(c.get("rpm_max")), tooltip=_("Cap or fixed speed of the pump (50–100 %)"))
                speed.setup(50, 100, pct if pct is not None else 100)   # range 50–100 % (siliconctl rejects the rest)
                speed.set_sensitive(kind != "auto")
                mode.connect("notify::selected", lambda r, _p, sp=speed: sp.set_sensitive(r.get_selected() != 0))
                if c.get("rpm_max"):   # ponytail: linear rpm estimate = rpm_max × %
                    show_rpm = lambda *_a, sp=speed, rm=c["rpm_max"]: sp.info.set_text(_("≈ %d rpm") % (rm * sp.adj.get_value() / 100.0))
                    speed.adj.connect("value-changed", show_rpm)
                    show_rpm()
                box.append(speed)
                self.pumps[n] = (mode, speed, c)
            elif role == "sconosciuto":
                self.unknown_cards.append(box)
            (self.unknown_box if role == "sconosciuto" else self.known).append(box)
            self.cards.append(box)
        self.unknown_title.set_text(_("Unknown channels (%d)") % len(self.unknown_cards))
        self.unknown.set_visible(bool(self.unknown_cards))

    def identify(self, n):
        self.win.toast(_("Channel %d at 100 %% for 5 seconds…") % n)
        bg(lambda: self.win.h.call("fan", "identify", str(n)),
           lambda r: self.win.toast(_("Channel %d: %d rpm at 100 %%") % (n, r["rpm_al_100"])), self.win.toast)

    def autodetect(self):
        def go(ok):
            if not ok:
                return
            self.detect_btn.set_sensitive(False)
            self.spin.start()
            def done(res):
                self.spin.stop()
                self.detect_btn.set_sensitive(True)
                self.win.info(_("Detected roles"), "\n".join(_("channel %s: %s (%s)") % (n, ROLE_NAMES.get(r["ruolo"], r["ruolo"]), r["perché"]) for n, r in res.items()))
                self.win.reload()
            def fail(msg):
                self.spin.stop()
                self.detect_btn.set_sensitive(True)
                self.win.toast(msg)
            bg(lambda: self.win.h.call("fan", "autodetect"), done, fail)
        self.win.confirm(_("Detect the channel roles?"), AUTODETECT_WARNING, _("Start"), go)

    def reset(self):
        for up, down, editor, c in self.chans.values():
            up.reset()
            down.reset()
            editor.reset()
        for mode, speed, c in self.pumps.values():
            mode.set_selected(PUMP_KINDS.index(pump_mode(c)[0]))
            speed.reset()

    def lines(self, only_changed):
        out = []
        for n, (up, down, editor, c) in sorted(self.chans.items()):
            ms = (int(round(up.value() * 1000)), int(round(down.value() * 1000)))
            if not only_changed or ms != (c["step_up_ms"], c["step_down_ms"]):
                out.append("fan %d step %d %d" % (n, ms[0], ms[1]))
            pts = editor.points()
            if not only_changed or pts != editor.read:
                out.append("fan %d curve %s" % (n, " ".join("%d:%d" % pt for pt in pts)))
        for n, (mode, speed, c) in sorted(self.pumps.items()):
            kind = PUMP_KINDS[mode.get_selected()]
            if only_changed and kind == pump_mode(c)[0] and (kind == "auto" or not speed.changed()):
                continue
            out.append("fan %d pump %s" % (n, {"auto": "auto", "max": "max %d" % speed.value(), "fixed": "%d" % speed.value()}[kind]))
        return out


