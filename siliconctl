                "granite12": {"codename": 23, "cores": 12, "ccds": 2, "pm_version": 0x620205,   # 9900X: 2 CCDs × 6
                              "disabled": [[2, 5], [0, 7]]},   # disabled slots of each CCD (core fuses)
                "fusebad": {"codename": 23, "cores": 12, "ccds": 2, "pm_version": 0x620205,    # fuses that contradict
                            "disabled": [[2], [0, 7]]},   # the topology (7 + 6 slots for 6 + 6 cores): no per-core CO
                "raphael": {"codename": 20, "cores": 8, "ccds": 1, "pm_version": 0x540104},     # 7700X
                "vermeer": {"codename": 12, "cores": 12, "ccds": 2, "pm_version": 0x380805,    # 5900X: 2 CCDs × 6
                            "disabled": [[1, 6], [0, 3]]},
                "vermeer8": {"codename": 12, "cores": 8, "ccds": 1, "pm_version": 0x380905,    # 5800X sitting on the
                             "phys": [1]},                                                 # second CCD of the package
                "matisse": {"codename": 4, "cores": 8, "ccds": 1, "pm_version": 0x240903},     # 3700X: no CO, no FMax
                "pinnacle": {"codename": 10, "cores": 8, "ccds": 1, "pm_version": 0},          # 2700X: no SMU command
                "cezanne": {"codename": 14, "cores": 8, "ccds": 1, "pm_version": 0x400005},    # 5700G: APU, no CO
                "phoenix": {"codename": 21, "cores": 8, "ccds": 1, "pm_version": 0x4C0006},    # 8700G
                "generic": {"codename": None, "cores": 8, "ccds": 1, "pm_version": 0},         # no ryzen_smu: GENERIC
                # Intel (no ryzen_smu): (model, microcode, laptop, PL1 W, its max_power, PL2 W, its max_power)
                "intel": {"codename": None, "cores": 8, "ccds": 1, "pm_version": 0,            # Alder Lake S desktop
                          "intel": (0x97, "0x3a", False, 125, 125, 200, 241)},
                "intel-raptor": {"codename": None, "cores": 8, "ccds": 1, "pm_version": 0,     # Raptor Lake S, microcode
                                 "intel": (0xB7, "0x129", False, 125, 125, 188, 253)},         # without the 0x12B fixes
                "intel-laptop": {"codename": None, "cores": 8, "ccds": 1, "pm_version": 0,     # Alder Lake P: battery,
                                 "intel": (0x9A, "0x430", True, 28, 28, 64, 64)}}              # PPCC, thermald
    FAN_DIR = HWMON + "/hwmon0"

    def __init__(self, variant=None):
        v = self.VARIANTS[variant or os.environ.get("SILICONCTL_FAKE_FAMILY") or "granite"]
        per = v["cores"] // v["ccds"]
        self.cids = [(c // per) * 8 + c % per for c in range(v["cores"])]   # sysfs core_id: CCD n starts at 8n
        self.disabled = v.get("disabled", [[] for _ccd in range(v["ccds"])])
        self.phys = v.get("phys", list(range(v["ccds"])))   # physical position of each CCD in the package
        # physical (ccd, slot) of each core: the firmware skips the disabled slots, Linux numbers the rest in order
        self.slots = [(p, s) for p, dis in zip(self.phys, self.disabled) for s in range(8) if s not in dis]
        self.default = {"codename": v["codename"], "co": [0] * v["cores"], "fmax": 5225,
                        "ppt": 162.0, "tdc": 120.0, "edc": 180.0, "thm": 95.0,
                        "shaper": [0x80 | t for t in range(5)], "tctl": 52.0, "power": "performance",
                        "pm_version": v["pm_version"], "drop": 0, "log": [], "tctl_base": 52.0, "cmdline": "quiet",
                        # simulated fans: 1 radiator fan, 2 AIO pump, 3 3-pin fan (does not respond to the PWM)
                        "fans": {"1": {"kind": "fan", "rpm": 1200}, "2": {"kind": "pump", "rpm": 2800},
                                 "3": {"kind": "uncontrollable", "rpm": 900}},
                        # simulated autotune: below these CO values the core is unstable; boot_id changes at each reboot()
                        "co_limits": {"7": -15, "3": -25}, "boot_id": "boot-1",
                        "thermald": bool(v.get("intel") and v["intel"][2])}   # an Intel laptop: thermald runs
        self.path = P("/fake_smu.json")
        self.s = json.loads(open(self.path).read() if os.path.exists(self.path) else json.dumps(self.default))
        if not os.path.exists(P(self.FAN_DIR + "/name")):
            self._make_hwmon()
        if not os.path.exists(P("/sys/devices/system/cpu/cpu0")):
            for c, cid in enumerate(self.cids):   # both SMT threads: cpuN and cpuN+cores
                for cpu in (c, c + len(self.cids)):
                    d = P("/sys/devices/system/cpu/cpu%d/topology" % cpu)
                    os.makedirs(d, exist_ok=True)
                    with open(d + "/core_id", "w") as fh:
                        fh.write(str(cid))
            os.makedirs(P(CPUFREQ), exist_ok=True)
            if not v.get("intel"):
                with open(P(CPUFREQ + "/boost"), "w") as fh:   # the kernel's boost switch (acpi-cpufreq style)
                    fh.write("1")
            for cpu in range(2 * len(self.cids)):   # one cpufreq policy per CPU, as amd-pstate on the 9800X3D
                d = P(CPUFREQ + "/policy%d" % cpu)
                os.makedirs(d)
                for name, khz in (("cpuinfo_min_freq", 603379), ("cpuinfo_max_freq", 5271622),
                                  ("scaling_min_freq", 603379), ("scaling_max_freq", 5271622)):
                    with open("%s/%s" % (d, name), "w") as fh:
                        fh.write(str(khz))
            os.makedirs(P("/proc"), exist_ok=True)
            with open(P("/proc/cpuinfo"), "w") as fh:
                fh.write("processor\t: 0\nmodel name\t: Fake CPU 8-Core Processor\n" if not v.get("intel") else
                         "processor\t: 0\nvendor_id\t: GenuineIntel\ncpu family\t: 6\nmodel\t\t: %d\n"
                         "model name\t: Fake Intel CPU\nmicrocode\t: %s\n" % v["intel"][:2])
            if v.get("intel"):
                self._make_intel(*v["intel"][2:])

    def _make_intel(self, laptop, pl1, pl1_max, pl2, pl2_max):
        """The Intel kernel interfaces: both powercap zones (MSR and its MMIO mirror), coretemp with TjMax 100 °C, the
        processor thermal device's TCC offset, intel_pstate's no_turbo; a laptop adds a battery, the OEM's PPCC
        range and a running thermald."""
        files = {NO_TURBO: 0, HWMON + "/hwmon1/name": "coretemp", HWMON + "/hwmon1/temp1_label": "Package id 0",
                 HWMON + "/hwmon1/temp1_input": 52000, HWMON + "/hwmon1/temp1_crit": 100000,
                 "/sys/bus/pci/devices/0000:00:04.0/tcc_offset_degree_celsius": 0}
        for zone in RAPL_ZONES:
            files.update({zone + "/name": "package-0", zone + "/enabled": 1, zone + "/constraint_2_name": "peak_power"})
            for n, (name, w, top) in enumerate((("long_term", pl1, pl1_max), ("short_term", pl2, pl2_max))):
                files.update({"%s/constraint_%d_name" % (zone, n): name, "%s/constraint_%d_power_limit_uw" % (zone, n): w * 10 ** 6,
                              "%s/constraint_%d_max_power_uw" % (zone, n): top * 10 ** 6})
        if laptop:
            files.update({"/sys/class/power_supply/BAT0/type": "Battery", "/sys/class/power_supply/ADP1/type": "Mains",
                          "/sys/class/power_supply/ADP1/online": 1, PPCC + "/power_limit_0_min_uw": 15 * 10 ** 6})
        for path, value in files.items():
            os.makedirs(os.path.dirname(P(path)), exist_ok=True)
            with open(P(path), "w") as fh:
                fh.write("%s\n" % value)

    def sysfs_check(self, path):
        """The kernel's error for an attribute the test locked (`locked`: {path: errno})."""
        err = self.s.get("locked", {}).get(path)
        if err:
            raise OSError(err, os.strerror(err))

    def core(self, mask):
        """Core index addressed by an SMU core mask, or None: a wrong mask (8 << 20 on two CCDs, the slot
        of a disabled core) is answered OK by a real SMU and does nothing."""
        ccd, ccx, slot = (mask >> 28) & 0xF, (mask >> 24) & 0xF, (mask >> 20) & 0xF
        return self.slots.index((ccd, slot)) if ccx == 0 and (ccd, slot) in self.slots else None

    def smn(self, addr):
        """The CCD and core fuse registers of the family (ZenStates-Core layout)."""
        fz = FAMILIES[self.s["codename"]]["fuses"]
        if addr in fz["ccd"]:
            if fz.get("map_from_down"):   # Zen 3: CCD0/1 down in bits 31:30, CCDs 2–7 down in the second word
                down = sum(1 << c for c in range(8) if c not in self.phys)
                return ((down & 3) << 30) | (1 << 22) if addr == fz["ccd"][0] else down >> 2
            return sum(1 << p for p in self.phys) << 22 if addr == fz["ccd"][0] else 0   # Zen 4/5: present, none down
        ccd = (addr - fz["core"]) // fz["stride"]
        return sum(1 << s for s in self.disabled[self.phys.index(ccd)]) if ccd in self.phys else 0xFFFFFFFF

    def _make_hwmon(self):
        d = P(self.FAN_DIR)
        os.makedirs(d, exist_ok=True)
        files = {"name": "nct6798"}
        for n, f in self.s["fans"].items():
            files.update({"fan%s_input" % n: f["rpm"], "pwm%s" % n: 153, "pwm%s_enable" % n: 5,
                          "pwm%s_step_up_time" % n: 400, "pwm%s_step_down_time" % n: 400})
            for k, (t, pw) in enumerate(((40, 77), (50, 110), (60, 150), (70, 200), (80, 255)), 1):
                files["pwm%s_auto_point%d_temp" % (n, k)] = t * 1000
                files["pwm%s_auto_point%d_pwm" % (n, k)] = pw
        for name, v in files.items():
            with open("%s/%s" % (d, name), "w") as fh:
                fh.write(str(v))

    def after_fan_write(self, path, value):
        """Fake physics: in manual mode the fan follows the PWM and warms little, the slowed-down
        pump raises Tctl by 5 °C, the 3-pin channel ignores the PWM."""
        if re.search(r"/pwm\d+_step_(up|down)_time$", path) and value < FAN_STEP_MIN_MS:   # like nct6775: minimum register 1
            with open(P(path), "w") as f:
                f.write(str(FAN_STEP_MIN_MS))
            return
        m = re.search(r"/pwm(\d+)(_enable)?$", path)
        if not m:
            return
        n = m.group(1)
        kind = self.s["fans"][n]["kind"]
        d = P(self.FAN_DIR)
        enable = int(open("%s/pwm%s_enable" % (d, n)).read())
        pwm = int(open("%s/pwm%s" % (d, n)).read())
        rpm, tctl_now = self.s["fans"][n]["rpm"], self.s["tctl_base"]
        if enable == 1 and kind == "fan":
            rpm, tctl_now = int(1500 * pwm / 255), self.s["tctl_base"] + (0.3 if pwm < 200 else 0)
        elif enable == 1 and kind == "pump":
            rpm, tctl_now = 1500 + int(1300 * pwm / 255), self.s["tctl_base"] + (5.0 if pwm < 200 else 0)
        with open("%s/fan%s_input" % (d, n), "w") as fh:
            fh.write(str(rpm))
        self.s["tctl"] = tctl_now
        self.save()

    def save(self):
        write_atomic(self.path, json.dumps(self.s))

    def _write(self, apply):
        self.s["log"].append({"dirty": os.path.exists(P(STATE + "/dirty")),
                              "active": os.path.exists(P(STATE + "/active"))})
        if self.s["drop"] > 0:
            self.s["drop"] -= 1
        else:
            apply()
        self.save()

    def smu(self, mailbox, cmd, args):
        a = args[0] if args else 0
        s = self.s
        name = {v: k for k, v in FAMILIES[s["codename"]]["cmd"].items()}.get((mailbox, cmd))   # by this family's IDs
        if name == "co_set":
            c = self.core(a)
            self._write(lambda: c is not None and s["co"].__setitem__(c, s16(a)))
        elif name in ("ppt_set", "tdc_set", "edc_set", "fast_set", "slow_set"):
            self._write(lambda: s.__setitem__(name[:-4], a / 1000.0))
        elif name == "co_get":
            c = self.core(a)
            return 1, [(s["co"][c] if c is not None else 0) & 0xFFFFFFFF, 0, 0, 0, 0, 0]
        elif name == "fmax_set":
            self._write(lambda: s.__setitem__("fmax", a & 0xFFFFF))
        elif name == "fmax_get":
            return 1, [s["fmax"], 0, 0, 0, 0, 0]
        elif name == "tjmax_set":
            self._write(lambda: s.__setitem__("thm", float(a)))
        elif name == "shaper_set":
            self._write(lambda: s["shaper"].__setitem__(a & 0x7F, a))
        elif name == "shaper_get":
            return 1, list(s["shaper"]) + [0]
        else:
            return 0xFE, [0] * 6
        return 1, [0] * 6

    def load_ok(self, args):
        """Simulated load: fails if a tested core is below its stability threshold;
        with `combined_stricter` the load on all cores needs 3 more steps of margin; one thread alone on a
        core (`--cpu 1`) also needs its `single_limits` (CoreCycler: what only a lone thread at full boost shows)."""
        limit = lambda key, c: self.s.get(key, {}).get(str(c), -100)
        if "--taskset" in args:
            c = int(args[args.index("--taskset") + 1].split(",")[0])
            alone = "--cpu" in args and args[args.index("--cpu") + 1] == "1"
            return self.s["co"][c] >= max(limit("co_limits", c), limit("single_limits", c) if alone else -100)
        extra = self.s.get("combined_stricter", 0)
        return all(self.s["co"][c] >= limit("co_limits", c) + extra for c in range(CORES))

    # Simulated hardware watchdog (an SP5100 TCO with timeout 60) and systemd's RuntimeWatchdogUSec driving it:
    # sysfs attributes as regular files under ROOT. sd_absent: a systemd without the property.
    WD_SYS = "/sys/class/watchdog/watchdog0"

    def wd_files(self):
        if not os.path.exists(P(self.WD_SYS + "/state")):
            os.makedirs(P(self.WD_SYS), exist_ok=True)
            for name, v in (("identity", "SP5100 TCO timer"), ("state", "inactive"), ("timeout", "60"), ("nowayout", "0")):
                with open(P(self.WD_SYS + "/" + name), "w") as fh:
                    fh.write(v + "\n")

    def sd_watchdog(self, usec=None):
        """PID 1: a value other than 0 opens the device (active), 0 stops it with the magic close."""
        if self.s.get("sd_absent"):
            return None
        if usec is not None:
            self.s["sd_wd"] = usec
            self.save()
            with open(P(self.WD_SYS + "/state"), "w") as fh:
                fh.write(("active" if usec else "inactive") + "\n")
        return self.s.get("sd_wd", 0)

    def bench(self, threads):
        """Simulated (bogo-ops/s, W): multi-thread saturates with the PPT, single-thread follows FMax."""
        import math
        if threads > 1:
            return round(1000 * (1 - math.exp(-self.s["ppt"] / 50)), 1), round(self.s["ppt"] * 0.9, 1)
        return round(self.s["fmax"] / 5.0, 1), 45.0

    def pm(self):
        s = self.s
        fam = FAMILIES.get(s["codename"])
        if not s["pm_version"]:
            return None, None
        if not fam or not fam["pm"]:   # a table this program cannot read (a family without a map, or not in FAMILIES)
            return s["pm_version"], [0.0] * 457
        PM = fam["pm"]
        t = [0.0] * 457
        vals = {"ppt_limit": s["ppt"], "ppt": 61.0, "tdc_limit": s["tdc"], "tdc": 23.0, "thm_limit": s["thm"],
                "tctl": s["tctl"], "edc_limit": s["edc"], "stapm_limit": s.get("stapm", 65.0), "stapm": 38.0,   # APU header
                "fast_limit": s.get("fast", 88.0), "fast": 52.0, "slow_limit": s.get("slow", 65.0), "slow": 41.0}
        for k, i in PM.items():
            t[i] = vals[k]
        layout = fam["pm_cores"].get(s["pm_version"])
        for c, (ccd, slot) in enumerate(self.slots if layout else []):   # by physical slot, like the real arrays
            i = 8 * ccd + slot
            t[layout["temp"] + i] = s["tctl"] - 6.0 + slot % 3      # a few degrees apart, like a real idle CPU
            t[layout["volt"] + i] = round(1.25 + s["co"][c] * 0.003, 3)   # a negative CO lowers the voltage
            t[layout["mhz"] + i] = s["fmax"] - 50
        return s["pm_version"], t


FAKE = Fake() if ROOT else None


def read_topology():
    """Physical cores in order: [(core_id, "cpu,cpu")] from sysfs, both SMT threads of each core.
    On Zen the core_id carries the CCD (core_id // 8); inside a CCD it does not tell the physical slot
    of a core when some are disabled (see core_map)."""
    cores = {}
    base = P("/sys/devices/system/cpu")
    for name in os.listdir(base) if os.path.isdir(base) else []:
        m = re.fullmatch(r"cpu(\d+)", name)
        try:
            cid = int(read_text("/sys/devices/system/cpu/%s/topology/core_id" % name)) if m else None
        except (OSError, ValueError):   # offline CPU: no topology
            cid = None
        if cid is not None:
            cores.setdefault(cid, []).append(int(m.group(1)))
    return [(cid, ",".join(str(c) for c in sorted(cpus))) for cid, cpus in sorted(cores.items())]


def init_cpu():
    global TOPO, CORES
    TOPO = read_topology()
    CORES = len(TOPO)
    _CORE_MAP.clear()
    _CPUINFO.clear()


init_cpu()


def family():
    """The backend descriptor of this CPU: its FAMILIES entry (backend "amd": the SMU allowlist, the PM map), or
    GENERIC with the reason (`why`) where the amd backend does not apply: the kernel parameter siliconctl.generic, no
    ryzen_smu driver, a codename that is not in FAMILIES, a laptop with a desktop family. No SMU command is ever sent
    on GENERIC (its allowlist is empty); no readable topology is refused in full."""
    if not CORES:
        raise Err(_("CPU topology not readable (/sys/devices/system/cpu)"))
    forced = "siliconctl.generic" in kernel_cmdline().split()
    if forced:
        why = _("forced by the kernel parameter siliconctl.generic")
    else:
        try:
            code = int(FAKE.s["codename"]) if FAKE else int(read_text(SMU_DIR + "/codename"))
        except (OSError, ValueError, TypeError):
            code, why = None, _("ryzen_smu driver not loaded (%s)") % P(SMU_DIR)
        if code is not None and code not in FAMILIES:
            why = _("unsupported CPU (codename %d; supported: %s)") % (
                code, ", ".join("%s %d" % (f["name"], c) for c, f in sorted(FAMILIES.items())))
        elif code is not None and not FAMILIES[code].get("mobile") and system_battery():
            # the driver reports the HX laptop CPUs as desktops (Dragon Range as Raphael, Fire Range as Granite
            # Ridge: same CPUID model): firmware, EC and battery limits of a laptop are handled for the APUs only
            why = _("laptop detected (%s): the driver reports this processor as the desktop %s, a laptop part (Ryzen HX) "
                    "that is not supported: only the laptop APUs are") % (system_battery(), FAMILIES[code]["name"])
        elif code is not None:
            return FAMILIES[code]
    if not forced and cpuinfo().get("vendor_id") == "GenuineIntel":
        return dict(INTEL, name=cpu_model(), why=None)
    return dict(GENERIC, name=cpu_model(), why=why)


def kernel_cmdline():
    try:
        return FAKE.s.get("cmdline", "") if FAKE else read_text("/proc/cmdline")
    except OSError:
        return ""


def cpuinfo():
    """The first value of every field of /proc/cpuinfo (vendor_id, cpu family, model, model name, microcode; on ARM
    "Model" or "Hardware")."""
    if not _CPUINFO:
        out = {}
        try:
            with open(P("/proc/cpuinfo")) as f:
                for line in f:
                    key, _sep, value = line.partition(":")
                    if value.strip():
                        out.setdefault(key.strip(), value.strip())
        except OSError:
            pass
        _CPUINFO.append(out)
    return _CPUINFO[0]


def cpu_model():
    info = cpuinfo()
    return info.get("model name") or info.get("Model") or info.get("Hardware") or "CPU"


def intel_model():
    """(family, model) of an Intel CPU, (0, 0) if unknown."""
    try:
        return int(cpuinfo()["cpu family"]), int(cpuinfo()["model"])
    except (KeyError, ValueError):
        return 0, 0


def power_supplies():
    """[(name, type)] of the power supplies of the machine itself; those of devices (a wireless mouse's battery: scope
    "Device") do not count."""
    d = P("/sys/class/power_supply")
    out = []
    for n in sorted(os.listdir(d) if os.path.isdir(d) else []):
        try:
            kind = read_text("/sys/class/power_supply/%s/type" % n)
            scope = read_text("/sys/class/power_supply/%s/scope" % n) if os.path.exists("%s/%s/scope" % (d, n)) else "System"
        except OSError:
            continue
        if scope != "Device":
            out.append((n, kind))
    return out


def system_battery():
    """The name of a battery that powers the machine (a laptop), or None."""
    return next((n for n, kind in power_supplies() if kind == "Battery"), None)


def power_source():
    """"ac" or "battery" on a laptop, None without a system battery (a desktop, a mini PC). AC: a Mains supply or a USB
    one (a USB-C charger) online."""
    sup = power_supplies()
    if not any(kind == "Battery" for _n, kind in sup):
        return None
    for n, kind in sup:
        try:
            if kind in ("Mains", "USB") and read_text("/sys/class/power_supply/%s/online" % n) != "0":
                return "ac"
        except OSError:
            pass
    return "battery"


def smu(name, *args):
    try:
        mailbox, cmd = family()["cmd"][name]
    except KeyError:   # not in this family's allowlist: never sent
        raise Err(_("%s is not available on this CPU") % name)
    status, out = FAKE.smu(mailbox, cmd, args) if FAKE else smu_raw(mailbox, cmd, args)
    if status != 1:
        hint = _(" (PBO disabled in the BIOS? set it to Advanced/Motherboard)") if status == 0xFD else ""
        raise Err(_("SMU %s 0x%02X: %s%s") % (mailbox, cmd, SMU_STATUS.get(status, hex(status)), hint))
    return out


def pm_table():
    try:
        fam = family()
    except Err:
        return None, None
    if not fam.get("pm"):   # no map (GENERIC, Raphael, Zen/Zen+): not even read, every read is an SMU command
        return None, None
    version, t = FAKE.pm() if FAKE else pm_raw()
    if not pm_accepts(fam, version):
        return None, None
    return version, t


def pm_accepts(fam, version):
    """A PM table this family's map applies to: its version's prefix (version >> 16) or one of its listed versions."""
    prefix = fam.get("pm_prefix") if fam and fam.get("pm") else None
    return version is not None and bool(fam and fam.get("pm")) and (
        (prefix is not None and version >> 16 == prefix) or version in fam.get("pm_versions", ()))


def check_cpu():
    return family()


def co_range():
    return family().get("co_range", (CO_MIN, CO_MAX))


def co_support():
    """None if the per-core Curve Optimizer can be used on this CPU, otherwise the reason."""
    if not {"co_set", "co_get"} <= set(family()["cmd"]):
        return _("no verified Curve Optimizer commands for this CPU family")
    if core_map() is None:
        return _("the physical position of the cores is unknown (core fuses unreadable or not matching the topology)")
    return None


CPU_ZONES = ("x86_pkg_temp", "cpu-thermal", "cpu_thermal", "soc_thermal", "cpu")   # thermal zones of the CPU package


def tctl():
    """The CPU temperature in °C: AMD's Tctl (k10temp), otherwise the package sensor of the other CPUs (coretemp, a
    thermal zone of the CPU); None if unknown."""
    if FAKE:
        return FAKE.s["tctl"]
    for d in sorted(os.listdir(P(HWMON))):
        try:
            name = read_text("%s/%s/name" % (HWMON, d))
            if name == "k10temp":
                # 1600X/1700X/1800X/2700X: Tctl carries a +20/+10 °C offset, k10temp adds the real Tdie as temp2
                t = 2 if os.path.exists(P("%s/%s/temp2_label" % (HWMON, d))) and read_text("%s/%s/temp2_label" % (HWMON, d)) == "Tdie" else 1
                return int(read_text("%s/%s/temp%d_input" % (HWMON, d, t))) / 1000.0
            if name == "coretemp":   # Intel: the package sensor
                for f in sorted(os.listdir(P("%s/%s" % (HWMON, d)))):
                    if f.endswith("_label") and read_text("%s/%s/%s" % (HWMON, d, f)).startswith("Package id"):
                        return int(read_text("%s/%s/%s_input" % (HWMON, d, f[:-6]))) / 1000.0
        except (OSError, ValueError):
            pass
    zones = P("/sys/class/thermal")
    for z in sorted(os.listdir(zones) if os.path.isdir(zones) else []):
        try:
            if read_text("/sys/class/thermal/%s/type" % z) in CPU_ZONES:
                return int(read_text("/sys/class/thermal/%s/temp" % z)) / 1000.0
        except (OSError, ValueError):
            pass
    return None


def power_get():
    if FAKE:
        return FAKE.s["power"]
    r = subprocess.run(["busctl", "get-property", "net.hadess.PowerProfiles",
                        "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles", "ActiveProfile"],
                       capture_output=True, text=True)
    if r.returncode == 0:
        return r.stdout.split('"')[1]
    try:  # no daemon: EPP of cpu0
        epp = read_text("/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference")
        return {"power": "power-saver", "performance": "performance"}.get(epp, "balanced")
    except OSError:
        return None


def power_set(profile):
    if FAKE:
        if FAKE.s.get("pmf") and FAKE.s["power"] != profile:   # like amd-pmf on a laptop: a new platform profile, new limits
            FAKE.s.pop("fast", None)
            FAKE.s.pop("slow", None)
        FAKE.s["power"] = profile
        FAKE.save()
        return
    r = subprocess.run(["busctl", "set-property", "net.hadess.PowerProfiles",
                        "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles", "ActiveProfile",
                        "s", profile], capture_output=True, text=True)
    if r.returncode == 0:
        return
    epp = {"power-saver": "power", "balanced": "balance_performance", "performance": "performance"}[profile]
    cpus = P("/sys/devices/system/cpu")
    for d in os.listdir(cpus):
        f = "%s/%s/cpufreq/energy_performance_preference" % (cpus, d)
        if d.startswith("cpu") and d[3:].isdigit() and os.path.exists(f):
            with open(f, "w") as fh:
                fh.write(epp)


def boost_files():
    """The kernel's Precision Boost switch: global (acpi-cpufreq, amd-pstate passive/guided) or per policy."""
    if os.path.exists(P(CPUFREQ + "/boost")):
        return [CPUFREQ + "/boost"]
    d = P(CPUFREQ)
    return ["%s/%s/boost" % (CPUFREQ, n) for n in sorted(os.listdir(d) if os.path.isdir(d) else [])
            if n.startswith("policy") and os.path.exists("%s/%s/boost" % (d, n))]


def boost_get():
    """Switch state: "on", "off", or None without a switch (or with policies that disagree). intel_pstate has no boost
    file: its no_turbo is the inverted switch."""
    if not boost_files() and os.path.exists(P(NO_TURBO)):
        return {"0": "on", "1": "off"}.get(read_text(NO_TURBO))
    vals = {read_text(f) for f in boost_files()}
    return {frozenset({"1"}): "on", frozenset({"0"}): "off"}.get(frozenset(vals))


def cmd_boost(ctx, args):
    """`boost on|off`: Precision Boost through the kernel (cpufreq), no SMU; read back from the same files.
    The only frequency lever on CPUs without an FMax command (Ryzen 1000–3000)."""
    if args not in (["on"], ["off"]):
        raise Err(_("usage: boost on|off"))
    files = boost_files()
    if not files and not os.path.exists(P(NO_TURBO)):
        raise Err(_("boost switch not available (no cpufreq boost control)"))
    if args == ["on"] and check_cpu()["backend"] == "intel":
        try:
            off = load_baseline(strict=False).get("boost") == "off"
        except Err:
            off = False
        if off:   # the BIOS turned turbo off: not turned on from here
            raise Err(_("boost: off at boot (turbo disabled in the BIOS): not turned on"))
    if not ctx.get("dry"):
        if not files:   # intel_pstate: EPERM when the BIOS disabled turbo
            sysfs_write(NO_TURBO, "0" if args == ["on"] else "1")
        for f in files:
            with open(P(f), "w") as fh:
                fh.write("1" if args == ["on"] else "0")
        if boost_get() != args[0]:
            raise Err(_("boost: wrote %s but read back %s") % (args[0], boost_get()))
    return {"boost": args[0]}


# ---- State files (atomic writes) -----------------------------------------------------
def write_atomic(path, text):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d)
    with os.fdopen(fd, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    os.chmod(path, 0o644)
    dfd = os.open(d, os.O_RDONLY)
    os.fsync(dfd)
    os.close(dfd)


def touch_sync(path):
    write_atomic(path, "")


def load_settings():
    s = {"autostart": False, "profile": None, "unlock": False, "fans": {}}
    try:
        s.update(json.loads(open(P(ETC + "/settings.json")).read()))
    except (OSError, ValueError):
        pass
    return s


def save_settings(s):
    write_atomic(P(ETC + "/settings.json"), json.dumps(s, indent=1))


def parse_lines(text):
    """Profile/baseline command lines → lists of tokens. `#` starts a comment."""
    out = []
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if line:
            out.append(line.split())
    return out


def values_from_lines(lines):
    """Interprets the lines as state: {"co": [...], "ppt": 162, "shaper": {tier: [...]}, ...}."""
    v = {"shaper": {}}
    for t in lines:
        if t[0] == "co" and len(t) == CORES + 1:
            v["co"] = [int(x) for x in t[1:]]
        elif t[0] in ("ppt", "fast", "slow", "tdc", "edc", "fmax", "tjmax", "pl1", "pl2") and len(t) == 2:
            v[t[0]] = int(t[1])
        elif t[0] == "shaper" and len(t) == 5:
            v["shaper"][int(t[1])] = [int(x) for x in t[2:]]
        elif t[0] in ("power", "boost") and len(t) == 2:
            v[t[0]] = t[1]
    return v


# ---- CPU state reads -----------------------------------------------------------------
def read_co():
    """CO per core, or None where it cannot be used safely (co_support)."""
    if co_support():
        return None
    return [s16(smu("co_get", co_mask(core))[0]) for core in range(CORES)]


def read_fmax():
    """FMax in MHz: the SMU's, or on the generic backend cpufreq's maximum (the highest of the policies); None on
    families without the command (Zen 3 and older) or without cpufreq."""
    fam = family()
    if fam["backend"] != "amd":
        mhz = cpufreq_khz("scaling_max_freq")
        return max(mhz) // 1000 if mhz else None
    return smu("fmax_get")[0] if "fmax_get" in fam["cmd"] else None


def cpufreq_policies():
    d = P(CPUFREQ)
    return [n for n in sorted(os.listdir(d)) if n.startswith("policy") and os.path.exists("%s/%s/scaling_max_freq" % (d, n))] \
        if os.path.isdir(d) else []


def cpufreq_khz(name):
    """`name` (scaling_max_freq, cpuinfo_max_freq, …) of every cpufreq policy, in kHz."""
    return [int(read_text("%s/%s/%s" % (CPUFREQ, n, name))) for n in cpufreq_policies()]


def cpufreq_set_max(mhz):
    """The generic backend's FMax: every policy's scaling_max_freq, within its own hardware maximum (the cores of a
    hybrid CPU differ); at that maximum its exact value, not the MHz rounding."""
    for n in cpufreq_policies():
        top = int(read_text("%s/%s/cpuinfo_max_freq" % (CPUFREQ, n)))
        with open(P("%s/%s/scaling_max_freq" % (CPUFREQ, n)), "w") as f:
            f.write(str(top if mhz >= top // 1000 else mhz * 1000))


# ---- Intel (backend intel): PL1/PL2 through powercap, the TCC offset, thermald ----------------------
def sysfs_write(path, value):
    """One write to a kernel attribute; its error is the refusal (ENODATA: a PL locked by the BIOS; EPERM/EACCES: a
    TCC offset locked or not programmable)."""
    try:
        if FAKE:
            FAKE.sysfs_check(path)
        with open(P(path), "w") as f:
            f.write(str(value))
    except OSError as e:
        why = {errno.ENODATA: _("locked by the BIOS"), errno.EPERM: _("locked"), errno.EACCES: _("not programmable")}
        raise Err(_("%s: the kernel refused %s (%s)") % (path, value, why.get(e.errno, os.strerror(e.errno or 0))))


def pl_zones(key):
    """The constraint file prefixes of `key` (pl1, pl2) in the powercap zones that have it: the MSR one and its MMIO
    mirror (the hardware applies the lower), matched by name."""
    out = []
    for zone in RAPL_ZONES:
        for n in range(3):
            try:
                if read_text("%s/constraint_%d_name" % (zone, n)) == PL_NAMES[key]:
                    out.append("%s/constraint_%d_" % (zone, n))
                    break
            except OSError:
                break
    return out


def pl_get(key):
    """The effective PL in W (the lower zone); None without one, or when a zone's `enabled` reads 0 (PL1 locked by the
    BIOS reads 0 there, or disabled)."""
    files = pl_zones(key)
    try:
        if not files or any(read_text(f.rsplit("/", 1)[0] + "/enabled") != "1" for f in files):
            return None
        return min(int(read_text(f + "power_limit_uw")) for f in files) / 1e6
    except (OSError, ValueError):
        return None


def pl_set(key, watts):
    """The same value in both zones, as coreboot programs them; a zone that refuses (locked) puts the ones already
    written back first, so a refusal never leaves the zones apart."""
    done = []
    try:
        for f in pl_zones(key):
            done.append((f, read_text(f + "power_limit_uw")))
            sysfs_write(f + "power_limit_uw", int(watts) * 1000000)
    except Err:
        for f, old in done[:-1]:
            sysfs_write(f + "power_limit_uw", old)
        raise


def pl_max(key):
    """The kernel's max_power_uw of `key` (TDP for PL1, POWER_INFO's maximum for PL2) in W, the highest zone; None."""
    try:
        top = max([int(read_text(f + "max_power_uw")) for f in pl_zones(key)] or [0])
    except (OSError, ValueError):
        return None
    return top / 1e6 if top else None


def pl_floor(base):
    """The lowest PL1/PL2 allowed (W): INTEL_PL_MIN, half of the reference PL1 (the baseline's, or the kernel's
    max_power_uw when the board's is unlimited) and the OEM's PPCC minimum on DPTF laptops."""
    ref = base.get("pl1") if base.get("pl1", 0) < PL_UNLIMITED else pl_max("pl1")
    try:
        ppcc = int(read_text(PPCC + "/power_limit_0_min_uw")) / 1e6
    except (OSError, ValueError):
        ppcc = 0
    return int(max(INTEL_PL_MIN, round(ref / 2) if ref else 0, ppcc))


def tcc_file():
    """The TCC offset in °C: the processor thermal device's attribute (restored after resume), otherwise the "TCC
    Offset" cooling device's cur_state; None without one, or on kernels before 5.14 (no range nor lock check)."""
    if tuple(int(x) for x in re.findall(r"\d+", os.uname().release)[:2]) < (5, 14):
        return None
    pci = P("/sys/bus/pci/devices")
    for d in sorted(os.listdir(pci) if os.path.isdir(pci) else []):
        if os.path.exists("%s/%s/tcc_offset_degree_celsius" % (pci, d)):
            return "/sys/bus/pci/devices/%s/tcc_offset_degree_celsius" % d
    cool = P("/sys/class/thermal")
    for d in sorted(os.listdir(cool) if os.path.isdir(cool) else []):
        try:
            if d.startswith("cooling_device") and read_text("/sys/class/thermal/%s/type" % d) == "TCC Offset":
                return "/sys/class/thermal/%s/cur_state" % d
        except OSError:
            pass
    return None


def tjmax_hw():
    """TjMax in °C: coretemp's package temp1_crit; None."""
    for d in sorted(os.listdir(P(HWMON))):
        try:
            if read_text("%s/%s/name" % (HWMON, d)) == "coretemp":
                return int(read_text("%s/%s/temp1_crit" % (HWMON, d))) // 1000
        except (OSError, ValueError):
            pass
    return None


def tcc_tjmax():
    """The temperature limit in °C: TjMax − the TCC offset; None without both."""
    f, top = tcc_file(), tjmax_hw()
    try:
        return top - int(read_text(f)) if f and top else None
    except (OSError, ValueError):
        return None


def tcc_max_offset(f):
    """The widest offset written: 63 (6 bits; the kernel's default of 7 bits on MTL/LNL/ARL is uncertain), within the
    cooling device's max_state."""
    try:
        return min(63, int(read_text(f.rsplit("/", 1)[0] + "/max_state"))) if f.endswith("/cur_state") else 63
    except (OSError, ValueError):
        return 0


def thermald_running():
    """thermald drives RAPL and the TCC offset as cooling devices on DPTF laptops: what is written may be rewritten."""
    if FAKE:
        return bool(FAKE.s.get("thermald"))
    for pid in os.listdir("/proc"):
        try:
            if pid.isdigit() and read_text("/proc/%s/comm" % pid) == "thermald":
                return True
        except OSError:
            pass
    return False


def intel_warnings():
    """What the user must know on this Intel CPU: thermald rewriting the limits, Raptor Lake without the fixes."""
    out = []
    if thermald_running():
        out.append(_("thermald is running: it may rewrite the power limits and the temperature limit set here (stop it "
                     "to keep them: sudo systemctl disable --now thermald)"))
    try:
        mc = int(cpuinfo().get("microcode", "0"), 16)
    except ValueError:
        mc = 0
    if intel_model() == RAPTOR_DESKTOP[0] and mc < RAPTOR_MICROCODE:
        out.append(_("microcode 0x%x is older than 0x%x: the fixes for the Raptor Lake instability are missing, update "
                     "the BIOS") % (mc, RAPTOR_MICROCODE))
    return out


def limits_now():
    """The current value of every limit this CPU has, by profile key: the PM table's on AMD; powercap's and the TCC
    offset's on Intel."""
    if family()["backend"] == "intel":
        return {k: v for k, v in (("pl1", pl_get("pl1")), ("pl2", pl_get("pl2")), ("tjmax", tcc_tjmax())) if v is not None}
    lim = read_limits()
    return {k: lim[pk] for k, pk in LIMIT_PM.items() if pk in lim}


def fmax_floor():
    """The lowest FMax allowed (MHz): FMAX_MIN for the SMU's, the hardware minimum for cpufreq's."""
    if family()["backend"] == "amd":
        return FMAX_MIN
    low = cpufreq_khz("cpuinfo_min_freq")
    return -(-max(low) // 1000) if low else FMAX_MIN


def read_shaper():
    if "shaper_get" not in family()["cmd"]:
        return None
    return [shaper_decode(w) for w in smu("shaper_get")[:5]]


def read_limits(pm=None):
    """Limits and instantaneous values from the PM table (`pm`: one pm_table() already read); {} if it is absent."""
    version, t = pm or pm_table()
    if t is None:
        return {}
    return {k: round(t[i], 1) for k, i in family()["pm"].items()}


# Each limit and where the PM table reports it (readback); fast before slow: raising back keeps slow ≤ fast.
LIMIT_PM = {"ppt": "ppt_limit", "fast": "fast_limit", "slow": "slow_limit", "tdc": "tdc_limit", "edc": "edc_limit",
            "tjmax": "thm_limit"}
LIMIT_KEYS = tuple(LIMIT_PM) + ("pl1", "pl2")   # what `reapply` rewrites after the firmware (Intel: limits_now)


def capture_lines():
    """Current state in profile format (the baseline is a profile like any other)."""
    lim = read_limits()
    co, fmax = read_co(), read_fmax()
    lines = (["co " + " ".join(str(v) for v in co)] if co is not None else []) + (["fmax %d" % fmax] if fmax is not None else [])
    for key, pm_key in LIMIT_PM.items():
        if pm_key in lim:
            lines.append("%s %d" % (key, round(lim[pm_key])))
    if family()["backend"] == "intel":   # raising back: PL2 first, so that PL1 never exceeds it
        now = limits_now()
        lines += ["%s %d" % (k, round(now[k])) for k in ("pl2", "pl1", "tjmax") if k in now]
    # Curve Shaper excluded: on the 9800X3D (SMU 98.81.0) 0xA6 replies OK but 0x84 does not change,
    # so it cannot be verified; it remains only as an experimental command (`shaper probe`).
    power, boost = power_get(), boost_get()
    if power:
        lines.append("power " + power)
    if boost:
        lines.append("boost " + boost)
    lines += fan_capture_lines()   # only channels already classified "ventola" (fan)
    return lines


# ---- Baseline and caps -----------------------------------------------------------------
def cmd_baseline(ctx, args):
    """`baseline`: captures the current state as the baseline of this boot (only if no
    write has happened yet). `baseline show`: prints it."""
    if args == ["show"]:
        return load_baseline(strict=False)
    if args:
        raise Err(_("usage: baseline [show]"))
    check_cpu()
    if os.path.exists(P(STATE + "/active")):
        raise Err(_("baseline not captured: CPU state already modified in this boot"))
    lines = capture_lines()
    src = power_source()   # a laptop: the limits of this power source (source_mismatch)
    write_atomic(P(STATE + "/baseline.conf"), "# baseline captured by siliconctl\n" + ("# source %s\n" % src if src else "")
                 + "# backend %s\n" % check_cpu()["backend"] + "\n".join(lines) + "\n")
    touch_sync(P(RUN + "/baseline-done"))
    return values_from_lines(parse_lines("\n".join(lines)))


def load_baseline(strict=True):
    """Baseline values. strict (CPU writes): it must have been captured in THIS boot, on a laptop on the power source
    in use."""
    try:
        text = open(P(STATE + "/baseline.conf")).read()
    except OSError:
        raise Err(_("baseline missing: CPU writes refused (did the siliconctl service run?)"))
    if strict and not os.path.exists(P(RUN + "/baseline-done")):
        raise Err(_("baseline not captured in this boot: CPU writes refused"))
    m = re.search(r"^# backend (\w+)$", text, re.M)   # none: captured before the generic backend existed, by the amd one
    if strict and (m.group(1) if m else "amd") != check_cpu()["backend"]:
        # the backend changed within the boot (ryzen_smu loaded after it): the other one's values are not ceilings here
        raise Err(_("the baseline of this boot was captured by the %s backend, the CPU now uses the %s one: CPU writes "
                    "refused until the next boot") % (m.group(1) if m else "amd", check_cpu()["backend"]))
    why = source_mismatch(text) if strict else None
    if why:
        raise Err(why)
    return values_from_lines(parse_lines(text))


def baseline_source(text=None):
    """The power source the baseline was captured on ("ac", "battery"; its `# source` line), None without a system
    battery or without a baseline."""
    try:
        text = open(P(STATE + "/baseline.conf")).read() if text is None else text
    except OSError:
        return None
    m = re.search(r"^# source (\w+)$", text, re.M)
    return m.group(1) if m else None


def source_mismatch(text=None):
    """On a laptop, why the CPU must not be written now, or None. The baseline (every value's ceiling, what Default
    writes back) holds the limits of the power source it was captured on; on the other one the firmware sets its own,
    and limits captured on AC may be more than the battery and the EC tolerate."""
    src, base = power_source(), baseline_source(text)
    if src is None or src == base:
        return None
    if base is None:
        return _("the baseline does not record the power source: CPU writes refused until the next boot")
    if src == "battery":
        return _("on battery: the firmware's limits apply until AC power is back or the next boot (the baseline was "
                 "captured on AC power: CPU writes refused)")
    return _("on AC power: the firmware's limits apply until back on battery or the next boot (the baseline was "
             "captured on battery: CPU writes refused)")


def cap_of(base, key, unlock):
    if key not in base:
        raise Err(_("no baseline for %s (PM table missing?): write refused") % key)
    if key == "tjmax":
        return min(base[key], family().get("tjmax_max", TJMAX_ABS_MAX), TJMAX_ABS_MAX)
    if key == "fmax":
        cap = base[key] + (FMAX_UNLOCK_EXTRA if unlock else 0)
        top = cpufreq_khz("cpuinfo_max_freq") if family()["backend"] != "amd" else []
        return min(cap, max(top) // 1000) if top else cap
    if key in ("fast", "slow"):   # APUs: no unlock, the stock limits are the ceiling
        return base[key]
    if key in ("pl1", "pl2"):   # Intel: unlock up to the kernel's max_power_uw, never on Raptor Lake desktop
        top = pl_max(key) if unlock and intel_model() not in RAPTOR_DESKTOP else None
        return max(base[key], int(top)) if top else base[key]
    hard = {"ppt": UNLOCK_PPT, "tdc": UNLOCK_TDC, "edc": UNLOCK_EDC}[key]
    return max(base[key], hard) if unlock else base[key]


def check_range(name, v, lo, hi, unit=""):
    if not lo <= v <= hi:
        raise Err(_("%s %d%s out of range (allowed %d..%d%s)") % (name, v, unit, lo, hi, unit))


def to_int(s, name):
    try:
        return int(s)
    except ValueError:
        raise Err(_("%s: '%s' is not an integer") % (name, s))


# ---- Write with readback and restore ---------------------------------------------------
def write_verify(ctx, name, value, write, read, base_value, equal=lambda a, b: a == b):
    """Writes, reads back, retries once, otherwise restores the baseline and raises.
    The `active` marker precedes the first SMU write (crash guard)."""
    if ctx.get("dry"):
        return value
    if not equal(base_value, value):
        touch_sync(P(STATE + "/active"))
    wait = 0.05 if FAKE else READBACK_WAIT
    for _attempt in range(2):
        write(value)
        deadline = time.monotonic() + wait
        while True:
            got = read()
            if equal(got, value) or time.monotonic() >= deadline:
                break
            time.sleep(READBACK_POLL)
        if equal(got, value):
            return got
    if base_value is not None:
        write(base_value)
    raise Err(_("%s: wrote %s but read back %s; restored %s") % (name, value, got, base_value))


def near(a, b):
    return a is not None and b is not None and abs(a - b) <= READBACK_TOL


def limit_setter(key, pm_key, cmd_name, unit, lo):
    def cmd(ctx, args):
        if len(args) != 1:
            raise Err(_("usage: %s <%s>") % (key, unit))
        v = to_int(args[0], key)
        check_cpu()
        s = load_settings()
        base = load_baseline()
        cap = cap_of(base, key, s["unlock"])   # no baseline for the key: refused
        if v != base[key]:   # the stock value is always allowed back (an APU's Tctl limit can be 100 °C)
            check_range(key, v, lo, cap, " " + unit)
        if not read_limits():
            raise Err(_("PM table missing: cannot verify %s, write refused") % key)
        if not ctx.get("dry") and not ctx.get("profile"):
            reapply_off()   # a value set by hand: the profile is no longer re-applied over it
        scale = 1 if key == "tjmax" else 1000
        got = write_verify(ctx, key, float(v), lambda x: smu(cmd_name, int(x * scale)),
                           lambda: read_limits().get(pm_key), float(base[key]), near)
        return {key: got}
    return cmd


def pl_setter(key):
    def cmd(ctx, args):
        if len(args) != 1:
            raise Err(_("usage: %s <%s>") % (key, "W"))
        v = to_int(args[0], key)
        if check_cpu()["backend"] != "intel":
            raise Err(_("%s is not available on this CPU") % key)
        base = load_baseline()
        cap = cap_of(base, key, load_settings()["unlock"])   # no baseline for the key (locked, absent): refused
        if v != base[key]:
            check_range(key, v, pl_floor(base), cap, " W")
        if not ctx.get("dry") and not ctx.get("profile"):
            reapply_off()
        got = write_verify(ctx, key, float(v), lambda x: pl_set(key, x), lambda: pl_get(key), float(base[key]), near)
        return dict({key: got}, **({"warning": intel_warnings()} if intel_warnings() and not ctx.get("dry") else {}))
    return cmd


def cmd_tjmax(ctx, args):
    """`tjmax <°C>`: the SMU's on AMD (AMD_TJMAX), the TCC offset on Intel: only ever lowered, the stock value always
    allowed back."""
    if check_cpu()["backend"] != "intel":
        return AMD_TJMAX(ctx, args)
    if len(args) != 1:
        raise Err(_("usage: %s <%s>") % ("tjmax", "°C"))
    v = to_int(args[0], "tjmax")
    f, top, base = tcc_file(), tjmax_hw(), load_baseline()
    cap = cap_of(base, "tjmax", load_settings()["unlock"])   # no baseline (no TCC offset): refused
    if f is None or top is None:
        raise Err(_("tjmax: no TCC offset on this CPU"))
    if v != base["tjmax"]:
        check_range("tjmax", v, max(TJMAX_MIN, top - tcc_max_offset(f)), cap, " °C")
    if not ctx.get("dry") and not ctx.get("profile"):
        reapply_off()
    got = write_verify(ctx, "tjmax", v, lambda x: sysfs_write(f, top - x), tcc_tjmax, base["tjmax"])
    return dict({"tjmax": got}, **({"warning": intel_warnings()} if intel_warnings() and not ctx.get("dry") else {}))


def cmd_co(ctx, args):
    """`co <core> <v>` | `co all <v>` | `co v0 … v7`."""
    if len(args) == CORES:
        wanted = {c: to_int(x, "co") for c, x in enumerate(args)}
    elif len(args) == 2 and args[0] == "all":
        wanted = {c: to_int(args[1], "co") for c in range(CORES)}
    elif len(args) == 2:
        core = to_int(args[0], "core")
        check_range("core", core, 0, CORES - 1)
        wanted = {core: to_int(args[1], "co")}
    else:
        raise Err(_("usage: co <core|all> <value> | co v0 … v%d") % (CORES - 1))
    check_cpu()
    for v in wanted.values():
        check_range("co", v, *co_range())
    why = co_support()
    if why:
        raise Err(_("Curve Optimizer not available on this CPU: %s") % why)
    base = load_baseline()
    for core, v in wanted.items():
        write_verify(ctx, "co core %d" % core, v, lambda x, c=core: smu("co_set", co_arg(c, x)),
                     lambda c=core: read_co()[c], base["co"][core])
    return {"co": None if ctx.get("dry") else read_co()}


def cmd_fmax(ctx, args):
    if len(args) != 1:
        raise Err(_("usage: fmax <MHz>"))
    v = to_int(args[0], "fmax")
    fam = check_cpu()
    if fam["backend"] == "amd" and "fmax_set" not in fam["cmd"]:
        raise Err(_("FMax is not available on this CPU (no SMU command for it): use `boost off` to cap the clock"))
    base = load_baseline()
    check_range("fmax", v, fmax_floor(), cap_of(base, "fmax", load_settings()["unlock"]), " MHz")
    write = cpufreq_set_max if fam["backend"] != "amd" else lambda x: smu("fmax_set", x & 0xFFFFF)
    return {"fmax": write_verify(ctx, "fmax", v, write, read_fmax, base["fmax"])}


def cmd_shaper(ctx, args):
    """Experimental: not verified on hardware. `shaper raw` = words of 0x84;
    `shaper probe` = writes tier 4 -2/-2/-2, reads at once and after 1 s, restores."""
    raw = lambda: ["0x%08X" % w for w in smu("shaper_get")]
    if args == ["raw"]:
        check_cpu()
        return {"raw": raw()}
    if args == ["probe"]:
        check_cpu()
        base = load_baseline()
        out = {"prima": raw()}
        smu("shaper_set", shaper_arg(4, -2, -2, -2))
        out["subito"] = raw()
        time.sleep(1)
        out["dopo_1s"] = raw()
        smu("shaper_set", shaper_arg(4, *base["shaper"].get(4, [0, 0, 0])))
        out["ripristino"] = raw()
        out["per_tier_arg0"] = ["0x%08X" % smu("shaper_get", t)[0] for t in range(5)]   # 0x84 with arg0 = tier
        return out
    if len(args) != 4:
        raise Err(_("usage: shaper <tier 0-4> <lowT> <midT> <highT> | shaper raw | shaper probe"))
    tier = to_int(args[0], "tier")
    check_range("tier", tier, 0, 4)
    v = [to_int(x, "shaper") for x in args[1:]]
    for m in v:
        check_range("shaper", m, CO_MIN, CO_MAX)
    check_cpu()
    base = load_baseline()
    got = write_verify(ctx, "shaper tier %d" % tier, v, lambda x: smu("shaper_set", shaper_arg(tier, *x)),
                       lambda: read_shaper()[tier], base["shaper"].get(tier))
    return {"shaper": {tier: got}}


