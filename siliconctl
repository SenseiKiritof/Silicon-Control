# ---- hwtest: automatic and reversible check on hardware ------------------------------
def cmd_hwtest(ctx, args):
    """For each command: a value slightly away from the baseline, readback, then the baseline
    value. Continues even if a step fails; at the end reapplies the baseline."""
    check_cpu()
    base = load_baseline()
    last = CORES - 1   # the last core (7 on 8 cores)
    no_co = co_support()
    steps = [("co", [str(last), str(max(CO_MIN, base["co"][last] - 3))], [str(last), str(base["co"][last])]) if not no_co
             else ("co", None, _("skipped: %s") % no_co),
             ("fmax", [str(max(fmax_floor(), base["fmax"] - 200))], [str(base["fmax"])]) if "fmax" in base
             else ("fmax", None, _("skipped: not available on this CPU"))]
    for key, floor, delta in (("ppt", PPT_MIN, 12), ("pl1", None, 5), ("pl2", None, 5), ("slow", APU_MIN_W, 3),
                              ("fast", APU_MIN_W, 3), ("tdc", TDC_MIN, 10), ("edc", EDC_MIN, 10), ("tjmax", TJMAX_MIN, 10)):
        if key not in base and key + "_set" not in family()["cmd"]:   # not a function of this CPU (fast/slow on desktops)
            continue
        floor = pl_floor(base) if floor is None else floor
        if key in base:
            steps.append((key, [str(max(floor, base[key] - delta))], [str(base[key])]))
        else:
            steps.append((key, None, _("skipped: no baseline (PM table missing)")))
    if "boost" in base:   # the kernel switch (no SMU): the other value, then back
        steps.append(("boost", ["off" if base["boost"] == "on" else "on"], [base["boost"]]))
    results, failed = {}, False
    for key, test, restore in steps:
        if test is None:
            results[key] = restore   # the reason of the skip
            continue
        try:
            run([key] + test, ctx)
            run([key] + restore, ctx)
            results[key] = "ok (%s -> %s)" % (" ".join(test), " ".join(restore))
        except Err as e:
            results[key] = _("error: %s") % e
            failed = True
    try:
        apply_lines(profile_lines("baseline"), ctx)
        rm(marker("active"))
        results["baseline"] = _("restored")
    except Err as e:
        results["baseline"] = _("error restoring the baseline: %s") % e
        failed = True
    results["esito"] = _("FAILED") if failed else "ok"
    s = load_settings()   # the local record of this CPU (status.checked; the report quotes it)
    s["hwtest"] = {"date": time.strftime("%Y-%m-%d %H:%M"), "esito": "FAILED" if failed else "ok", "id": cpu_id(),
                   "results": results}
    save_settings(s)
    return results


def fmt_hwtest(r):
    return "\n".join("%-9s %s" % (k, v) for k, v in r.items())


# ---- Hardware watchdog during a calibration (serve only) ----------------------------------
# On Ryzen 9000 a too negative CO can freeze the machine instead of resetting it. While a calibration or a
# verification runs under `serve` (the GUI), the hardware watchdog is handed to systemd (RuntimeWatchdogUSec):
# PID 1 pings it as long as the system lives, so a freeze becomes a reset after WD_SEC and the crash-guard and
# the resume of the run take over, while a siliconctl that dies or is killed does not reset the PC: its run counts
# as crashed when siliconctl starts again (at_attribute_crash, pid of the step) and the watchdog it left with
# systemd is released then (wd_cleanup). The CLI (one process per step) never arms it.
WD_CLASS = "/sys/class/watchdog"
WD_SEC = 60                       # timeout given to systemd, which pings at half of it
WD_STATE = RUN + "/watchdog"      # pid of the siliconctl that handed the watchdog to systemd
WD = None                         # the Watchdog of this `serve` process; None under the CLI


def sd_watchdog(usec=None):
    """systemd's RuntimeWatchdogUSec: read it, or set it first (not 0: PID 1 opens the hardware watchdog and pings it;
    0: it stops it with the magic close). None if this systemd cannot do it."""
    if FAKE:
        return FAKE.sd_watchdog(usec)
    obj = ["org.freedesktop.systemd1", "/org/freedesktop/systemd1", "org.freedesktop.systemd1.Manager", "RuntimeWatchdogUSec"]
    if usec is not None and subprocess.run(["busctl", "set-property"] + obj + ["t", str(usec)], capture_output=True).returncode:
        return None
    r = subprocess.run(["busctl", "get-property"] + obj, capture_output=True, text=True)
    try:
        return int(r.stdout.split()[1]) if r.returncode == 0 else None
    except (IndexError, ValueError):
        return None


def pid_alive(pid):
    """Is `pid` still a running siliconctl? (None: unknown, assumed alive)"""
    if pid is None:
        return True
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return b"siliconctl" in f.read()
    except (OSError, ValueError):
        return False


def wd_release():
    """systemd's runtime watchdog back off (it stops the hardware one with the magic close). True if off."""
    ok = sd_watchdog(0) == 0
    if ok:
        rm(P(WD_STATE))
    return ok


def wd_cleanup():
    """The watchdog left with systemd by a siliconctl that died (no reset: PID 1 kept pinging it) is released at the
    next start of siliconctl."""
    try:
        owner = int(read_text(WD_STATE))
    except (OSError, ValueError):
        return
    if not pid_alive(owner):
        wd_release()


class Watchdog:
    """Armed = systemd drives the hardware watchdog for this run (see above). `status` is the text that
    `autotune …` reports under serve."""

    def __init__(self):
        self.status, self.armed, self.closed = None, False, False   # closed: serve is exiting, never armed again

    def follow(self, st, arm=True):
        """Armed while a run is in progress (unless watchdog=0), disarmed as soon as it is done, aborted or gone."""
        if not st or st.get("phase") in (None, "done"):
            self.disarm()
        elif not st["params"].get("watchdog", 1):
            self.status = _("unavailable: %s") % _("disabled (watchdog=0)")
        elif arm:
            self.arm()

    def why_not(self):
        """Why it must not be armed (fail closed: whatever could not surely be stopped, or is not ours), or None."""
        if FAKE:
            FAKE.wd_files()
        base = P(WD_CLASS)
        names = sorted((n for n in (os.listdir(base) if os.path.isdir(base) else []) if re.fullmatch(r"watchdog\d+", n)),
                       key=lambda n: int(n[8:]))
        if not names:
            return _("no hardware watchdog (%s)") % WD_CLASS
        self.sys = WD_CLASS + "/" + names[0]
        try:
            nowayout, state = read_text(self.sys + "/nowayout"), read_text(self.sys + "/state")
        except OSError:
            return _("%s does not report nowayout and state") % names[0]
        try:
            param = read_text(self.sys + "/device/driver/module/parameters/nowayout")   # most drivers hide it
        except OSError:
            param = "N"
        if nowayout != "0" or param in ("Y", "1"):
            return _("nowayout is set: once armed it could never be stopped")
        cur = sd_watchdog()
        if cur is None:
            return _("systemd cannot drive it (RuntimeWatchdogUSec)")
        if cur:
            return _("already driven by systemd (RuntimeWatchdogSec %d s): the PC is protected anyway") % (cur // 10 ** 6)
        if state != "inactive":
            return _("already active (used by another program)")
        return None

    def arm(self):
        if self.armed or self.closed:
            return
        why = self.why_not()
        if why:
            self.status = _("unavailable: %s") % why
            return
        write_atomic(P(WD_STATE), str(os.getpid()))   # first: if this process dies, the next siliconctl releases it
        if sd_watchdog(WD_SEC * 10 ** 6) != WD_SEC * 10 ** 6 or read_text(self.sys + "/state") != "active":
            wd_release()
            self.status = _("unavailable: %s") % _("systemd did not take the watchdog")
            return
        self.armed = True
        self.status = _("armed (%d s)") % WD_SEC

    def disarm(self, final=False):
        """Released if armed; final (serve exiting): never armed again. False if systemd still drives it (harmless:
        PID 1 keeps pinging it; the next start of siliconctl releases it)."""
        self.closed = self.closed or final
        if not self.armed:
            return True
        self.armed = False
        ok = wd_release()
        self.status = _("disarmed") if ok else _("ERROR: systemd still drives the watchdog; it is released at the next start")
        return ok


# ---- serve: protocol for the GUI (one JSON line per request and per reply) ---------
SERVE_DENY = {"serve", "boot", "shutdown", "resume", "selftest"}   # autotune step is allowed: the GUI drives it


def serve_one(line):
    try:
        argv = json.loads(line)
        if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv) or not argv:
            raise Err(_("invalid request: expected a JSON array of strings"))
        if argv[0] in SERVE_DENY:
            raise Err(_("command '%s' not available via serve") % argv[0])
        return {"ok": True, "data": run(argv)}
    except Err as e:
        return {"ok": False, "error": str(e)}
    except Exception as e:  # never die on a bug: the GUI shows the error
        return {"ok": False, "error": _("internal: %r") % e}


def cmd_serve(ctx, args):
    """Requests run in order on a single thread (serialized SMU); the reader stays
    free so that `autotune abort` interrupts a long step at once (flag + stress-ng terminated).
    A calibration hands the hardware watchdog to systemd for its duration (Watchdog)."""
    import queue
    import threading
    global WD
    wd_cleanup()
    WD = Watchdog()
    q = queue.Queue()

    def worker():
        while True:
            line = q.get()
            if line is None:
                return
            sys.stdout.write(json.dumps(serve_one(line), ensure_ascii=False) + "\n")
            sys.stdout.flush()

    t = threading.Thread(target=worker, daemon=True)
    t.start()
    try:
        for line in sys.stdin:
            line = line.strip()
            if not line:
                continue
            try:
                if json.loads(line) in (["autotune", "abort"], ["autotune", "finish"]):
                    at_request_abort()
            except ValueError:
                pass
            q.put(line)
        q.put(None)
        t.join()                         # the step in progress ends first (armed meanwhile)
    finally:   # end of input (GUI closed) or an exception; killed instead: released at the next start
        WD.disarm(final=True)
        WD = None


