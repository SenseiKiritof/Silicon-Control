    assert out["applied"] == ["power performance", "boost on"] and FAKE.s["power"] == "performance", out
    assert writes() == n and FAKE.s["thm"] == thm == 80.0   # no SMU write (fast/slow: the fake amd-pmf's, at the profile change)
    assert os.path.exists(marker("active")) and not wanted() and reapply_state() == {}
    # ---- booted on battery: the battery's baseline, written on battery, refused on AC ----
    run(["shutdown"])
