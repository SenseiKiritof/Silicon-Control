def selftest_laptop():
    """Phase 8: a Phoenix APU in a laptop (fake power supplies). The baseline records the power source and the CPU is
    written only on that one (Default on the other writes no CPU value); `power` before the limits (a fake amd-pmf
    resets them at every platform profile change); `reapply` against the firmware's rewrites, with the give-up. A mini
    PC (no battery) never re-applies."""
    global ROOT, FAKE

    def supply(name, **files):
        os.makedirs(P("/sys/class/power_supply/" + name), exist_ok=True)
        for k, v in files.items():
            with open(P("/sys/class/power_supply/%s/%s" % (name, k)), "w") as fh:
                fh.write("%s\n" % v)

    def firmware_reset():   # the EC puts its own limits back (here the stock ones)
        FAKE.s.pop("fast", None)
        FAKE.s.pop("slow", None)
        FAKE.save()

    def writes():
        return len(FAKE.s["log"])

    def wanted():
        return os.path.exists(P(REAPPLY_WANTED))
    # ---- a mini PC: no system battery (a wireless mouse's does not count), no power source, nothing re-applied ----
    ROOT = tempfile.mkdtemp(prefix="siliconctl-selftest-minipc-")
    FAKE = Fake("phoenix")
    init_cpu()
    supply("hidpp_battery_0", type="Battery", scope="Device")
    assert power_source() is None
    run(["boot"])
    assert baseline_source() is None and "# source" not in read_text(STATE + "/baseline.conf")
    run(["preset", "quiet"])
    for argv in (["apply", "quiet"], ["use", "quiet"], ["autostart", "on"]):
        run(argv)
    firmware_reset()
    n = writes()
    assert not wanted() and run(["reapply"]) is None and writes() == n and "fast" not in FAKE.s
    assert "Laptop" not in fmt_status(run(["status"]))
    # ---- the same APU in a laptop, booted on AC ----
    ROOT = tempfile.mkdtemp(prefix="siliconctl-selftest-laptop-")
    FAKE = Fake("phoenix")
    init_cpu()
    FAKE.s["pmf"] = True
    FAKE.save()
    supply("BAT0", type="Battery")
    supply("ADP1", type="Mains", online=1)
    supply("hidpp_battery_0", type="Battery", scope="Device")
    assert power_source() == "ac" and run(["status"])["cpu"] == "Phoenix"     # a mobile family: allowed
    run(["boot"])
    assert "\n# source ac\n" in open(P(STATE + "/baseline.conf")).read() and baseline_source() == "ac"
    st = run(["status"])
