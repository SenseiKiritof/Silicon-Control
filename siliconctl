    supply("ADP1", online=1)
    expect_err(["slow", "30"], "on AC power")
    assert "does not record" in source_mismatch(read_text(STATE + "/baseline.conf").replace("# source battery", ""))


def selftest_takeover():
    """Phase 0: Ryzen Control replaced in the boot in which it ran (the RPM's %post starts siliconctl.service): its state
    and run state imported once, no baseline captured over its profile, no false crash, the profile applied again and
    read back, its trust rule ours, its lock taken while /run/ryzenctl exists. Replaced after a boot it did not close
    (dirty and active, no run state): the crash is reported, the safe side."""
    global ROOT, FAKE
    os.environ["PKEXEC_UID"] = str(os.getuid())

    def ryzen_control(close):
        """Ryzen Control 0.8.0 (the same code) with an applied profile, its state moved to its paths; `close`: a reboot
        that it did not close (its run state gone, the SMU back at the BIOS values)."""
        global ROOT, FAKE
        ROOT = tempfile.mkdtemp(prefix="siliconctl-selftest-takeover-")
        FAKE = Fake("granite")
        init_cpu()
        run(["boot"])
        _unlock(_lock())                                  # the lock file that its SMU transactions leave
        run(["profile", "save", "new-auto", "ppt 120", "co all -10", "fmax 5000"])
        for argv in (["use", "new-auto"], ["autostart", "on"], ["apply", "new-auto"]):
            run(argv)
        run(["trust", "on"])
        write_atomic(P(OLD_TRUST_RULE), read_text(TRUST_RULE).replace(POLKIT_ACTION, "org.ryzencontrol.RyzenControl.serve"))
        rm(P(TRUST_RULE))
        if close:
            for f in os.listdir(P(RUN)):
                os.remove(P(RUN + "/" + f))
            FAKE.s.update(co=list(FAKE.default["co"]), ppt=FAKE.default["ppt"], fmax=FAKE.default["fmax"])
            FAKE.save()
        for old, new in ((OLD_ETC, ETC), (OLD_STATE, STATE), (OLD_RUN, RUN)):
            os.rename(P(new), P(old))
        os.makedirs(P(ETC + "/profiles"))   # the package's empty directories
        os.makedirs(P(STATE))
        return read_text(OLD_STATE + "/baseline.conf")
    # ---- replaced in the boot in which it ran ----
    base = ryzen_control(False)
    out = run(["boot"])
    assert out["imported"] == [OLD_ETC, OLD_STATE, OLD_RUN, OLD_TRUST_RULE] and not out["crashed"], out
    assert read_text(STATE + "/baseline.conf") == base and out["applied"]["cpu"] and not out["errors"], out
    st = run(["status"])
    assert st["co"] == [-10] * CORES and st["limits"]["ppt"] == 120.0 and st["fmax"] == 5000 and st["profile"] == "new-auto", st
    assert trust_users() == [trust_user()] and POLKIT_ACTION in read_text(TRUST_RULE) and not os.path.exists(P(OLD_TRUST_RULE))
    assert os.path.exists(P(OLD_ETC + "/profiles/new-auto.conf")) and not os.path.exists(P(RUN + "/lock"))   # the lock: not state
    assert "imported" not in run(["boot"])                # once: a restart finds our state
    fds = _lock()                                         # a `ryzenctl serve` of its GUI waits for our transaction
    other = os.open(P(OLD_RUN + "/lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(other, fcntl.LOCK_EX | fcntl.LOCK_NB)
        raise AssertionError("ryzenctl's lock not taken")
    except BlockingIOError:
        pass
    _unlock(fds)
    fcntl.flock(other, fcntl.LOCK_EX | fcntl.LOCK_NB)
    os.close(other)
    # ---- replaced after a boot that it did not close ----
    ryzen_control(True)
    out = run(["boot"])
    assert out["imported"] == [OLD_ETC, OLD_STATE, OLD_TRUST_RULE] and out["crashed"]["profile"] == "new-auto", out
    assert "crash" in out["errors"]["cpu"] and run(["status"])["limits"]["ppt"] == 162.0 and run(["baseline", "show"])["ppt"] == 162
    # ---- nothing to take over ----
    ROOT = tempfile.mkdtemp(prefix="siliconctl-selftest-fresh-")
    FAKE = Fake("granite")
    init_cpu()
    assert "imported" not in run(["boot"])


def selftest_transport():
    """The real transports (smu_raw, pm_raw, smn_read: never run by the fake backend) take their locks and release them,
    also Ryzen Control's while /run/ryzenctl exists: here on regular files in place of the driver's (a mailbox reads back
    the command written as its status, smn the address, smu_args the arguments)."""
    global FAKE
    fake, FAKE = FAKE, None
    try:
        for name, data in (("codename", b"23"), ("smu_args", b""), (MP1, b""), ("smn", b""),
                           ("pm_table_version", struct.pack("<I", 0x620105)), ("pm_table", struct.pack("<2f", 1.5, 2.5))):
            write_atomic(P(SMU_DIR + "/" + name), "")
            with open(P(SMU_DIR + "/" + name), "wb") as f:
                f.write(data)
        ccd = FAMILIES[23]["fuses"]["ccd"][0]
        for old_run in (False, True):
            if old_run:
                os.makedirs(P(OLD_RUN), exist_ok=True)
            assert smu_raw(MP1, 0x35, [7]) == (0x35, [7, 0, 0, 0, 0, 0]) and pm_raw() == (0x620105, [1.5, 2.5])
            assert smn_read(ccd) == ccd
            for d in (RUN,) + ((OLD_RUN,) if old_run else ()):   # every lock released
                fd = os.open(P(d + "/lock"), os.O_RDWR)
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                os.close(fd)
    finally:
        FAKE = fake


def selftest_generic():
    """Phase 1: the generic backend (no ryzen_smu, or siliconctl.generic on an AMD CPU): kernel interfaces only, not a
    single SMU command nor PM table read; FMax through every cpufreq policy, read back, the hardware maximum written back
    exactly; presets, hwtest, refusals; the CPU temperature from coretemp or a thermal zone; the package power from RAPL."""
    global ROOT, FAKE

    def no_smu(*_a):
        raise AssertionError("SMU command or PM table read on the generic backend")
    for variant, cmdline in (("generic", "quiet"), ("granite", "quiet siliconctl.generic")):
        ROOT = tempfile.mkdtemp(prefix="siliconctl-selftest-generic-")
        FAKE = Fake(variant)
        init_cpu()
        FAKE.s["cmdline"] = cmdline
        FAKE.save()
        FAKE.smu = FAKE.pm = FAKE.smn = no_smu
        assert "baseline_error" not in run(["boot"])
        st = run(["status"])
        why = "siliconctl.generic" if variant == "granite" else "not loaded"
        assert st["backend"] == "generic" and why in st["why_generic"] and st["cpu"] == "Fake CPU 8-Core Processor", st
        assert st["co"] is None and st["fmax"] == 5271 and st["smu_version"] is None and st["caps"]["fmax"] == [604, 5271], st
        assert "generic backend" in fmt_status(st) and "Shaper" not in fmt_status(st), fmt_status(st)
        base = run(["baseline", "show"])
        assert base["fmax"] == 5271 and not {"co", "ppt", "tdc", "edc", "tjmax", "fast", "slow"} & set(base), base
        assert run(["fmax", "4500"]) == {"fmax": 4500} and read_text(CPUFREQ + "/policy15/scaling_max_freq") == "4500000"
        assert run(["fmax", "5271"]) == {"fmax": 5271} and read_text(CPUFREQ + "/policy0/scaling_max_freq") == "5271622"
        for argv, err in ((["fmax", "5272"], "out of range"), (["fmax", "603"], "out of range"), (["ppt", "100"], "baseline"),
                          (["tjmax", "80"], "baseline"), (["co", "0", "-5"], "not available"), (["shaper", "raw"], "not available"),
                          (["autotune", "start", "eco"], "Curve Optimizer")):
            expect_err(argv, err)
        pl = run(["preset", "quiet", "show"])["lines"]
        assert "fmax 4871" in pl and "boost off" not in pl and not any(l.split()[0] in ("co", "ppt", "tjmax") for l in pl), pl
        r = run(["hwtest"])
        assert r["fmax"] == "ok (5071 -> 5271)" and r["boost"].startswith("ok") and r["esito"] == "ok" and "ppt" not in r, r
    # the package power: RAPL energy between two reads of the same process (wrapping), none at the first
    d = "/sys/class/powercap/intel-rapl:0"
    for name, v in (("energy_uj", 10 ** 6), ("max_energy_range_uj", 2 ** 32)):
        write_atomic(P(d + "/" + name), str(v))
    del _RAPL_LAST[:]
    assert run(["telemetry"])["ppt"] is None
    _RAPL_LAST[:] = [(2 ** 32 - 49 * 10 ** 6, time.monotonic() - 2)]   # 50 J in 2 s across the wrap of the counter
    assert 24 < run(["telemetry"])["ppt"] < 26
    # the CPU temperature of the other CPUs: the coretemp package, otherwise a thermal zone of the CPU
    fake, FAKE = FAKE, None
    try:
        for name, v in (("name", "coretemp"), ("temp2_label", "Core 0"), ("temp2_input", 40000),
                        ("temp1_label", "Package id 0"), ("temp1_input", 55000)):
            write_atomic(P(HWMON + "/hwmon1/" + name), str(v))
        assert tctl() == 55.0
        write_atomic(P(HWMON + "/hwmon1/name"), "nvme")
        write_atomic(P("/sys/class/thermal/thermal_zone0/type"), "acpitz")
        write_atomic(P("/sys/class/thermal/thermal_zone1/type"), "x86_pkg_temp")
        write_atomic(P("/sys/class/thermal/thermal_zone1/temp"), "61000")
        assert tctl() == 61.0
    finally:
        FAKE = fake


def selftest_intel():
    """Phase 3, step 6: the Intel backend (GenuineIntel, no ryzen_smu), never an SMU command: PL1/PL2 written to both
    powercap zones and read back, floors and ceilings, unlock up to max_power_uw but never on Raptor Lake desktop, a
    zone locked by the BIOS (ENODATA) refusing without leaving the zones apart, `enabled` 0 leaving the PLs out, an
    unlimited board's presets scaled from max_power_uw, the temperature limit through the TCC offset (only lowered),
    turbo through no_turbo (never turned on when the BIOS had it off), presets, hwtest, thermald's warning and a
    laptop's re-apply after the firmware."""
    global ROOT, FAKE

    def no_smu(*_a):
        raise AssertionError("SMU command or PM table read on the Intel backend")

    def fresh(variant):
        global ROOT, FAKE
        ROOT = tempfile.mkdtemp(prefix="siliconctl-selftest-%s-" % variant)
        FAKE = Fake(variant)
        init_cpu()
        FAKE.smu = FAKE.pm = FAKE.smn = no_smu
        assert "baseline_error" not in run(["boot"])

    def uw(zone, n):
        return int(read_text("%s/constraint_%d_power_limit_uw" % (RAPL_ZONES[zone], n)))

    def reboot(**files):   # a new boot, with what the BIOS set this time
        for f in os.listdir(P(RUN)):
            os.remove(P(RUN + "/" + f))
        for path, v in files.items():
            write_atomic(P(path), str(v))
        assert "baseline_error" not in run(["boot"])
    tcc = "/sys/bus/pci/devices/0000:00:04.0/tcc_offset_degree_celsius"
    # ---- an Alder Lake desktop ----
    fresh("intel")
    st = run(["status"])
    assert st["backend"] == "intel" and st["cpu"] == "Fake Intel CPU" and not st["verified"] and st["warnings"] == [], st
    assert "Intel backend" in fmt_status(st) and "PL1 125 W" in fmt_status(st), fmt_status(st)
    base = run(["baseline", "show"])
    assert (base["pl1"], base["pl2"], base["tjmax"], base["fmax"], base["boost"]) == (125, 200, 100, 5271, "on"), base
    assert st["caps"]["pl1"] == [62, 125] and st["caps"]["pl2"] == [62, 200] and st["caps"]["tjmax"] == [TJMAX_MIN, 100], st
    assert run(["pl1", "100"]) == {"pl1": 100.0} and uw(0, 0) == uw(1, 0) == 100 * 10 ** 6   # both zones
    for argv, err in ((["pl1", "61"], "out of range"), (["pl1", "126"], "out of range"), (["pl2", "201"], "out of range"),
                      (["tjmax", "96"], "out of range"), (["tjmax", "59"], "out of range"), (["ppt", "100"], "baseline"),
                      (["co", "0", "-5"], "not available"), (["autotune", "start", "eco"], "Curve Optimizer")):
        expect_err(argv, err)
    assert run(["tjmax", "85"]) == {"tjmax": 85} and read_text(tcc) == "15"
    assert run(["tjmax", "100"]) == {"tjmax": 100} and read_text(tcc) == "0"   # the stock value always allowed back
    run(["unlock", "on"])   # up to the kernel's max_power_uw
    assert run(["status"])["caps"]["pl2"] == [62, 241] and run(["pl2", "241"]) == {"pl2": 241.0}
    expect_err(["pl2", "242"], "out of range")
    run(["pl2", "200"])
    run(["unlock", "off"])
    FAKE.s["locked"] = {RAPL_ZONES[1] + "/constraint_0_power_limit_uw": errno.ENODATA}   # the MMIO zone locked by the BIOS
    FAKE.save()
    expect_err(["pl1", "90"], "locked by the BIOS")
    assert uw(0, 0) == uw(1, 0) == 100 * 10 ** 6, "the zones left apart"   # the MSR zone put back
    FAKE.s["locked"] = {tcc: errno.EPERM}
    FAKE.save()
    expect_err(["tjmax", "80"], "locked")
    FAKE.s["locked"] = {}
    FAKE.save()
    assert run(["boost", "off"]) == {"boost": "off"} and read_text(NO_TURBO) == "1"
    assert run(["boost", "on"]) == {"boost": "on"} and read_text(NO_TURBO) == "0"
    r = run(["hwtest"])
    assert r["pl1"] == "ok (120 -> 125)" and r["pl2"] == "ok (195 -> 200)" and r["tjmax"] == "ok (90 -> 100)", r
    assert r["fmax"] == "ok (5071 -> 5271)" and r["boost"].startswith("ok") and r["esito"] == "ok" and "ppt" not in r, r
    pl = run(["preset", "quiet", "show"])["lines"]   # PL1 before PL2: lowering keeps PL2 ≥ PL1
    assert pl.index("pl1 69") < pl.index("pl2 120") and "tjmax 80" in pl and "fmax 4871" in pl, pl
    assert not any(l.split()[0] in ("co", "ppt", "tdc") for l in pl), pl
    run(["preset", "quiet"])
    assert run(["apply", "quiet"])["applied"] and uw(1, 0) == 69 * 10 ** 6 and uw(1, 1) == 120 * 10 ** 6 and read_text(tcc) == "20"
    run(["default"])
    assert uw(0, 0) == 125 * 10 ** 6 and uw(0, 1) == 200 * 10 ** 6 and read_text(tcc) == "0"
    # ---- the next boot: an unlimited board (presets from max_power_uw), turbo off in the BIOS, PL1 locked (enabled 0) ----
    reboot(**{RAPL_ZONES[0] + "/constraint_1_power_limit_uw": 4095 * 10 ** 6, RAPL_ZONES[1] + "/constraint_1_power_limit_uw": 4095 * 10 ** 6,
              NO_TURBO: 1})
    pl = run(["preset", "quiet", "show"])["lines"]
    assert "pl2 145" in pl and "pl2 4095" in run(["preset", "performance", "show"])["lines"], pl   # 60 % of 241 W
    expect_err(["boost", "on"], "turbo disabled in the BIOS")
    reboot(**{RAPL_ZONES[0] + "/enabled": 0, NO_TURBO: 0})
    assert "pl1" not in run(["baseline", "show"]) and "pl1" not in run(["status"])["caps"]
    expect_err(["pl1", "100"], "baseline")
    # ---- a Raptor Lake desktop without the 0x12B microcode: never above the baseline, a warning ----
    fresh("intel-raptor")
    assert "0x129" in run(["status"])["warnings"][0]
    run(["unlock", "on"])
    assert run(["status"])["caps"]["pl2"] == [62, 188]
    expect_err(["pl2", "200"], "out of range")
    # ---- an Alder Lake laptop: PPCC's floor, thermald's warning, the firmware's PL1 re-applied ----
    fresh("intel-laptop")
    st = run(["status"])
    assert st["power_source"] == "ac" and "thermald" in st["warnings"][0] and st["caps"]["pl1"] == [15, 28], st
    out = run(["pl1", "20"])
    assert out["pl1"] == 20.0 and "thermald" in out["warning"][0], out
    run(["profile", "save", "cool", "pl1 20", "pl2 40"])
    for argv in (["use", "cool"], ["autostart", "on"], ["apply", "cool"]):
        run(argv)
    assert os.path.exists(P(REAPPLY_WANTED)) and run(["reapply"]) is None   # nothing drifted
    write_atomic(P(RAPL_ZONES[0] + "/constraint_0_power_limit_uw"), str(28 * 10 ** 6))   # the MSR zone alone: the lower
    assert run(["reapply"]) is None                                                       # (MMIO) still applies
    for zone in RAPL_ZONES:   # the firmware puts its PL1 back in both
        write_atomic(P(zone + "/constraint_0_power_limit_uw"), str(28 * 10 ** 6))
    assert run(["reapply"])["reapplied"] == ["pl1 20"] and uw(0, 0) == uw(1, 0) == 20 * 10 ** 6


def selftest_report():
    """Phase 4, step 8: the CPU report (read-only, no host name nor user) on AMD, an unknown codename, an Intel laptop
    and the generic backend; the PM table dump only with `pm` and only where the table is not mapped; the hwtest
    record of this CPU in status.checked, not for another CPU."""
    global ROOT, FAKE
    import socket
    import getpass
    secrets = {socket.gethostname(), getpass.getuser()}
    for variant, codename, sections, offered in (("granite", 23, ("### AMD", "Granite Ridge", "mapped"), False),
                                                 ("granite", 25, ("### AMD", "not in the table", "not mapped"), True),
                                                 ("intel-laptop", None, ("### Intel", "thermald running", "long_term 28 W"), False),
                                                 ("generic", None, ("Backend: generic (ryzen_smu driver not loaded",), False)):
        ROOT = tempfile.mkdtemp(prefix="siliconctl-selftest-report-")
        FAKE = Fake(variant)
        init_cpu()
        if codename == 25:   # a family the driver knows and this program does not: its table is offered with consent
            FAKE.s.update(codename=25, pm_version=0x5C0004)
            FAKE.save()
        run(["boot"])
        r = run(["report"])
        assert r["pm_offered"] == offered and r["report"].startswith("## CPU report: Silicon Control " + VERSION), r
        assert all(x in r["report"] for x in sections) and "Checked here: no" in r["report"], r["report"]
        assert not any(x and x in r["report"] for x in secrets), "host name or user in the report"
        if offered:
            dump = run(["report", "pm"])["report"]
            assert "### PM table 0x5c0004 (457 floats, by index)" in dump and "   0: 00000000" in dump, dump
        else:
            expect_err(["report", "pm"], "no dump")
        assert run(["status"])["checked"] is None and run(["status"])["version"] == VERSION
        run(["hwtest"])
        rec = run(["status"])["checked"]
        assert rec and rec["esito"] == "ok" and "### Last hwtest" in run(["report"])["report"], rec
    FAKE.s["codename"] = 23   # another CPU in the same machine (the variant above: 25): the record is not its own
    FAKE.save()
    assert run(["status"])["checked"] is None


def main():
    argv = sys.argv[1:]
    try:
        if argv == ["selftest"]:
            return selftest()
        result = run(argv)
    except Err as e:
        print(_("error: %s") % e, file=sys.stderr)
        sys.exit(1)
    except Exception:  # never an unhandled exception: ABRT would report it as a "crash"
        traceback.print_exc()
        sys.exit(2)
    if isinstance(result, dict) and (argv[0] in ("boot", "resume") and result.get("errors") or result.get("baseline_error")):
        print("siliconctl %s: %s" % (argv[0], json.dumps(result, ensure_ascii=False)), file=sys.stderr)
    if argv[0] in FORMAT:
        print(FORMAT[argv[0]](result))
    elif isinstance(result, str):
        print(result)
    elif result is not None:
        print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    main()
