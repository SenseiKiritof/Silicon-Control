    # a value set by hand: no longer re-applied over it; apply again to resume
    run(["fast", "60"])
    firmware_reset()
    n = writes()
    assert not wanted() and run(["reapply"]) is None and writes() == n
    run(["apply", "quiet"])
    assert wanted()
    # the selected profile saved again: not written by reapply until it is applied
    run(["profile", "save", "quiet"] + open(P(ETC + "/profiles/quiet.conf")).read().splitlines()[1:])
    assert not wanted()
    run(["apply", "quiet"])
