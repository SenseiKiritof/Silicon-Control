def caps(base, unlock):
    """Allowed ranges (min, max) for the GUI: same logic as cap_of."""
    out = {"co": list(co_range()), "fan_step_ms": [0, FAN_STEP_MAX_MS], "fan_step_tol_ms": FAN_STEP_TOL_MS}
    for key, lo in (("ppt", PPT_MIN), ("pl1", None), ("pl2", None), ("fast", APU_MIN_W), ("slow", APU_MIN_W),
                    ("tdc", TDC_MIN), ("edc", EDC_MIN), ("fmax", None), ("tjmax", TJMAX_MIN)):
        if key in base:
            lo = (fmax_floor() if key == "fmax" else pl_floor(base)) if lo is None else lo
            # the stock value is always allowed back (an Intel TjMax or an APU Tctl limit of 100 °C over TJMAX_ABS_MAX)
            out[key] = [lo, max(cap_of(base, key, unlock), base[key])]
    return out


def pm_cores(version, t):
    """Per-core indices of the PM table for this version, {"volt": [index of each core], ...}, only for a
    verified layout; otherwise None. The arrays are by physical slot (8 per CCD, disabled slots included),
    so on CPUs with disabled cores the core map decides which entry is which core."""
    layout = family()["pm_cores"].get(version) if t is not None else None
    phys = core_map() if layout else None
    if not phys:
        return None
    idx = {k: [base + 8 * ccd + slot for ccd, slot in phys] for k, base in layout.items()}
    return idx if max(max(v) for v in idx.values()) < len(t) else None


def sample_cores(pm=None):
    """Voltage (V) and frequency (MHz) per core from the PM table (verified layouts only); otherwise None."""
    version, t = pm or pm_table()
    m = pm_cores(version, t)
    if not m:
        return None
    return {"volt": [round(t[i], 3) for i in m["volt"]],
            "mhz": [int(t[i] * 1000) if t[i] < 100 else int(t[i]) for i in m["mhz"]]}


def cmd_telemetry(ctx, args):
    """Quick reads for the GUI monitor (1 Hz): no writes. The PM table once (every read is an SMU command)."""
    fam = check_cpu()
    pm = version, t = pm_table()
    m = pm_cores(version, t)
    lim = read_limits(pm)
    intel = limits_now() if fam["backend"] == "intel" else {}
    cores = []
    for c in range(CORES):
        try:
            mhz = int(read_text("/sys/devices/system/cpu/cpu%s/cpufreq/scaling_cur_freq" % first_cpu(c))) // 1000
        except (OSError, ValueError):
            mhz = 3000 + c * 100 if FAKE else None
        temp = round(t[m["temp"][c]], 1) if m else None
        cores.append({"mhz": mhz, "temp": temp})
    co = read_co()
    sample = sample_cores(pm)
    for c in range(CORES):
        cores[c]["co"] = co[c] if co else None
        cores[c]["volt"] = sample["volt"][c] if sample else None
    tccd = None
    if FAKE:
        tccd = round(FAKE.s["tctl"] - 15, 1)
    else:
        for d in sorted(os.listdir(P(HWMON))):
            try:
                if read_text("%s/%s/name" % (HWMON, d)) == "k10temp":
                    tccd = int(read_text("%s/%s/temp3_input" % (HWMON, d))) / 1000.0
            except OSError:
                pass
    fans = []
    fd = fans_dir()
    if fd:
        for n in fan_channels(fd):
            rpm = hw_read("%s/fan%d_input" % (fd, n))
            if rpm > 0 or fan_role(n) != "sconosciuto":
