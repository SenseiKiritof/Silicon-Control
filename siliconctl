    # a profile shows and applies the stock values of what it does not set, first, then its own lines
    assert shown[-4:] == ["ppt 150", "co all -10", "fmax 5000", "power balanced"] and "tdc 120" in shown and "edc 180" in shown, shown
    assert not any(l.startswith("co ") for l in shown[:-4]), shown   # "co all" sets every core: no stock co line
    expect_err(["apply", "nope"], "does not exist")
    expect_err(["autostart", "on"], "no profile")
    assert run(["use", "quiet"]) == {"profile": "quiet"}

    # ---- crash guard ----
    def reboot():
        """Simulated reboot: /run emptied, SMU back to the BIOS values."""
        for f in os.listdir(P(RUN)):
            os.remove(P(RUN + "/" + f))
        FAKE.s.update({k: FAKE.default[k] for k in ("co", "fmax", "ppt", "tdc", "edc", "thm", "shaper")})
        FAKE.s["co"] = list(FAKE.default["co"])
        FAKE.s["shaper"] = list(FAKE.default["shaper"])
        FAKE.save()
        FAKE._make_hwmon()                             # the BIOS reprograms the SmartFan at each boot
        FAKE.s["boot_id"] = "boot-%d" % (int(FAKE.s["boot_id"].split("-")[1]) + 1)
        FAKE.save()

    def exists(name):
        return os.path.exists(marker(name))

    # 1. first boot (dirty never existed): markers in place, nothing applied
    reboot()
    out = run(["boot"])
    assert exists("dirty") and not exists("active") and not exists("crashed") and out["applied"] == {}
    assert os.path.exists(P(RUN + "/booted")) and run(["status"])["baseline_fresh"]
    # 2. runtime change, clean shutdown → no crash
    run(["ppt", "150"])
    assert exists("active")
    run(["shutdown"])
    assert not exists("dirty")
    reboot()
    out = run(["boot"])
    assert not exists("crashed") and run(["status"])["limits"]["ppt"] == 162.0
    # 3. profile with autostart, then crash → at boot no CPU, crashed marker
    run(["autostart", "on"])
    run(["apply", "quiet"])
    assert run(["status"])["limits"]["ppt"] == 150.0 and exists("active")
    reboot()                                           # no shutdown = crash
    out = run(["boot"])
    assert out["crashed"] and out["crashed"]["profile"] == "quiet" and exists("crashed")
    assert "crash" in out["errors"]["cpu"] and run(["status"])["limits"]["ppt"] == 162.0
    assert exists("dirty") and not exists("active")
    assert run(["notify"])["crashed"]["profile"] == "quiet" and "quiet" in FAKE.s["notified"]
    # 3b. crash again while nothing is applied: the previous crashed stays, no new active
    reboot()
    out = run(["boot"])
    assert out["crashed"]["profile"] == "quiet" and not exists("active")
    # "Stay on Default"
    run(["crashed", "clear"])
    run(["autostart", "off"])
    reboot()
    out = run(["boot"])
    assert not exists("crashed") and out["applied"] == {} and run(["status"])["limits"]["ppt"] == 162.0
    # 4. "Re-enable": applied at once and at every clean boot
    run(["autostart", "on"])
    out = run(["apply", "quiet"])
