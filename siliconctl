# ---- The CPU report: what an owner sends to add or verify this CPU ------------------------------
def cpu_id():
    """This CPU for the local hwtest record: the backend, the model name, the codename (AMD) or vendor/family/model."""
    fam, info = family(), cpuinfo()
    code = smu_info()["codename"] if fam["backend"] == "amd" else None
    return "|".join(str(x) for x in (fam["backend"], cpu_model(), code if code is not None else "%s %s %s" % (
        info.get("vendor_id"), info.get("cpu family"), info.get("model"))))


def hwtest_record():
    """The last hwtest of this CPU on this machine ({date, esito, id, results}), None when absent or for another CPU."""
    rec = load_settings().get("hwtest")
    return rec if rec and rec.get("id") == cpu_id() else None


def smu_info():
    """The ryzen_smu driver's cached values (no SMU command: the driver copies them): codename, versions, and the PM
    table's version and size; None for what is missing."""
    if FAKE:
        v = FAKE.s.get("pm_version")
        return {"codename": FAKE.s.get("codename"), "smu": "fake", "mp1": None, "driver": None,
                "pm_version": v or None, "pm_size": 457 * 4 if v else None}
    def raw(name, fmt):
        try:
            with open(P(SMU_DIR + "/" + name), "rb") as f:
                return struct.unpack(fmt, f.read(struct.calcsize(fmt)))[0]
        except (OSError, struct.error):
            return None
    def text(name):
        try:
            return read_text(SMU_DIR + "/" + name)
        except OSError:
            return None
    code = text("codename")
    return {"codename": int(code) if code and code.isdigit() else None, "smu": text("version"),
            "mp1": text("mp1_if_version"), "driver": text("drv_version"), "pm_version": raw("pm_table_version", "<I") or None,
            "pm_size": raw("pm_table_size", "<Q")}


def pm_offered():
    """The PM table dump is offered (with consent) where the driver has a table that no map here reads: a codename not
    in FAMILIES, or a version its family does not accept."""
    smu = smu_info()
    return bool(smu["pm_version"] and smu["pm_size"] and smu["codename"] is not None
                and not pm_accepts(FAMILIES.get(smu["codename"]), smu["pm_version"]))


def cmd_report(ctx, args):
    """`report [pm]`: Markdown for an issue with what is needed to add or verify this CPU. Read-only, never the host
    name, the user or a serial number. `pm`: the PM table appended as hex words, only with the user's consent and only
    where pm_offered(): the read goes through the driver (an SMU transfer command on a family not in FAMILIES)."""
    if args not in ([], ["pm"]):
        raise Err(_("usage: report [pm]"))
    fam, info = check_cpu(), cpuinfo()

    def rt(path, default=None):
        try:
            return read_text(path)
        except OSError:
            return default

    def ls(path):
        return sorted(os.listdir(P(path))) if os.path.isdir(P(path)) else []

    def d(*values):   # what this machine does not have reads as "-"
        return tuple("-" if v is None else v for v in values)
    osr = dict(l.split("=", 1) for l in (rt("/etc/os-release", "") or "").splitlines() if "=" in l)
    rec = hwtest_record()
    lines = ["## CPU report: Silicon Control %s" % VERSION, "",
             "- CPU: %s (%s, family %s, model %s, stepping %s, microcode %s)" % d(
                 cpu_model(), info.get("vendor_id"), info.get("cpu family"), info.get("model"), info.get("stepping"),
                 info.get("microcode")),
             "- Cores: %d (CCDs %d, threads %d)" % (CORES, len({cid // 8 for cid, _cpus in TOPO}),
                                                    sum(len(c.split(",")) for _cid, c in TOPO)),
             "- Backend: %s%s, %s" % (fam["backend"], " (%s)" % fam["why"] if fam.get("why") else "",
                                       "verified" if fam["verified"] else "expected"),
             "- Checked here: %s" % ("%s, %s" % (rec["date"], rec["esito"]) if rec else "no"),
             "- Kernel: %s; %s" % (os.uname().release, osr.get("PRETTY_NAME", "?").strip('"')),
             "- Board: %s %s; BIOS %s (%s)" % tuple(rt("/sys/class/dmi/id/" + k, "?") for k in (
                 "board_vendor", "board_name", "bios_version", "bios_date")),
             "- Laptop: %s" % ("yes (on %s)" % power_source() if system_battery() else "no"),
             "- cpufreq: %s, governor %s, EPP %s, boost %s, policies %d" % d(
                 rt(CPUFREQ + "/policy0/scaling_driver"), rt(CPUFREQ + "/policy0/scaling_governor"),
                 rt(CPUFREQ + "/policy0/energy_performance_preference"), boost_get(), len(cpufreq_policies())),
             "- Sensors: %s; thermal zones: %s" % (
                 ", ".join(rt("%s/%s/name" % (HWMON, d), "?") for d in ls(HWMON)) or "-",
                 ", ".join(rt("/sys/class/thermal/%s/type" % z, "?") for z in ls("/sys/class/thermal") if z.startswith("thermal_zone")) or "-")]
    for z in (z for z in ls("/sys/class/powercap") if ":" in z):
        base = "/sys/class/powercap/" + z
        cons = ["%s %s W (max %s W)" % (rt("%s/constraint_%d_name" % (base, n)),
                                         int(rt("%s/constraint_%d_power_limit_uw" % (base, n), "0")) // 10 ** 6,
                                         int(rt("%s/constraint_%d_max_power_uw" % (base, n), "0") or 0) // 10 ** 6)
                for n in range(3) if rt("%s/constraint_%d_name" % (base, n))]
        lines.append("- Powercap %s: %s, enabled %s%s" % (z, rt(base + "/name"), rt(base + "/enabled"),
                                                           (": " + ", ".join(cons)) if cons else ""))
    smu = smu_info()
    if smu["codename"] is not None:
        lines += ["", "### AMD", "- Codename %s (%s), SMU %s, MP1 interface %s, driver %s" % d(
                      smu["codename"], FAMILIES.get(smu["codename"], {}).get("name", "not in the table"), smu["smu"],
                      smu["mp1"], smu["driver"]),
                  "- PM table: %s, %s bytes, %s" % (hex(smu["pm_version"]) if smu["pm_version"] else "none", smu["pm_size"],
                                                    "mapped" if pm_accepts(FAMILIES.get(smu["codename"]), smu["pm_version"])
                                                    else "not mapped"),
                  "- Per-core Curve Optimizer: %s" % (co_support() or "usable")]
    if fam["backend"] == "intel":
        f = tcc_file()
        lines += ["", "### Intel", "- TCC offset: %s (TjMax %s °C, max offset %s)" % d(f, tjmax_hw(), tcc_max_offset(f) if f else None),
                  "- intel_pstate: %s, no_turbo %s; thermald %s" % d(
                      rt("/sys/devices/system/cpu/intel_pstate/status"), rt(NO_TURBO), "running" if thermald_running() else "no")]
    limits = limits_now()
    if limits:
        lines.append("- Limits now: " + ", ".join("%s %g" % kv for kv in sorted(limits.items())))
    if rec:
        lines += ["", "### Last hwtest (%s)" % rec["date"], "```"] + ["%-9s %s" % kv for kv in rec["results"].items()] + ["```"]
    if args == ["pm"]:
        if not pm_offered():
            raise Err(_("the PM table of this CPU is already mapped, or there is none: no dump"))
        version, t = FAKE.pm() if FAKE else pm_raw()
        words = struct.unpack("<%dI" % len(t), struct.pack("<%df" % len(t), *t))
        lines += ["", "### PM table %s (%d floats, by index)" % (hex(version), len(t)), "```"]
        lines += ["%4d: %s" % (i, " ".join("%08x" % w for w in words[i:i + 8])) for i in range(0, len(words), 8)] + ["```"]
    title = "CPU report: %s (%s%s)" % (cpu_model(), fam["backend"], ", codename %s" % smu["codename"]
                                       if smu["codename"] is not None else "")
    return {"report": "\n".join(lines) + "\n", "title": title, "pm_offered": pm_offered()}


# ---- Profiles ----------------------------------------------------------------------------
PROFILE_CMDS = {"co", "ppt", "fast", "slow", "tdc", "edc", "fmax", "tjmax", "pl1", "pl2", "power", "boost", "fan"}  # shaper: experimental, excluded
FAN_PROFILE_SUBCMDS = ("step", "curve", "pump")   # `fan <N> step …` | `fan <N> curve …` | `fan <N> pump auto|<pct>`
NAME_RE = re.compile(r"^[a-z0-9_-]{1,32}$")


def profile_path(name):
    if name == "baseline":
        return P(STATE + "/baseline.conf")
    if not NAME_RE.match(name):
        raise Err(_("invalid profile name '%s' (only a-z 0-9 _ -)") % name)
    return P(ETC + "/profiles/" + name + ".conf")


def profile_lines(name):
    try:
        lines = parse_lines(open(profile_path(name)).read())
    except OSError:
        raise Err(_("profile '%s' does not exist") % name)
    if name == "baseline":  # written by us: an older version may contain lines excluded today (shaper)
        return [t for t in lines if t[0] in PROFILE_CMDS]
    return with_stock(lines)


def with_stock(lines):
    """A profile is the baseline overridden by its own lines: whatever it does not set (an older or
    hand-made profile without a fan curve or without CPU limits) is the stock value, written first.
    So every mode shows and applies a complete state, and switching mode never leaves the previous
    mode's fans or limits behind. The pump is left out: it is never part of a mode."""
    try:
        base = profile_lines("baseline")
    except Err:
        return lines
    have = {tuple(t[:3]) if t[0] == "fan" else (t[0],) for t in lines}
    full_co = any(t[0] == "co" and (len(t) == CORES + 1 or t[1:2] == ["all"]) for t in lines)   # "co 7 -3" alone: the other cores at stock
    fans = fans_dir()
    stock = [t for t in base
             if (t[0] == "fan" and fans and len(t) > 2 and t[2] in ("step", "curve") and tuple(t[:3]) not in have
                 and fan_role(int(t[1])) == "ventola")
             or (t[0] == "co" and not full_co)
             or (t[0] not in ("fan", "co") and (t[0],) not in have)]
    return stock + lines


def apply_lines(lines, ctx, part=None):
    """Executes the lines (part: 'cpu' | 'fan' | None=all). Stops at the first error. `power` and `boost` first: on a
    laptop amd-pmf rewrites the power limits at every platform profile change, so the limits come after it."""
    done = []
    for n, t in sorted(enumerate(lines, 1), key=lambda nt: nt[1][0] not in ("power", "boost")):
        is_fan = t[0] == "fan"
        if part == "fan" and not is_fan or part == "cpu" and is_fan:
            continue
        if t[0] not in PROFILE_CMDS or (is_fan and (len(t) < 3 or t[2] not in FAN_PROFILE_SUBCMDS)):
            raise Err(_("line %d: '%s' not allowed in a profile") % (n, " ".join(t[:3])))
        try:
            run(t, dict(ctx, profile=True))   # the profile's own values: re-applying goes on (limit_setter)
        except Err as e:
            raise Err(_("line %d (%s): %s") % (n, " ".join(t), e))
        done.append(" ".join(t))
    return done


def cmd_apply(ctx, args):
    if len(args) not in (1, 2) or (len(args) == 2 and args[1] not in ("cpu", "fan")):
        raise Err(_("usage: apply <profile|baseline> [cpu|fan]"))
    check_boost(args[0])
    done = apply_lines(profile_lines(args[0]), ctx, args[1] if len(args) == 2 else None)
    if args[1:] != ["fan"] and not ctx.get("dry"):
        rm(P(REAPPLY_STATE))   # applied again: past corrections and a give-up are forgotten
        reapply_mark(args[0])
    return {"applied": done}


def cmd_profile(ctx, args):
    """profile list | show <n> | save <n> <line>… | delete <n>"""
    s = load_settings()
    if args == ["list"]:
        d = P(ETC + "/profiles")
        names = sorted(f[:-5] for f in os.listdir(d) if f.endswith(".conf")) if os.path.isdir(d) else []
        return {"profiles": names, "active": s["profile"]}
    if len(args) == 2 and args[0] == "show":
        return {"lines": [" ".join(t) for t in profile_lines(args[1])]}
    if len(args) >= 2 and args[0] == "save":
        name, path = args[1], profile_path(args[1])
        if name == "baseline":
            raise Err(_("'baseline' is reserved"))
        lines = parse_lines("\n".join(args[2:]))
        apply_lines(lines, {"dry": True})          # validates everything, does not touch the hardware
        write_atomic(path, "# siliconctl profile '%s'\n" % name + "\n".join(" ".join(t) for t in lines) + "\n")
        if name == s["profile"]:
            reapply_off()   # saved, not applied: `reapply` must not write it before the next apply or boot
        return {"saved": name, "lines": len(lines)}
    if len(args) == 2 and args[0] == "delete":
        path = profile_path(args[1])
        if args[1] == "baseline" or not os.path.exists(path):
            raise Err(_("profile '%s' does not exist or is reserved") % args[1])
        os.remove(path)
        s.get("calibrated", {}).pop(args[1], None)
        if s["profile"] == args[1]:
            s["profile"] = None
        save_settings(s)
        reapply_mark()
        return {"deleted": args[1]}
    raise Err(_("usage: profile list | show <name> | save <name> <line>… | delete <name>"))


def cmd_use(ctx, args):
    if len(args) != 1:
        raise Err(_("usage: use <profile>"))
    check_boost(args[0])
    profile_lines(args[0])
    s = load_settings()
    s["profile"] = args[0]
    save_settings(s)
    rm(P(REAPPLY_STATE))   # chosen again: past corrections and a give-up are forgotten
    reapply_mark()
    return {"profile": args[0]}


def cmd_autostart(ctx, args):
    if args not in (["on"], ["off"]):
        raise Err(_("usage: autostart on|off"))
    s = load_settings()
    if args == ["on"] and not s["profile"]:
        raise Err(_("no profile selected (use <profile>)"))
    s["autostart"] = args == ["on"]
    save_settings(s)
    reapply_mark()
    return {"autostart": s["autostart"], "profile": s["profile"]}


