def is_boost(name, s):
    """Boost, or a custom calibration based on it."""
    return name == "boost" or s.get("calibrated", {}).get(name, {}).get("base") == "boost"


def check_boost(name):
    """Boost puts limits and FMax at the unlock ceilings by design: creating, calibrating, selecting
    or applying it (also at boot) is refused while unlock is off."""
    s = load_settings()
    if is_boost(name, s) and not s["unlock"]:
        raise Err(_("Boost requires unlock (siliconctl unlock on; in the GUI: Preferences, \"Allow beyond the stock values\")"))


# ---- Remembered authorization: polkit rule for the calling user -----------------------------
APP_ID = "io.github.senseikiritof.SiliconControl"
TRUST_RULE = "/etc/polkit-1/rules.d/50-silicon-control.rules"
OLD_TRUST_RULE = "/etc/polkit-1/rules.d/50-ryzen-control.rules"   # Ryzen Control's, for org.ryzencontrol.RyzenControl.serve
POLKIT_ACTION = APP_ID + ".serve"


def trust_user():
    """User who called siliconctl via pkexec (GUI) or sudo (CLI); None if unknown."""
    uid = os.environ.get("PKEXEC_UID")
    if uid:
        import pwd
        return pwd.getpwuid(int(uid)).pw_name
    return os.environ.get("SUDO_USER")


def trust_users(rule=TRUST_RULE):
    try:
        m = re.search(r"(\[[^\]]*\])\.indexOf\(subject\.user\)", read_text(rule))
    except OSError:
        return []
    return json.loads(m.group(1)) if m else []


def trust_write(users):
    if users:
        write_atomic(P(TRUST_RULE),
                     "// Generated by `siliconctl trust on`: these users run Silicon Control without re-entering the password.\n"
                     "// Applies only to the action %s (pkexec siliconctl serve) in an active local session.\n"
                     "polkit.addRule(function(action, subject) {\n"
                     "    if (action.id == \"%s\" && subject.local && subject.active &&\n"
                     "        %s.indexOf(subject.user) >= 0)\n"
                     "        return polkit.Result.YES;\n"
                     "});\n" % (POLKIT_ACTION, POLKIT_ACTION, json.dumps(users)))
    else:
        rm(P(TRUST_RULE))


def cmd_trust(ctx, args):
    """trust on|off|status: the calling user no longer re-enters the password for Silicon Control.
    Polkit rule limited to this action (pkexec siliconctl serve), to that user and to their
    active local session: it is not a generic sudo. The first write requires the password."""
    if args == ["status"]:
        return {"trusted": trust_users(), "user": trust_user()}
    if args not in (["on"], ["off"]):
        raise Err(_("usage: trust on|off|status"))
    user = trust_user()
    if not user:
        raise Err(_("unknown calling user (pkexec or sudo required)"))
    users = set(trust_users())
    users = users | {user} if args == ["on"] else users - {user}
    users = sorted(users)
    trust_write(users)
    return {"trusted": users, "user": user}


