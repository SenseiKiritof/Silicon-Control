    n = writes()
    write_atomic(marker("crashed"), json.dumps({"time": "x", "profile": "quiet"}))
    assert run(["reapply"]) is None and writes() == n
    rm(marker("crashed"))
    at_save({"phase": "done"})
    assert run(["reapply"]) is None and writes() == n
    rm(P(AT_PATH))
    assert serve_one(json.dumps(["reapply"])) == {"ok": True, "data": {"reapplied": ["slow 39", "fast 53"], "gave_up": None}}
    # ---- unplugged: the baseline is the AC one, the CPU is not written; the profile is held ----
