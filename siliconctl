def selftest_watchdog():
    """The hardware watchdog handed to systemd (fake RuntimeWatchdogUSec, never the real one): only while a run goes on
    under serve, released at done/abort/end of input, never taken when it could not be stopped or is not ours; a
    serve killed mid-run leaves it with systemd (no reset) and the next siliconctl releases it and counts the step as
    a crash."""
    state = lambda: read_text(Fake.WD_SYS + "/state")
    FAKE.wd_files()

    def setting(key, value):
        FAKE.s[key] = value
        FAKE.save()

    def serve(requests):
        out = io.StringIO()

        def lines():   # each request after the previous reply: an abort read at once would race `start`, which clears its flag
            for i, r in enumerate(requests):
                while out.getvalue().count("\n") < i:
                    time.sleep(0.005)
                yield json.dumps(r) + "\n"
        stdin, stdout = sys.stdin, sys.stdout
        sys.stdin, sys.stdout = lines(), out
        try:
            run(["serve"])
            return [(json.loads(l).get("data") or {}).get("watchdog") for l in out.getvalue().splitlines()]
        finally:
            sys.stdin, sys.stdout = stdin, stdout
    import io
    wd = Watchdog()
    wd.arm()
    assert wd.status == "armed (60 s)" and state() == "active" and FAKE.s["sd_wd"] == WD_SEC * 10 ** 6, wd.status
    assert read_text(WD_STATE) == str(os.getpid())
    assert wd.disarm() and state() == "inactive" and FAKE.s["sd_wd"] == 0 and not os.path.exists(P(WD_STATE)) and wd.status == "disarmed"
    assert wd.disarm(final=True)
    wd.arm()                                                      # serve exiting: never armed again
    assert not wd.armed and state() == "inactive"
    # never taken when it could not be stopped for sure, or when it is not ours
    for key, value, why in (("nowayout", "1", "nowayout"), ("state", "active", "already active")):
        with open(P(Fake.WD_SYS + "/" + key), "w") as fh:
            fh.write(value + "\n")
        wd = Watchdog()
        wd.arm()
        assert not wd.armed and why in wd.status and FAKE.s.get("sd_wd", 0) == 0, (key, wd.status)
        with open(P(Fake.WD_SYS + "/" + key), "w") as fh:
            fh.write({"nowayout": "0", "state": "inactive"}[key] + "\n")
    setting("sd_wd", 30 * 10 ** 6)                                # systemd already configured by the user: left alone
    wd = Watchdog()
    wd.arm()
    assert not wd.armed and "already driven by systemd" in wd.status and FAKE.s["sd_wd"] == 30 * 10 ** 6, wd.status
    setting("sd_wd", 0)
    setting("sd_absent", True)
    wd = Watchdog()
    wd.arm()
    assert not wd.armed and "systemd cannot" in wd.status, wd.status
    setting("sd_absent", False)
    # under serve: armed after start and at every step, released at done; refused steps do not arm it again
    marks = serve([["autotune", "start", "eco", "step=3", "reuse=0"]] + [["autotune", "step"]] * 25)
    done = len([m for m in marks if m == "armed (60 s)"])
    assert done == 1 + 8 + 1 + 7 and marks[done] == "disarmed" and marks[done + 1:] == [None] * (25 - done), marks
    assert state() == "inactive" and run(["autotune", "status"])["phase"] == "done"
    run(["autotune", "abort"])
    # abort, end of input (GUI closed), watchdog=0, a verification stopped with `finish`
    assert serve([["autotune", "start", "eco", "step=3", "reuse=0"], ["autotune", "step"], ["autotune", "abort"]]) == [
        "armed (60 s)", "armed (60 s)", "disarmed"] and state() == "inactive"
    assert serve([["autotune", "start", "eco", "step=3", "reuse=0"], ["autotune", "step"]]) == ["armed (60 s)"] * 2
    assert state() == "inactive" and not os.path.exists(P(WD_STATE))
    run(["autotune", "abort"])
    assert serve([["autotune", "start", "eco", "step=3", "reuse=0", "watchdog=0"], ["autotune", "step"], ["autotune", "abort"]]) == [
        "unavailable: disabled (watchdog=0)"] * 3 and state() == "inactive"
    run(["profile", "save", "wdv", "co " + " ".join(["-5"] * CORES)])
    assert serve([["autotune", "verify", "wdv", "minutes=10"], ["autotune", "step"], ["autotune", "finish"]]) == [
        "armed (60 s)", "armed (60 s)", "disarmed"] and state() == "inactive" and not os.path.exists(P(AT_ABORT_FLAG))
    run(["autotune", "abort"])
    run(["profile", "delete", "wdv"])
    # a real `serve` killed mid-run (no reset: systemd keeps pinging); the next siliconctl releases the watchdog
    # and counts the step of the dead process as a crash, with the CO under test back to the baseline
    pr = subprocess.Popen([sys.executable, os.path.abspath(__file__), "serve"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                          env=dict(os.environ, SILICONCTL_ROOT=ROOT, SILICONCTL_FAKE_FAMILY="granite", LANGUAGE="C", LC_ALL="C.UTF-8"),
                          text=True)
    try:
        pr.stdin.write(json.dumps(["autotune", "start", "eco", "step=3", "reuse=0"]) + "\n")
        pr.stdin.flush()
        assert json.loads(pr.stdout.readline())["data"]["watchdog"] == "armed (60 s)" and state() == "active"
        pr.kill()
        pr.wait(20)
    finally:
        if pr.poll() is None:
            pr.kill()
    FAKE.s = json.loads(open(FAKE.path).read())                   # the child changed the fake state on file
    assert state() == "active" and read_text(WD_STATE) == str(pr.pid)
    st = at_load()
